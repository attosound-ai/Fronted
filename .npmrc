# ══════════════════════════════════════════════════
# ATTO SOUND — pnpm configuration
# ══════════════════════════════════════════════════

# Use hoisted node_modules for Expo/React Native compatibility.
# Isolated mode (default) can break Metro resolution for some RN libs.
node-linker=hoisted

# Fail fast on an unsupported Node instead of dying mid-build with a
# confusing ESM/require error (Expo SDK 55 needs >= 20.19.4). See .nvmrc.
engine-strict=true
