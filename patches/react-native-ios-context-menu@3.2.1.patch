+// MARK: - ATTO: fast menu dismissal
+// ----------------------------------
+
+fileprivate var attoWillEndKey: UInt8 = 0;
+fileprivate var attoTargetKey: UInt8 = 0;
+
+extension RNIContextMenuViewContent {
+  
+  static let attoDismissSpeed: Float = 4;
+  
+  var attoMenuWillEndAt: CFTimeInterval {
+    get { (objc_getAssociatedObject(self, &attoWillEndKey) as? NSNumber)?.doubleValue ?? 0 }
+    set { objc_setAssociatedObject(self, &attoWillEndKey, NSNumber(value: newValue), .OBJC_ASSOCIATION_RETAIN_NONATOMIC) }
+  };
+  
+  var attoFastDismissTarget: UIView? {
+    get { objc_getAssociatedObject(self, &attoTargetKey) as? UIView }
+    set { objc_setAssociatedObject(self, &attoTargetKey, newValue, .OBJC_ASSOCIATION_RETAIN_NONATOMIC) }
+  };
+  
+  /// The view UIKit presents the menu in: a direct child of the window whose
+  /// class is the system's context menu container. Only that subtree runs
+  /// faster; the app's own animations and the keyboard keep their pace.
+  func attoSpeedUpMenuDismissal() -> UIView? {
+    guard let window = self.window else { return nil };
+    
+    func find(_ view: UIView, depth: Int) -> UIView? {
+      if String(describing: type(of: view)).contains("ContextMenu") { return view };
+      guard depth > 0 else { return nil };
+      for sub in view.subviews.reversed() {
+        if let hit = find(sub, depth: depth - 1) { return hit };
+      };
+      return nil;
+    };
+    
+    var container: UIView? = nil;
+    for sub in window.subviews.reversed() {
+      if let hit = find(sub, depth: 2) { container = hit; break };
+    };
+    guard let target = container else { return nil };
+    
+    target.layer.speed = Self.attoDismissSpeed;
+    return target;
+  };
+  
+  func attoRestoreMenuSpeed() {
+    guard let target = self.attoFastDismissTarget else { return };
+    target.layer.speed = 1;
+    self.attoFastDismissTarget = nil;
+  };
+};
