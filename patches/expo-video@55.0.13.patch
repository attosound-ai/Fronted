+  // ATTO patch (Oct 9 2026). This function always writes category .playback with
+  // mode .moviePlayback; `mixWithOthers` only adds an option, it never keeps the
+  // category. During a phone call that write takes the microphone away from the
+  // call (Playback has no input) and the voice engine does not recover: on Oct 10
+  // 2026 a call answered from the lock screen connected with 0 packets sent for
+  // 36 s because the feed's players were created at that moment. While a call is
+  // live the session belongs to the call, so the players mix into it as is.
+  private static let callObserver = CXCallObserver()
+
+  private static func isPhoneCallLive(_ audioSession: AVAudioSession) -> Bool {
+    if callObserver.calls.contains(where: { !$0.hasEnded }) {
+      return true
+    }
+    return audioSession.category == .playAndRecord
+      && (audioSession.mode == .voiceChat || audioSession.mode == .videoChat)
+  }
+
   private func setAudioSession() {
     let audioSession = AVAudioSession.sharedInstance()
+    if Self.isPhoneCallLive(audioSession) {
+      // Same rule and notification as expo-audio and atto-recorder (the app counts
+      // these; see front/docs/arquitectura/audio-y-reanudacion.md).
+      NotificationCenter.default.post(
+        name: Notification.Name("AttoAudioSessionWriteDenied"),
+        object: nil,
+        userInfo: ["client": "expo-video.setAudioSession"])
+      return
+    }
     let audioMixingMode = findAudioMixingMode()
     var audioSessionCategoryOptions: AVAudioSession.CategoryOptions = audioSession.categoryOptions
 
