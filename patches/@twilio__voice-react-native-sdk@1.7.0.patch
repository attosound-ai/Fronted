+    NSString *uuidKey = notification.userInfo[@"uuid"];
+    if (![type isKindOfClass:[NSString class]] || ![uuidKey isKindOfClass:[NSString class]]) { return; }
+    NSNumber *errorCode = notification.userInfo[@"errorCode"];
+    NSString *errorMessage = notification.userInfo[@"errorMessage"];
+    void (^handle)(void) = ^{
+        NSString *key = [uuidKey uppercaseString];
+        TVOCall *call = self.callMap[key];
+        if (!call) { return; } // not an adopted call (warm path) or already cleaned up
+        NSString *eventType = nil;
+        BOOL terminal = NO;
+        if ([type isEqualToString:@"connected"]) {
+            eventType = kTwilioVoiceReactNativeCallEventConnected;
+            NSDateFormatter *fmt = [[NSDateFormatter alloc] init];
+            fmt.dateFormat = @"yyyy-MM-dd'T'HH:mm:ssZZZZZ";
+            self.callConnectMap[key] = [fmt stringFromDate:[NSDate date]];
+        } else if ([type isEqualToString:@"disconnected"]) {
+            eventType = kTwilioVoiceReactNativeCallEventDisconnected; terminal = YES;
+        } else if ([type isEqualToString:@"connectFailure"]) {
+            eventType = kTwilioVoiceReactNativeCallEventConnectFailure; terminal = YES;
+        } else if ([type isEqualToString:@"reconnecting"]) {
+            eventType = kTwilioVoiceReactNativeCallEventReconnecting;
+        } else if ([type isEqualToString:@"reconnected"]) {
+            eventType = kTwilioVoiceReactNativeCallEventReconnected;
+        } else {
+            return;
+        }
