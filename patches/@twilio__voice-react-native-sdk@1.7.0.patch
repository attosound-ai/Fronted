+//
+//  AttoAudioEngineDevice.m
+//  TwilioVoiceReactNative (ATTO SOUND)
+//
+//  Faithful port of Twilio's ExampleAVAudioEngineDevice (Copyright © 2018-2020
+//  Twilio, Inc.). The render/capture C callbacks, the manual-rendering engine
+//  configuration, and the VoiceProcessingIO setup are preserved verbatim. The
+//  only behavioral change is the generalized file-injection API (scheduleFile:
+//  / stopFile / setGain: / setMonitor:) replacing the hard-coded `playMusic`
+//  which loaded a bundled `mixLoop.caf`, plus a process-wide singleton accessor
+//  and an `onStatus` reporting hook.
+//
+
+#import "AttoAudioEngineDevice.h"
+
+#import <stdatomic.h>
+
+// We want to get as close to 10 msec buffers as possible because this is what the media engine prefers.
+static double const kPreferredIOBufferDuration = 0.01;
+
+#pragma mark - ATTO mixer ring buffer (lock-free SPSC, float32)
+
+/*
+ * Lock-free single-producer / single-consumer ring buffer of float32 mono
+ * samples. One writer (the real-time audio callback / tap) and one reader (the
+ * recording consumer). Only memcpy + atomic index loads/stores happen on the
+ * producer side, so it is safe to write from a Core Audio render thread.
+ *
+ * Capacity is a power-of-two number of FLOAT samples so we can mask instead of
+ * modulo. Sized generously (~1s at 48kHz) to absorb consumer scheduling jitter.
+ * On overrun (consumer fell behind) the oldest data is dropped by advancing the
+ * read index; on underrun the consumer simply gets zeros for the missing frames.
+ * Both are graceful — they degrade the RECORDING only, never the live call.
+ */
+typedef struct AttoRingBuffer {
+    float *data;                 // capacity floats, preallocated
+    size_t capacity;             // power of two
+    size_t mask;                 // capacity - 1
+    _Atomic(size_t) writeIndex;  // monotonically increasing, masked on access
+    _Atomic(size_t) readIndex;   // monotonically increasing, masked on access
+} AttoRingBuffer;
+
+// ~1 second of mono float32 at 48kHz, rounded up to a power of two.
+static const size_t kAttoRingCapacityFrames = 65536; // 2^16
+
+static void AttoRingInit(AttoRingBuffer *rb) {
+    rb->capacity = kAttoRingCapacityFrames;
+    rb->mask = kAttoRingCapacityFrames - 1;
+    rb->data = (float *)calloc(kAttoRingCapacityFrames, sizeof(float));
+    atomic_store_explicit(&rb->writeIndex, 0, memory_order_relaxed);
+    atomic_store_explicit(&rb->readIndex, 0, memory_order_relaxed);
+}
+
+static void AttoRingFree(AttoRingBuffer *rb) {
+    if (rb->data) {
+        free(rb->data);
+        rb->data = NULL;
+    }
+}
+
+static void AttoRingReset(AttoRingBuffer *rb) {
+    // Consumer-side only (called when not recording / between sessions).
+    atomic_store_explicit(&rb->writeIndex, 0, memory_order_relaxed);
+    atomic_store_explicit(&rb->readIndex, 0, memory_order_relaxed);
+}
+
+/*
+ * Producer: write `count` float samples. Real-time safe (no malloc/lock/ObjC).
+ * If the buffer would overflow we drop this write entirely (cheap + bounded)
+ * rather than partially writing — keeping channel frame alignment intact.
+ */
+static inline void AttoRingWrite(AttoRingBuffer *rb, const float *src, size_t count) {
+    if (rb->data == NULL || count == 0) return;
+    size_t w = atomic_load_explicit(&rb->writeIndex, memory_order_relaxed);
+    size_t r = atomic_load_explicit(&rb->readIndex, memory_order_acquire);
+    size_t used = w - r;
+    if (used + count > rb->capacity) {
+        // Overrun: consumer is behind. Drop this chunk; don't corrupt alignment.
+        return;
+    }
+    size_t start = w & rb->mask;
+    size_t firstChunk = rb->capacity - start;
+    if (firstChunk >= count) {
+        memcpy(&rb->data[start], src, count * sizeof(float));
+    } else {
+        memcpy(&rb->data[start], src, firstChunk * sizeof(float));
+        memcpy(&rb->data[0], src + firstChunk, (count - firstChunk) * sizeof(float));
+    }
+    atomic_store_explicit(&rb->writeIndex, w + count, memory_order_release);
+}
+
+/*
+ * Consumer: read up to `count` float samples into `dst`. Returns the number of
+ * samples actually available (the rest of `dst`, if any, is zero-filled by the
+ * caller). Only called from the single consumer queue.
+ */
+static inline size_t AttoRingRead(AttoRingBuffer *rb, float *dst, size_t count) {
+    if (rb->data == NULL || count == 0) return 0;
+    size_t r = atomic_load_explicit(&rb->readIndex, memory_order_relaxed);
+    size_t w = atomic_load_explicit(&rb->writeIndex, memory_order_acquire);
+    size_t available = w - r;
+    size_t toRead = (available < count) ? available : count;
+    if (toRead == 0) return 0;
+    size_t start = r & rb->mask;
+    size_t firstChunk = rb->capacity - start;
+    if (firstChunk >= toRead) {
+        memcpy(dst, &rb->data[start], toRead * sizeof(float));
+    } else {
+        memcpy(dst, &rb->data[start], firstChunk * sizeof(float));
+        memcpy(dst + firstChunk, &rb->data[0], (toRead - firstChunk) * sizeof(float));
+    }
+    atomic_store_explicit(&rb->readIndex, r + toRead, memory_order_release);
+    return toRead;
+}
+
+/*
+ * Real-time-safe helper: convert a block of mono int16 PCM to float [-1,1] and
+ * push it into a ring buffer, in fixed-size chunks so the stack frame is small
+ * and bounded (no malloc). Safe to call from a Core Audio render thread.
+ * `byteSize` is the int16 buffer's size in BYTES; frames = byteSize / 2.
+ */
+static inline void AttoPushInt16AsFloat(AttoRingBuffer *rb, const int16_t *src, UInt32 byteSize) {
+    if (rb == NULL || rb->data == NULL || src == NULL || byteSize < 2) return;
+    size_t frames = byteSize / sizeof(int16_t);
+    const float scale = 1.0f / 32768.0f;
+    float tmp[512];
+    size_t done = 0;
+    while (done < frames) {
+        size_t chunk = frames - done;
+        if (chunk > 512) chunk = 512;
+        for (size_t i = 0; i < chunk; i++) {
+            tmp[i] = (float)src[done + i] * scale;
+        }
+        AttoRingWrite(rb, tmp, chunk);
+        done += chunk;
+    }
+}
+
+#pragma mark - ATTO mixer channel indices
+
+typedef NS_ENUM(NSInteger, AttoMixChannel) {
+    AttoMixChannelMic = 0,
+    AttoMixChannelRemote = 1,
+    AttoMixChannelApp = 2,
+    AttoMixChannelMetronome = 3,
+    AttoMixChannelCount = 4,
+};
+
+// We will use mono playback and recording where available.
+static size_t const kPreferredNumberOfChannels = 1;
+
+// An audio sample is a signed 16-bit integer.
+static size_t const kAudioSampleSize = 2;
+static uint32_t const kPreferredSampleRate = 48000;
+
+/*
+ * Calls to AudioUnitInitialize() can fail if called back-to-back after a format change or adding and removing tracks.
+ * A fall-back solution is to allow multiple sequential calls with a small delay between each. This factor sets the max
+ * number of allowed initialization attempts.
+ */
+static const int kMaxNumberOfAudioUnitInitializeAttempts = 5;
+
+// Audio renderer contexts used in core audio's playout callback to retrieve the sdk's audio device context.
+typedef struct AudioRendererContext {
+    // Audio device context received in AudioDevice's `startRendering:context` callback.
+    TVOAudioDeviceContext deviceContext;
+
+    // Maximum frames per buffer.
+    size_t maxFramesPerBuffer;
+
+    // Buffer passed to AVAudioEngine's manualRenderingBlock to receive the mixed audio data.
+    AudioBufferList *bufferList;
+
+    /*
+     * Points to AVAudioEngine's manualRenderingBlock. This block is called from within the VoiceProcessingIO playout
+     * callback in order to receive mixed audio data from AVAudioEngine in real time.
+     */
+    void *renderBlock;
+
+    /*
+     * ATTO mixer (additive): pointer to the REMOTE channel ring buffer. Filled from
+     * the playout engine's manual-rendering inputBlock with the pure remote PCM
+     * (post TVOAudioDeviceReadRenderData, pre local-monitor mix). NULL when not
+     * recording, so the live render path is byte-identical when the mixer is off.
+     * The int16 PCM is converted to float and pushed via AttoRingWrite (memcpy).
+     */
+    AttoRingBuffer *remoteRing;
+    // Telemetry: how many times this render callback fired. PROVES the custom
+    // device is Twilio's ACTIVE device — if it stays 0 during a recording, Twilio
+    // is using its own default device and our engine is inert (which is exactly
+    // why westcol's recordings captured nothing).
+    uint64_t cbCount;
+} AudioRendererContext;
+
+// Audio renderer contexts used in core audio's record callback to retrieve the sdk's audio device context.
+typedef struct AudioCapturerContext {
+    // Audio device context received in AudioDevice's `startCapturing:context` callback.
+    TVOAudioDeviceContext deviceContext;
+
+    // Preallocated buffer list. Please note the buffer itself will be provided by Core Audio's VoiceProcessingIO audio unit.
+    AudioBufferList *bufferList;
+
+    // Preallocated mixed (AudioUnit mic + AVAudioPlayerNode file) audio buffer list.
+    AudioBufferList *mixedAudioBufferList;
+
+    // Core Audio's VoiceProcessingIO audio unit.
+    AudioUnit audioUnit;
+
+    /*
+     * Points to AVAudioEngine's manualRenderingBlock. This block is called from within the VoiceProcessingIO playout
+     * callback in order to receive mixed audio data from AVAudioEngine in real time.
+     */
+    void *renderBlock;
+
+    /*
+     * ATTO mixer (additive): pointer to the MIC channel ring buffer. Filled from
+     * the record callback with EXACTLY the PCM that is handed to Twilio via
+     * TVOAudioDeviceWriteCaptureData (i.e. the same mic-bearing buffer). NULL when
+     * not recording, so the live capture path is byte-identical when the mixer is
+     * off. The int16 PCM is converted to float and pushed via AttoRingWrite.
+     */
+    AttoRingBuffer *micRing;
+    // Telemetry: how many times this record callback fired (see AudioRendererContext.cbCount).
+    uint64_t cbCount;
+    // Telemetry: how many times the manual mix render (or mic AudioUnitRender) FAILED
+    // and we fell back to raw-mic passthrough. >0 means the engine couldn't mix on
+    // this call (the "no te escucho" root); exposed via mixDiagnostics.
+    uint64_t renderFailCount;
+    /*
+     * ATTO telemetry (Aug 2 2026). Two additions, both because production data
+     * showed we could not answer the only question that matters: "did the far
+     * party actually receive the injected audio?"
+     *
+     * 1) renderFailCount conflated two very different failures. Split them:
+     *    CannotDoInCurrentContext means something wrote a node property while the
+     *    engine was rendering (a UI-thread graph mutation) — recoverable, and the
+     *    thing that would make a live fader drag cut the far party's music.
+     *    Everything else means the engine genuinely could not mix (wrong format,
+     *    mid-rebuild), which is the "no te escucho" class.
+     *
+     * 2) injectFramesToCapture: frames written to Twilio WHILE an injection was
+     *    active. This is the counter we never had. `app_frames` does NOT prove
+     *    this — it only advances inside the mix-recording consumer, so it reads 0
+     *    unless startMixRecording is live, and a comment elsewhere in this file
+     *    wrongly claimed otherwise. Real diagnostics showed renderFailCount > 0 on
+     *    24% of transmitting calls, i.e. the far party was hearing raw mic with no
+     *    injected audio, and nothing in our telemetry said so.
+     */
+    uint64_t renderFailCannotDoInContext;
+    uint64_t renderFailOther;
+    uint64_t injectFramesToCapture;
+    /*
+     * Set from the main thread when an injection starts/stops; read (never written)
+     * on the render thread. Aligned 32-bit access is atomic on ARM, and a stale
+     * read costs at most one callback of mis-attribution — acceptable for a
+     * counter, and far cheaper than a lock on the RT path.
+     */
+    int32_t injectActive;
+} AudioCapturerContext;
+
+// The VoiceProcessingIO audio unit uses bus 0 for output, and bus 1 for input.
+static int kOutputBus = 0;
+static int kInputBus = 1;
+
+/*
+ * ATTO (Aug 3 2026) — cohort flag for the render/format recheck work.
+ *
+ * This file has no access to PostHog, so JS mirrors the flag into NSUserDefaults
+ * (react-native `Settings.set`) exactly the way `atto_audio_injection_enabled`
+ * gates the custom-device install in TwilioVoiceReactNative.m. Absent key reads
+ * as NO, so every BEHAVIOUR change guarded by it is off by default and only the
+ * counters ship to everyone.
+ */
+static NSString * const kAttoRenderFormatRecheckKey = @"atto_engine_render_format_recheck";
+
+/*
+ * Number of slots in the per-reason route-change histogram. Indexed directly by
+ * AVAudioSessionRouteChangeReason, whose largest value is
+ * AVAudioSessionRouteChangeReasonRouteConfigurationChange == 8. An enum constant
+ * rather than a `static const`, because this is used as an ivar array bound and C
+ * needs a compile-time constant there.
+ */
+enum { kAttoRouteChangeReasonCount = 9 };
+
+/*
+ * ATTO (Aug 3 2026) — how many post-activation format re-aligns one call is
+ * allowed to trigger.
+ *
+ * A re-align clears the cached formats and calls TVOAudioDeviceFormatChanged,
+ * which per TVOAudioDevice.h makes the media engine stop and then restart the
+ * renderer and/or the capturer. Those restarts run through startRendering: /
+ * startCapturing:, which call the re-align again, so the allowance has to be
+ * bounded by something the cycle itself cannot reset. It is keyed on the
+ * TVOAudioDeviceContext pointer (see _formatRealignContext): the context is
+ * stable for the lifetime of a call and only changes when the media engine hands
+ * us a new one, i.e. on a genuinely new call.
+ *
+ * Two rather than one: an A2DP-to-HFP answer can legitimately settle in two
+ * steps (activation, then the profile handoff completing), and a second
+ * correction is worth an audible gap. A third would mean we are chasing our own
+ * change, which is exactly the runaway this bound exists to prevent.
+ */
+static const uint8_t kAttoMaxFormatRealignsPerCall = 2;
+
+// This is the maximum slice size for VoiceProcessingIO (as observed in the field). We will double check at initialization time.
+static size_t kMaximumFramesPerBuffer = 3072;
+
+@interface AttoAudioEngineDevice()
+
+@property (nonatomic, assign, getter=isInterrupted) BOOL interrupted;
+@property (nonatomic, assign) AudioUnit audioUnit;
+@property (nonatomic, assign) AudioBufferList captureBufferList;
+@property (nonatomic, assign, getter=isRestartAudioUnit) BOOL restartAudioUnit;
+
+@property (nonatomic, strong, nullable) TVOAudioFormat *renderingFormat;
+@property (nonatomic, strong, nullable) TVOAudioFormat *capturingFormat;
+@property (atomic, assign) AudioRendererContext *renderingContext;
+@property (nonatomic, assign) AudioCapturerContext *capturingContext;
+
+// AudioEngine properties
+@property (nonatomic, strong) AVAudioEngine *playoutEngine;
+@property (nonatomic, strong) AVAudioPlayerNode *playoutFilePlayer;
+@property (nonatomic, strong) AVAudioUnitReverb *playoutReverb;
+
+@property (nonatomic, strong) AVAudioEngine *recordEngine;
+@property (nonatomic, strong) AVAudioPlayerNode *recordFilePlayer;
+@property (nonatomic, strong) AVAudioUnitReverb *recordReverb;
+
+// Injection state (ATTO generalization)
+@property (nonatomic, assign) float fileGain;
+@property (nonatomic, assign) BOOL monitorEnabled;
+@property (nonatomic, strong, nullable) NSTimer *statusTimer;
+@property (nonatomic, assign) double currentDurationMs;
+
+// ATTO 4-channel record mixer state.
+// `mixLock` guards the gain/record param arrays + the recording bookkeeping
+// (file handle, isRecording, consumer source). The real-time callbacks NEVER take
+// this lock; they only memcpy into the ring buffers (whose pointers in the C
+// contexts are published/retracted under @synchronized around start/stop).
+@property (nonatomic, strong) NSLock *mixLock;
+@property (nonatomic, assign) BOOL mixRecording;
+@property (nonatomic, strong, nullable) AVAudioFile *mixFile;
+@property (nonatomic, copy, nullable) NSString *mixFilePath;
+@property (nonatomic, strong, nullable) dispatch_queue_t mixConsumerQueue;
+@property (nonatomic, strong, nullable) dispatch_source_t mixConsumerTimer;
+@property (nonatomic, strong, nullable) AVAudioFormat *mixFileFormat;
+
+// Metronome generation state.
+@property (nonatomic, assign) BOOL metronomeOn;
+@property (nonatomic, assign) NSInteger metronomeBpm;
+@property (nonatomic, strong, nullable) AVAudioPlayerNode *metronomePlayoutPlayer; // local monitor (rep hears it)
+@property (nonatomic, strong, nullable) AVAudioPCMBuffer *metronomeClickBuffer;    // synthesized click (playout format)
+@property (nonatomic, strong, nullable) NSTimer *metronomeTimer;                   // schedules monitor clicks
+
+@end
+
+@implementation AttoAudioEngineDevice {
+    /*
+     * ATTO mixer C-level state. Ring buffers for the four channels (mic + remote
+     * are written from the real-time C callbacks; app from an AVAudioEngine tap;
+     * metronome is synthesized in the consumer). The gain/record arrays are
+     * plain scalars read by the consumer; writes are serialized by `mixLock` and
+     * are word-sized so a torn read is impossible — the consumer just samples the
+     * latest value each pull (no glitch beyond one buffer).
+     */
+    AttoRingBuffer _micRing;
+    AttoRingBuffer _remoteRing;
+    AttoRingBuffer _appRing;
+    float _channelGain[AttoMixChannelCount];     // 0..1
+    BOOL  _channelRecord[AttoMixChannelCount];    // include in mix
+    BOOL  _ringsAllocated;
+
+    // ATTO (build 82): the TVOAudioFormat the AVAudioEngines were last BUILT with.
+    // A manual-rendering AVAudioEngine is locked to its build format; if the live
+    // call activates a different sample rate than the one present when the engines
+    // were built (at -init / module load), the frozen engine format mismatches the
+    // AudioUnit format → renderBlock fails (dead two-way audio) / graph reconnect
+    // throws (crash). ensureEngineFormatForActiveSession rebuilds the engines when
+    // this no longer equals the live activeFormat, at call start.
+    TVOAudioFormat *_enginesBuiltFormat;
+
+    // ATTO (build 83) lifecycle telemetry: how many times Twilio has driven the
+    // device's start hooks. If these are 0 during a live call, Twilio is NOT using
+    // this device (a binding problem); if >0 while recordCbCount stays 0, the device
+    // IS bound but its VoiceProcessingIO AudioUnit isn't pumping (session/format).
+    uint64_t _dbgStartCapturingCount;
+    uint64_t _dbgStartRenderingCount;
+
+    // ATTO (build 88) AudioUnit lifecycle telemetry — to definitively distinguish
+    // STARVATION (unit runs then silently stalls, no stop call) from an explicit
+    // STOP (interruption / route-change / teardown). Read in mixDiagnostics.
+    //   audioUnitStartCount / audioUnitStopCount : AudioOutputUnitStart/Stop calls
+    //   teardownAudioUnitCount                   : AudioUnit disposed
+    //   interruptionBeganCount                   : handleAudioInterruption Began (stops the unit)
+    //   routeRebuildCount                        : a route change rebuilt the engines mid-call
+    //   setActiveFailCount                       : setActive:YES that returned an error
+    // If cb stays 29 with start=1, stop=0, interruption=0, route=0 → PURE STARVATION
+    // (session issue). If stop/interruption/route > 0 → something explicitly stopped
+    // the unit. This is the signal that ends the guessing.
+    uint64_t _dbgAudioUnitStartCount;
+    uint64_t _dbgAudioUnitStopCount;
+    uint64_t _dbgTeardownAudioUnitCount;
+    uint64_t _dbgInterruptionBeganCount;
+    uint64_t _dbgRouteRebuildCount;
+    uint64_t _dbgSetActiveFailCount;
+    /*
+     * ATTO (Aug 3 2026). Resuming from an interruption used to call startAudioUnit
+     * and simply assume it worked. There is a documented iOS failure (18.4-18.7)
+     * where the unit reports running after a phone-call interruption but the
+     * render callbacks never fire again, and our own b88 counters exist because we
+     * hit the same silent-starvation signature (start=1, stop=0, callbacks frozen).
+     * A dead unit here means dead call audio AND a truncated take, with nothing in
+     * telemetry saying so. We now verify the resume actually pumped, and count the
+     * times it did not.
+     */
+    uint64_t _dbgResumeStarvedCount;
+    /*
+     * Consecutive consumer ticks where the mic ring was empty while the mic
+     * channel was armed. Used to wait for late mic samples instead of consuming
+     * remote past them (which desynced the two channels permanently). Reset the
+     * moment mic data arrives.
+     */
+    uint32_t _micStarvedTicks;
+    /*
+     * How many times we gave up waiting and let remote drive anyway. >0 means a
+     * take may have drifted; 0 means every take stayed aligned.
+     */
+    uint64_t _dbgMicStarvedFallbacks;
+    // ATTO (build 92): session props CACHED at the last ensure/setActive (worker
+    // thread). mixDiagnostics MUST report these, never live-read AVAudioSession —
+    // the live read is a sync XPC that deadlocked the MAIN thread against the
+    // hang-up teardown (App Hang REACT-NATIVE-4N, stack: -[AVAudioSession sampleRate]).
+    double _dbgCachedSessionRate;
+    int _dbgCachedSessionIsPAR;
+    // Rates seen by the last scheduleFile (record path) — pinpoints any pitch bug.
+    double _dbgLastInjectFileRate;
+    double _dbgLastInjectDestRate;
+
+    // Telemetry: cumulative frames each channel actually contributed to the mix
+    // over a recording. Written ONLY on the serial mixConsumerQueue; read by JS
+    // (getMixDiagnostics) AFTER stopMixRecording tears the consumer down, so no
+    // concurrent access. remoteFrames≈0 ⇒ engine isn't capturing the other party
+    // (breaks recording + two-way audio + the inject→capture path); appFrames≈0
+    // during a transmit ⇒ the injected audio never reached the mix.
+    uint64_t _dbgMicFrames;
+    uint64_t _dbgRemoteFrames;
+    uint64_t _dbgAppFrames;
+    uint64_t _dbgTotalFrames;
+
+    // Live RMS levels (0..1, EMA-smoothed) for the record-screen waveform. Written
+    // ONLY on the serial mixConsumerQueue (not the real-time render thread), read
+    // by JS via getMixLevels. Lets the wave react specifically to the REMOTE party
+    // (the engine has their decoded PCM; Twilio getStats' remote audioLevel is
+    // unreliable and reads ~0).
+    float _remoteLevelEMA;
+    float _micLevelEMA;
+
+    /*
+     * ATTO (Aug 3 2026) ROUTE / FORMAT FORENSICS — added after the AirPods
+     * incident, where the client answered a call while his AirPods were already
+     * playing media and could not hear the other party at all. Nothing crashed and
+     * nothing errored: the whole failure window was uninstrumented, and every
+     * route transition in it was ambiguous because we read the reason iOS gives us
+     * and threw it away.
+     *
+     *   _pendingFormatRecheck            a route change arrived while _audioUnit was
+     *                                    NULL (teardown/rebuild window) and could not
+     *                                    be processed. Consumed by the next start
+     *                                    hook instead of being dropped forever.
+     *   _formatRealignContext            the TVOAudioDeviceContext the allowance
+     *                                    below belongs to. The media engine keeps one
+     *                                    context per call, so a change of pointer is
+     *                                    the only reliable "a new call started" edge
+     *                                    available inside this file.
+     *   _formatRealignCountForContext    how many re-aligns that context has already
+     *                                    triggered, bounded by
+     *                                    kAttoMaxFormatRealignsPerCall so a
+     *                                    pathological route cannot make us chase our
+     *                                    own format change in a loop.
+     *   _dbgRouteChangeDroppedCount      how often the above actually happened.
+     *                                    routeRebuildCount cannot see these at all.
+     *   _dbgRouteChangeRecheckedCount    how often a start hook consumed that debt.
+     *   _dbgRouteRebuildDisagreeCount    how often the old comparand (_renderingFormat)
+     *                                    and the correct one (_enginesBuiltFormat)
+     *                                    disagreed about whether to rebuild.
+     *   _dbgSessionRateFlipCount         how often the live session format differed
+     *                                    from the one Twilio had already latched.
+     *   _dbgFormatRealignScheduledCount  how often we acted on that (cohort only).
+     *   _dbgLastRouteReason / ...At      the reason of the most recent route change
+     *                                    and when it happened (epoch seconds).
+     *   _dbgRouteReasonCounts            histogram indexed by the reason itself.
+     *   _dbgRouteChangeNotifyCount       every notification, including the ones the
+     *                                    switch in handleRouteChange: ignores.
+     */
+    BOOL _pendingFormatRecheck;
+    TVOAudioDeviceContext _formatRealignContext;
+    uint8_t _formatRealignCountForContext;
+    uint64_t _dbgRouteChangeDroppedCount;
+    uint64_t _dbgRouteChangeRecheckedCount;
+    uint64_t _dbgRouteRebuildDisagreeCount;
+    // stopFile forensics (Aug 3 ghost-audio test: injected frames kept flowing
+    // ~2s after the JS stop event landed). Calls counts every stopFile entry;
+    // LagMs is how long its main-queue player-stop block waited to actually run,
+    // which is the direct measurement of "the stop sat behind a busy main
+    // thread". Read together with injectFramesToCapture's plateau time.
+    uint64_t _dbgStopFileCalls;
+    double   _dbgLastStopFileLagMs;
+    uint64_t _dbgSessionRateFlipCount;
+    uint64_t _dbgFormatRealignScheduledCount;
+    NSInteger _dbgLastRouteReason;
+    double _dbgLastRouteReasonAt;
+    uint64_t _dbgRouteChangeNotifyCount;
+    uint64_t _dbgRouteReasonCounts[kAttoRouteChangeReasonCount];
+
+    // Metronome phase, advanced by the consumer in file-sample units.
+    double _metronomeSampleRate;     // file sample rate (consumer format)
+    uint64_t _metronomeSamplesPerBeat;
+    uint64_t _metronomeSampleCounter; // counts up; emits a click each period
+    float *_metronomeClickSamples;    // synthesized mono click (consumer format)
+    size_t _metronomeClickLength;     // frames in the click
+    size_t _metronomeClickPos;        // current playhead within an active click (== length when idle)
+}
+
+#pragma mark - Init & Dealloc
+
++ (instancetype)sharedDevice {
+    static AttoAudioEngineDevice *sSharedDevice = nil;
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        sSharedDevice = [[self alloc] init];
+    });
+    return sSharedDevice;
+}
+
+- (id)init {
+    self = [super init];
+
+    if (self) {
+        // By default audio device is enabled
+        _enabled = true;
+
+        // Injection defaults
+        _fileGain = 1.0f;
+        _monitorEnabled = YES;
+        _currentDurationMs = 0.0;
+
+        // ATTO mixer defaults (mirrors mixerStore DEFAULT_CHANNELS).
+        _mixLock = [[NSLock alloc] init];
+        _mixRecording = NO;
+        _channelGain[AttoMixChannelMic]       = 0.9f;
+        _channelGain[AttoMixChannelRemote]    = 0.9f;
+        _channelGain[AttoMixChannelApp]       = 0.8f;
+        _channelGain[AttoMixChannelMetronome] = 0.6f;
+        /*
+         * The app-side MIC also defaults out of the recorded mix (David, Aug 3):
+         * the flagship take is the FAR party performing while the rep holds the
+         * phone, so the rep's mic would only add room noise and breath. Must stay
+         * in sync with DEFAULT_CHANNELS in mixerStore.ts; belt-and-braces, since
+         * useEngineMixRecording pushes the store to this device before every take
+         * arms (syncAllChannels) precisely so these two tables can never disagree
+         * at the moment that matters.
+         */
+        _channelRecord[AttoMixChannelMic]       = NO;
+        _channelRecord[AttoMixChannelRemote]    = YES;
+        /*
+         * App audio defaults to NOT being recorded (David, Aug 3).
+         *
+         * This is not a preference, it is what makes overdubbing work at all. The
+         * app channel carries whatever we are injecting into the call — typically
+         * the backing track the user is singing over. If the take records it too,
+         * then layering that take back onto the same backing track in the timeline
+         * gives you the track TWICE, slightly offset, which comb-filters into a
+         * hollow mess, with the far party's voice underneath.
+         *
+         * Recording mic + remote only yields a clean overdub. The user can turn the
+         * app channel back on from the mixer when they actually want the whole
+         * blend captured (e.g. bouncing a live performance).
+         */
+        _channelRecord[AttoMixChannelApp]       = NO;
+        _channelRecord[AttoMixChannelMetronome] = NO;
+        _metronomeOn = NO;
+        _metronomeBpm = 90;
+        _ringsAllocated = NO;
+
+        // -1 means "no route change observed yet", which is a different fact from
+        // AVAudioSessionRouteChangeReasonUnknown (0). Everything else zero-inits.
+        _dbgLastRouteReason = -1;
+
+        /*
+         * Initialize rendering and capturing context. The deviceContext will be be filled in when startRendering or
+         * startCapturing gets called.
+         */
+
+        // Initialize the rendering + capturing contexts (cheap; no audio I/O yet).
+        self.renderingContext = malloc(sizeof(AudioRendererContext));
+        memset(self.renderingContext, 0, sizeof(AudioRendererContext));
+
+        self.capturingContext = malloc(sizeof(AudioCapturerContext));
+        memset(self.capturingContext, 0, sizeof(AudioCapturerContext));
+        self.capturingContext->bufferList = &_captureBufferList;
+
+        /*
+         * ATTO (build 83): -init is now INERT. Building the AVAudioEngines and —
+         * critically — calling setupAVAudioSession (setCategory:PlayAndRecord +
+         * setActive:YES) at module load SEIZED the global audio session the moment
+         * the custom device was installed (gated custom-device install runs at
+         * registration). That:
+         *   (a) forced the feed's video/audio into call-mode → playback stalled
+         *       ("app working weird", build 82), and
+         *   (b) collided with the incoming CallKit call's OWN session activation, so
+         *       the VoiceProcessingIO AudioUnit never started → RecordCallback never
+         *       fired (recordCbCount=0 across builds 80-82) → dead two-way audio and
+         *       the injected reel never reached the far party.
+         * Instead: build the engines against the LIVE call format lazily in
+         * ensureEngineFormatForActiveSession (startCapturing/startRendering), and set
+         * the session CATEGORY via the SDK-driven -block (no self setActive — the
+         * system/CallKit owns activation). Here we only register the route/
+         * interruption observers, which are inert and safe at module load.
+         */
+        [self registerAVAudioSessionObservers];
+    }
+
+    return self;
+}
+
+- (void)dealloc {
+    [self unregisterAVAudioSessionObservers];
+
+    // ATTO mixer: stop any consumer + free ring buffers / synthesized click.
+    [self teardownMixConsumer];
+    if (_ringsAllocated) {
+        AttoRingFree(&_micRing);
+        AttoRingFree(&_remoteRing);
+        AttoRingFree(&_appRing);
+        _ringsAllocated = NO;
+    }
+    if (_metronomeClickSamples) {
+        free(_metronomeClickSamples);
+        _metronomeClickSamples = NULL;
+    }
+
+    [self teardownAudioEngine];
+
+    free(self.renderingContext);
+    self.renderingContext = NULL;
+
+    AudioBufferList *mixedAudioBufferList = self.capturingContext->mixedAudioBufferList;
+    if (mixedAudioBufferList) {
+        for (size_t i = 0; i < mixedAudioBufferList->mNumberBuffers; i++) {
+            free(mixedAudioBufferList->mBuffers[i].mData);
+        }
+        free(mixedAudioBufferList);
+    }
+    free(self.capturingContext);
+    self.capturingContext = NULL;
+}
+
++ (NSString *)description {
+    return @"AVAudioEngine Audio Mixing";
+}
+
+/*
+ * Determine at runtime the maximum slice size used by VoiceProcessingIO. Setting the stream format and sample rate
+ * doesn't appear to impact the maximum size so we prefer to read this value once at initialization time.
+ */
++ (void)initialize {
+    AudioComponentDescription audioUnitDescription = [self audioUnitDescription];
+    AudioComponent audioComponent = AudioComponentFindNext(NULL, &audioUnitDescription);
+    AudioUnit audioUnit;
+    OSStatus status = AudioComponentInstanceNew(audioComponent, &audioUnit);
+    if (status != 0) {
+        NSLog(@"Could not find VoiceProcessingIO AudioComponent instance!");
+        return;
+    }
+
+    UInt32 framesPerSlice = 0;
+    UInt32 propertySize = sizeof(framesPerSlice);
+    status = AudioUnitGetProperty(audioUnit, kAudioUnitProperty_MaximumFramesPerSlice,
+                                  kAudioUnitScope_Global, kOutputBus,
+                                  &framesPerSlice, &propertySize);
+    if (status != 0) {
+        NSLog(@"Could not read VoiceProcessingIO AudioComponent instance!");
+        AudioComponentInstanceDispose(audioUnit);
+        return;
+    }
+
+    NSLog(@"This device uses a maximum slice size of %d frames.", (unsigned int)framesPerSlice);
+    kMaximumFramesPerBuffer = (size_t)framesPerSlice;
+    AudioComponentInstanceDispose(audioUnit);
+}
+
+#pragma mark - Private (AVAudioEngine)
+
+- (BOOL)setupAudioEngine {
+    BOOL ok = [self setupPlayoutAudioEngine] && [self setupRecordAudioEngine];
+
+    // ATTO mixer: if a record session is live, re-establish the engine-bound
+    // mixer pieces (metronome monitor + app tap) after the engines were rebuilt
+    // (media-services reset / format-change restart). The ring buffers, consumer,
+    // and file are untouched by the engine rebuild, so the recording continues.
+    if (ok) {
+        BOOL recording;
+        [self.mixLock lock];
+        recording = _mixRecording;
+        [self.mixLock unlock];
+        if (recording) {
+            dispatch_block_t work = ^{
+                [self rebuildMetronomeMonitor];
+                [self installAppTap];
+            };
+            if ([NSThread isMainThread]) { work(); } else { dispatch_async(dispatch_get_main_queue(), work); }
+        }
+    }
+
+    return ok;
+}
+
+/*
+ * ATTO (build 82): rebuild the AVAudioEngines against the CURRENT live session
+ * format if they were last built against a different sample rate.
+ *
+ * WHY: a manual-rendering AVAudioEngine is LOCKED to its build-time format. The
+ * engines are first built in -init (module load, gated custom-device install),
+ * when the session is idle/feed-rate or inactive (48k fallback). A live CallKit
+ * call can activate a DIFFERENT rate (48k, 24k VoIP, 8/16k Bluetooth HFP). If the
+ * frozen engine rate ≠ the AudioUnit/session rate, the record engine's
+ * manualRenderingBlock fails every RecordCallback (dead audio BOTH ways — the
+ * far party hears nothing, we render nothing) and the graph reconnect can throw
+ * (incoming-call crash, build 81). Rebuilding here — at call start, once the
+ * session rate is final — keeps engine format == AudioUnit format == call rate,
+ * which is exactly the invariant Twilio's own ExampleAVAudioEngineDevice relies on.
+ *
+ * Reuses the proven teardownAudioEngine + setupAudioEngine path (already used for
+ * mid-call route changes). Safe when the format already matches (early return).
+ */
+/*
+ * ATTO (build 93) — the format the ENGINES must be built with. The AudioUnit and
+ * Twilio's media stack run at the NEGOTIATED formats (_renderingFormat /
+ * _capturingFormat, cached when Twilio queried renderFormat/captureFormat); the
+ * hardware session rate can differ (CoreAudio SRC bridges it). Building the
+ * engines from the RAW session rate caused the "monster voice" on external
+ * CallKit answers: session flipped rate around didActivate, engines got built at
+ * the new session rate while Twilio still produced/consumed at the negotiated
+ * one -> playout rendered slow/deep. Engines MUST match the negotiated format.
+ */
+- (TVOAudioFormat *)engineTargetFormat {
+    /*
+     * ATTO (Aug 3 2026): read the two cached formats under the device lock.
+     * This method is called from the media engine's worker thread (the rebuild
+     * block in handleValidRouteChange) as well as from the start hooks, while
+     * handleValidRouteChange and the interruption-resume escalation both assign
+     * nil to those ARC strong ivars. Returning a strong reference taken without
+     * the lock can retain an object that is already deallocating. @synchronized
+     * is recursive, so callers that already hold it pay nothing.
+     */
+    TVOAudioFormat *latched = nil;
+    @synchronized(self) {
+        latched = _renderingFormat ?: _capturingFormat;
+    }
+    if (latched != nil) {
+        return latched;
+    }
+    return [[self class] activeFormat];
+}
+
+- (void)ensureEngineFormatForActiveSession {
+    // ATTO (build 87): ACTIVATE the call session FIRST — before reading activeFormat
+    // and building the engines. This is the fix for the deterministic ~29-callback
+    // stall (dead two-way audio, builds 83-86).
+    //
+    // WHY 29: the VoiceProcessingIO unit pre-rolls a bounded ~29 render cycles (~290ms
+    // at the 10ms buffer) then STARVES if the AVAudioSession backing it isn't ACTIVE.
+    // Build 86 called setActive:YES only in the SDK-driven -block, which runs AFTER
+    // the engines were already built here at the idle 48k fallback rate. setActive
+    // then flipped the session to the real call rate → a route-change fired →
+    // handleValidRouteChange saw a format mismatch (48k vs real) → tore the engines
+    // down mid-setup → the unit starved AGAIN (recordCbCount stuck at exactly 29 in
+    // builds 84 AND 86 — proof setActive placement, not the call itself, was wrong).
+    //
+    // Activating HERE, at call start (startCapturing/startRendering — NOT module-init,
+    // so no feed-session seizure), means: (1) the unit is backed by a live active
+    // session and keeps pumping past the pre-roll, and (2) activeFormat below reads
+    // the REAL active rate, so the engines are built correctly the first time and no
+    // later route-change teardown fires. Idempotent + safe to call on every start.
+    {
+        AVAudioSession *session = [AVAudioSession sharedInstance];
+        NSError *serr = nil;
+        [session setPreferredSampleRate:kPreferredSampleRate error:&serr];
+        [session setPreferredIOBufferDuration:kPreferredIOBufferDuration error:&serr];
+        // ATTO (build 145) — AIRPODS ECHO ROOT CAUSE. The bare
+        // setCategory:error: variant RESETS categoryOptions to 0, stripping
+        // AllowBluetoothHFP mid-call. iOS then evicts the BluetoothHFP route, the
+        // route bounces BT->Speaker->BT (observed as the options 0<->13 flip-flop +
+        // route dance in call_audio_session_changed), and during each bounce the
+        // far end's voice transiently plays through the SPEAKER while AEC
+        // reconverges = the echo the client hears ONLY with AirPods in. Preserve
+        // whatever options are already set and guarantee HFP stays allowed.
+        AVAudioSessionCategoryOptions attoOpts1 =
+            session.categoryOptions | AVAudioSessionCategoryOptionAllowBluetooth;
+        [session setCategory:AVAudioSessionCategoryPlayAndRecord withOptions:attoOpts1 error:&serr];
+        [session setMode:AVAudioSessionModeVoiceChat error:&serr];
+        if (![session setActive:YES error:&serr]) {
+            _dbgSetActiveFailCount++; // telemetry: setActive rejected (CallKit owns session?)
+            NSLog(@"[AttoAudioEngine] ensureEngineFormat setActive failed: %@", serr);
+        }
+        // Cache session props HERE (worker thread, already doing session ops) so
+        // mixDiagnostics never live-reads AVAudioSession from the main thread.
+        _dbgCachedSessionRate = session.sampleRate;
+        _dbgCachedSessionIsPAR =
+            [session.category isEqualToString:AVAudioSessionCategoryPlayAndRecord] ? 1 : 0;
+    }
+
+    TVOAudioFormat *live = [self engineTargetFormat];
+    if (_recordEngine != nil && _playoutEngine != nil &&
+        _enginesBuiltFormat != nil && [live isEqual:_enginesBuiltFormat]) {
+        return; // engines already built at the live rate — nothing to do
+    }
+    NSLog(@"[AttoAudioEngine] rebuilding engines for live format %@ (was %@)",
+          live, _enginesBuiltFormat);
+    [self teardownAudioEngine];
+    [self setupAudioEngine]; // rebuilds both, updates _enginesBuiltFormat, re-arms mixer/tap
+}
+
+/*
+ * ATTO (Aug 3 2026): is the render/format recheck cohort flag on for this user?
+ *
+ * Read live (never cached) so the flag can be flipped from JS without relaunching
+ * the app, and read only from non-real-time threads — NSUserDefaults is a
+ * memory-backed read after first access, but it is still not RT safe and must
+ * never be touched from a render or record callback.
+ */
+- (BOOL)renderFormatRecheckEnabled {
+    return [[NSUserDefaults standardUserDefaults] boolForKey:kAttoRenderFormatRecheckKey];
+}
+
+/*
+ * ATTO (Aug 3 2026): consume the "a route change was dropped" debt left by
+ * handleValidRouteChange when it ran with no AudioUnit. Returns YES exactly once
+ * per dropped batch. Always clears the flag, even when the cohort flag is off, so
+ * it can never go stale and fire against an unrelated call later.
+ */
+- (BOOL)consumePendingFormatRecheck {
+    BOOL pending;
+    @synchronized(self) {
+        pending = _pendingFormatRecheck;
+        _pendingFormatRecheck = NO;
+    }
+    if (pending) {
+        _dbgRouteChangeRecheckedCount++;
+    }
+    return pending;
+}
+
+/*
+ * ATTO (Aug 3 2026) — POST-ACTIVATION FORMAT RE-ALIGNMENT.
+ *
+ * Twilio queries renderFormat/captureFormat BEFORE this device has forced the
+ * session to PlayAndRecord/VoiceChat and activated it: that happens later, inside
+ * ensureEngineFormatForActiveSession, which startRendering:/startCapturing: call
+ * afterwards. On a call answered while the AirPods are already playing media the
+ * pre-activation rate (A2DP, 48000) and the post-activation rate (HFP, 24000) are
+ * different, so the formats Twilio latched describe a session that no longer
+ * exists. The same gap opens when a route change is delivered while the AudioUnit
+ * is NULL, which handleValidRouteChange used to discard outright.
+ *
+ * WHAT WE DELIBERATELY DO NOT DO: re-latch _renderingFormat in place and carry on.
+ * Twilio's media engine is already producing samples at the format it queried; if
+ * we quietly moved our side underneath it the far party's voice would play at the
+ * wrong rate for as long as the two disagreed. That is precisely the build-93
+ * "monster voice", and it is the one outcome this whole area must never produce
+ * again.
+ *
+ * Instead we reuse the correction the route-change path has shipped with since day
+ * one, off the current thread: clear the cached formats and let
+ * TVOAudioDeviceFormatChanged drive the media engine through stop -> re-query ->
+ * start. The switch is then atomic from the media engine's point of view, and the
+ * following startRendering:/startCapturing: rebuilds the engines and the AudioUnit
+ * at one consistent rate through the existing, proven path. Deferring it by a beat
+ * also keeps us from re-entering the media engine from inside its own start hook.
+ *
+ * Detection and the counters are UNCONDITIONAL: measuring this is the entire point,
+ * and it is what the incident lacked. Acting on it is gated on the cohort flag and
+ * bounded to kAttoMaxFormatRealignsPerCall per device context, so it can neither
+ * loop nor reach anyone else.
+ */
+- (void)realignFormatsIfSessionRateFlipped:(NSString *)reason {
+    TVOAudioFormat *activeFormat = [[self class] activeFormat];
+
+    /*
+     * SNAPSHOT THE LATCHED FORMAT UNDER THE DEVICE LOCK.
+     *
+     * _renderingFormat / _capturingFormat are ARC strong ivars, and they are
+     * assigned nil from at least two other threads: handleValidRouteChange (the
+     * media engine's worker) and the dispatch_after block below (a global queue).
+     * Reading a strong ivar into a local emits an objc_retain, so an unlocked read
+     * racing one of those releases can retain an object that is already
+     * deallocating. That is the REACT-NATIVE-4C / REACT-NATIVE-4Q crash family,
+     * both of which shipped from this file, and this method is reached from
+     * startAudioUnit which does NOT already hold the lock. @synchronized(self) is
+     * recursive, so taking it here is free on the paths that do.
+     */
+    TVOAudioFormat *latched = nil;
+    @synchronized(self) {
+        latched = _renderingFormat ?: _capturingFormat;
+    }
+    if (latched == nil || [activeFormat isEqual:latched]) {
+        return; // nothing latched yet, or the two already agree
+    }
+
+    _dbgSessionRateFlipCount++;
+    NSLog(@"[AttoAudioEngine] session format flipped after activation (%@): active %@ vs latched %@",
+          reason, activeFormat, latched);
+
+    if (![self renderFormatRecheckEnabled]) {
+        return; // measurement only outside the cohort
+    }
+
+    /*
+     * BOUND THE RE-ALIGN TO THE CALL, NOT TO THE START HOOK.
+     *
+     * A re-align drives the media engine through stopRendering + stopCapturing and
+     * then startRendering: + startCapturing:, and those start hooks call straight
+     * back into here. Anything the stop hooks could reset would therefore be reset
+     * by the very cycle it caused, which is not a bound at all. The device context
+     * is the one identity that survives that cycle unchanged and still changes when
+     * a genuinely new call binds, so the allowance hangs off it.
+     */
+    @synchronized(self) {
+        TVOAudioDeviceContext ctx = [self deviceContext];
+        if (_formatRealignContext != ctx) {
+            _formatRealignContext = ctx;
+            _formatRealignCountForContext = 0;
+        }
+        if (_formatRealignCountForContext >= kAttoMaxFormatRealignsPerCall) {
+            return; // never chase our own format change
+        }
+        _formatRealignCountForContext++;
+    }
+    _dbgFormatRealignScheduledCount++;
+
+    /*
+     * Same shape as the interruption-resume escalation below: a short hop onto a
+     * global queue so we are off the media engine's start hook, then the format
+     * clear + notify under the device's own lock, with the context re-read (it can
+     * disappear if the call ends in the meantime).
+     */
+    __weak typeof(self) weakSelf = self;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.15 * NSEC_PER_SEC)),
+                   dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        __strong typeof(weakSelf) strongSelf = weakSelf;
+        if (!strongSelf || strongSelf.isInterrupted) {
+            return;
+        }
+        @synchronized(strongSelf) {
+            TVOAudioDeviceContext ctx = [strongSelf deviceContext];
+            if (ctx == NULL) {
+                return; // call gone; the next call starts from a clean slate anyway
+            }
+            strongSelf->_renderingFormat = nil;
+            strongSelf->_capturingFormat = nil;
+            TVOAudioDeviceFormatChanged(ctx);
+        }
+    });
+}
+
+// AVAudioSession config block. The SDK's CallKit hooks call device.block() at the
+// right lifecycle moment (around call setup / activation).
+//
+// ATTO (build 83): configure the call session HERE — NOT at -init. Doing this at
+// module load seized the global session (broke the feed + collided with CallKit's
+// activation → dead call audio, builds 81-82).
+//
+// ATTO (build 86): ALSO call setActive:YES here. Build 83/84 set only the category
+// and bet on CallKit to activate — telemetry proved the device then BINDS and pumps
+// (recordCbCount went 0→29, startCapturingCount=1) but the VoiceProcessingIO unit
+// STARVES (only ~29 callbacks then stalls → dead/choppy two-way audio) because the
+// session category is set but the session is never fully ACTIVE. Activating here is
+// safe: the block runs at CALL time (SDK-driven), not at module load, so it does NOT
+// reintroduce the feed/module-init seizure — it just gives the audio unit a live
+// session so it pumps at full rate. This mirrors the stock TVODefaultAudioDevice,
+// which activates the session in its own block.
+// (_block ivar + setBlock: are auto-synthesized from the .h property.)
+- (TVOAVAudioSessionConfigurationBlock)block {
+    return _block ?: ^{
+        AVAudioSession *session = [AVAudioSession sharedInstance];
+        NSError *err = nil;
+        [session setPreferredSampleRate:kPreferredSampleRate error:&err];
+        [session setPreferredIOBufferDuration:kPreferredIOBufferDuration error:&err];
+        // ATTO (build 145): options-preserving setCategory — bare variant strips
+        // AllowBluetoothHFP and evicts AirPods mid-call (echo). See site 1 comment.
+        AVAudioSessionCategoryOptions attoOpts2 =
+            session.categoryOptions | AVAudioSessionCategoryOptionAllowBluetooth;
+        [session setCategory:AVAudioSessionCategoryPlayAndRecord withOptions:attoOpts2 error:&err];
+        [session setMode:AVAudioSessionModeVoiceChat error:&err];
+        if (![session setActive:YES error:&err]) {
+            NSLog(@"[AttoAudioEngine] block setActive failed: %@", err);
+        }
+    };
+}
+
+- (void)setEnabled:(BOOL)enabled {
+    /*
+     * ATTO (build 91) — THE dead-two-way-audio root cause, proven by the build-90
+     * lifecycle counters (start=3 stop=1 teardown=2 cb=35 = exactly this path):
+     *
+     * The SDK's CallKit hooks drive this on EVERY call: enabled=NO at answer,
+     * enabled=YES in provider:didActivateAudioSession:. The old YES branch did
+     * `[self teardownAudioUnit]; [self startAudioUnit];` — but teardownAudioUnit
+     * DISPOSES the unit and NULLs _audioUnit, and startAudioUnit never rebuilds
+     * it, so AudioOutputUnitStart(NULL) failed and the device was left with NO
+     * audio unit for the rest of the call. The unit only ever delivered its
+     * ~29-35 pre-activation pre-roll callbacks, then didActivate killed it →
+     * dead audio both ways on every CallKit call (builds 81-90).
+     *
+     * Fix: rebuild the unit (setupAudioUnitWithRenderContext) before starting it
+     * on enable — restarting under the now-CallKit-activated session is exactly
+     * the point of the didActivate hook. On disable, stop AND tear down fully so
+     * the next enable/start builds a fresh unit (a stopped-but-alive unit would
+     * be leaked by startCapturing/startRendering's unconditional setup).
+     */
+    @synchronized(self) {
+        _enabled = enabled;
+        // No media stack yet (e.g. CallKit sets enabled=NO at answer, before the
+        // call's tracks exist) — just record the flag.
+        TVOAudioDeviceContext context = [self deviceContext];
+        if (!context) {
+            return;
+        }
+        if (enabled) {
+            TVOAudioDeviceExecuteWorkerBlock(context, ^{
+                if (self.audioUnit) {
+                    [self teardownAudioUnit];
+                }
+                // ATTO (build 93): re-align the ENGINES to the negotiated format
+                // before rebuilding the unit. On external CallKit answers the
+                // format flips around didActivate; rebuilding only the unit left
+                // the playout engine at a stale rate -> far voice slow/deep.
+                [self ensureEngineFormatForActiveSession];
+                if ([self setupAudioUnitWithRenderContext:self.renderingContext
+                                           captureContext:self.capturingContext]) {
+                    [self startAudioUnit];
+                } else {
+                    NSLog(@"[AttoAudioEngine] setEnabled:YES failed to rebuild the audio unit");
+                }
+            });
+        } else {
+            // ATTO (build 92): plain stop — NO worker block, NO teardown. This runs at
+            // CallKit didDeactivate (hang-up); dispatching into the media worker while
+            // Twilio is mid-teardown fed the hang-up deadlock (App Hang RN-4N).
+            // stopAudioUnit is quick under our @synchronized; the stopRendering/
+            // stopCapturing hooks (now keyed on unit existence) do the full teardown.
+            if (self.audioUnit) {
+                [self stopAudioUnit];
+            }
+        }
+    }
+}
