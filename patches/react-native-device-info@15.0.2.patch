+// Returns the number of bytes still available to the process before iOS
+// will jetsam it for going over its memory limit. Critical for OOM
+// diagnostics on iOS — without this, `getUsedMemory` is unitless (we know
+// what the process is using, but not how much headroom it has). iOS 13+.
+// Returns NSNull on older iOS or if the call fails.
+RCT_EXPORT_METHOD(getProcAvailableMemory:(RCTPromiseResolveBlock)resolve rejecter:(RCTPromiseRejectBlock)reject) {
+    if (@available(iOS 13.0, *)) {
+        size_t avail = os_proc_available_memory();
+        if (avail > 0) {
+            resolve(@(avail));
+            return;
+        }
+    }
+    resolve([NSNull null]);
+}
+
+// Returns the current thermal pressure level from iOS. When the device is
+// throttling CPU due to heat, ongoing calls/audio recordings tend to drop;
+// having this in telemetry lets us correlate thermal events with crashes.
+// Maps NSProcessInfoThermalState to lower-case strings matching the
+// Android/RN convention.
+RCT_EXPORT_METHOD(getThermalState:(RCTPromiseResolveBlock)resolve rejecter:(RCTPromiseRejectBlock)reject) {
+    NSProcessInfoThermalState state = [NSProcessInfo processInfo].thermalState;
+    NSString *name = nil;
+    switch (state) {
+        case NSProcessInfoThermalStateNominal:  name = @"nominal"; break;
+        case NSProcessInfoThermalStateFair:     name = @"fair"; break;
+        case NSProcessInfoThermalStateSerious:  name = @"serious"; break;
+        case NSProcessInfoThermalStateCritical: name = @"critical"; break;
+        default:                                name = @"unknown"; break;
+    }
+    resolve(name);
+}
+
+// ── ATTO telemetry ───────────────────────────────────────────────────────
+// Monotonic count of AVAudioSession route changes seen by this process. Seeded
+// once from NSUserDefaults so it keeps climbing across relaunches; it only ever
+// goes up, so a jump of more than 1 between two telemetry ticks means route
+// changes happened inside a window we did not sample.
+static NSInteger attoRouteChangeCount = 0;
+static BOOL attoRouteChangeCountSeeded = NO;
+
+// ── Route-change RING ────────────────────────────────────────────────────
+// One NSUserDefaults slot is last-wins, and the invite-to-answer transition
+// fires several route changes inside a few hundred milliseconds: CategoryChange
+// when Twilio takes PlayAndRecord, RouteConfigurationChange /
+// OldDeviceUnavailable / NewDeviceAvailable as AirPods hand off from A2DP to
+// HFP, and Override from our own setSpeakerOutput. JS polls every 750 ms, so the
+// whole burst collapsed into a single sample carrying whichever reason happened
+// to be written last. routeChangeCount then said "you missed four" without ever
+// saying which four, which is exactly the question the AirPods post-mortem could
+// not answer.
+//
+// So keep the last few, in memory, oldest first. Bounded and tiny; this is a
+// process-lifetime buffer, not a log.
+static const NSUInteger kAttoRouteRingMax = 16;
+static NSMutableArray<NSDictionary *> *attoRouteRing = nil;
+// Guards attoRouteRing only. The notification arrives on AVFoundation's own
+// notification thread, never on an audio render callback, and the critical
+// section is a couple of pointer writes on a 16-element array, so this lock is
+// uncontended and bounded. It is the one lock this handler is allowed to take.
+static NSObject *attoRouteRingLock = nil;
+
+// Both the writer (-attoRouteChangeDidOccur:) and the reader (getCallAudioState)
+// go through this, so neither can ever end up in @synchronized(nil), which is a
+// silent no-op in Objective-C and would leave the ring unguarded.
+static void AttoRouteRingInit(void) {
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        attoRouteRingLock = [NSObject new];
+        attoRouteRing = [NSMutableArray arrayWithCapacity:kAttoRouteRingMax];
+    });
+}
+
+// AVAudioSessionRouteChangeReason -> a stable, queryable string. These are the
+// names the post-mortems are written in: OldDeviceUnavailable = the user
+// physically removed the AirPods, NewDeviceAvailable / RouteConfigurationChange
+// = iOS moved the route itself (that is what an A2DP to HFP handoff looks like),
+// Override / CategoryChange = our own code did it.
+static NSString *AttoRouteChangeReasonName(NSInteger reason) {
+    switch (reason) {
+        case AVAudioSessionRouteChangeReasonUnknown:                   return @"Unknown";
+        case AVAudioSessionRouteChangeReasonNewDeviceAvailable:        return @"NewDeviceAvailable";
+        case AVAudioSessionRouteChangeReasonOldDeviceUnavailable:      return @"OldDeviceUnavailable";
+        case AVAudioSessionRouteChangeReasonCategoryChange:            return @"CategoryChange";
+        case AVAudioSessionRouteChangeReasonOverride:                  return @"Override";
+        case AVAudioSessionRouteChangeReasonWakeFromSleep:             return @"WakeFromSleep";
+        case AVAudioSessionRouteChangeReasonNoSuitableRouteForCategory:return @"NoSuitableRouteForCategory";
+        case AVAudioSessionRouteChangeReasonRouteConfigurationChange:  return @"RouteConfigurationChange";
+        default:                                                       return @"";
+    }
+}
+
+// Route-change recorder, installed from -init. This can fire on AVFoundation's
+// own notification thread WHILE A CALL IS LIVE, so it is deliberately the most
+// boring function in this file: read the reason and the previous route out of
+// userInfo, write three scalars to NSUserDefaults, append one small dictionary
+// to a bounded ring, return. It must never touch the AVAudioSession (no reads,
+// no mutation) and never do work proportional to anything. Getting greedy here
+// would let telemetry perturb call audio, which is the exact opposite of the
+// point.
+//
+// The PREVIOUS route comes from the notification payload
+// (AVAudioSessionRouteChangePreviousRouteKey), so recording it still costs no
+// session access. It is also enough to reconstruct a whole burst: entry N's
+// previous route is the state before change N, and entry N+1's previous route is
+// the state after it.
+- (void)attoRouteChangeDidOccur:(NSNotification *)notification
+{
+    NSNumber *reason = notification.userInfo[AVAudioSessionRouteChangeReasonKey];
+    NSUserDefaults *ud = [NSUserDefaults standardUserDefaults];
+    if (!attoRouteChangeCountSeeded) {
+        attoRouteChangeCount = [ud integerForKey:@"atto_audio_route_change_count"];
+        attoRouteChangeCountSeeded = YES;
+    }
+    attoRouteChangeCount += 1;
+    const NSInteger reasonValue = reason ? reason.integerValue : -1;
+    // -1 means "notification arrived without a reason key", which is itself worth
+    // seeing; it maps to "" on the JS side rather than to a real reason name.
+    [ud setInteger:reasonValue forKey:@"atto_audio_last_route_reason"];
+    // CFAbsoluteTimeGetCurrent + the epoch offset gives epoch seconds with no
+    // NSDate allocation, matching the *_at convention of the other ATTO markers.
+    const double nowEpoch = CFAbsoluteTimeGetCurrent() + kCFAbsoluteTimeIntervalSince1970;
+    [ud setDouble:nowEpoch forKey:@"atto_audio_last_route_reason_at"];
+    [ud setInteger:attoRouteChangeCount forKey:@"atto_audio_route_change_count"];
+
+    AVAudioSessionRouteDescription *prev =
+        notification.userInfo[AVAudioSessionRouteChangePreviousRouteKey];
+    NSDictionary *entry = @{
+        @"reason": AttoRouteChangeReasonName(reasonValue),
+        @"reasonValue": @(reasonValue),
+        @"at": @(nowEpoch),
+        @"count": @(attoRouteChangeCount),
+        @"fromInputPort": (prev.inputs.firstObject.portType ?: @"none"),
+        @"fromOutputPort": (prev.outputs.firstObject.portType ?: @"none"),
+    };
+    AttoRouteRingInit();
+    @synchronized(attoRouteRingLock) {
+        [attoRouteRing addObject:entry];
+        while (attoRouteRing.count > kAttoRouteRingMax) {
+            [attoRouteRing removeObjectAtIndex:0];
+        }
+    }
+}
+
+// Surfaces the native CallKit audio-session markers (written by the patched
+// @twilio/voice-react-native-sdk CallKit callbacks) PLUS the LIVE
+// AVAudioSession state to JS, so `call_telemetry_tick` can prove — with no
+// inference — whether the audio session actually activated and routed for a
+// call. The *_at fields are epoch seconds (0 = never fired). Called from JS
+// via NativeModules.RNDeviceInfo.getCallAudioState(). iOS-only telemetry.
+RCT_EXPORT_METHOD(getCallAudioState:(RCTPromiseResolveBlock)resolve rejecter:(RCTPromiseRejectBlock)reject) {
+    NSUserDefaults *ud = [NSUserDefaults standardUserDefaults];
+    AVAudioSession *s = [AVAudioSession sharedInstance];
+    NSString *out = s.currentRoute.outputs.firstObject.portType ?: @"none";
+    NSString *inp = s.currentRoute.inputs.firstObject.portType ?: @"none";
+    // Snapshot (copy) the route ring so JS never holds the live array.
+    AttoRouteRingInit();
+    NSArray<NSDictionary *> *recentRoutes = nil;
+    @synchronized(attoRouteRingLock) {
+        recentRoutes = [attoRouteRing copy];
+    }
+    resolve(@{
+        // Native CallKit audio-callback markers (epoch seconds; 0 = never).
+        @"didActivateAt": @([ud doubleForKey:@"atto_audio_didActivate_at"]),
+        @"didDeactivateAt": @([ud doubleForKey:@"atto_audio_didDeactivate_at"]),
+        @"answerActionAt": @([ud doubleForKey:@"atto_audio_answerAction_at"]),
+        @"callConnectAt": @([ud doubleForKey:@"atto_audio_callConnect_at"]),
+        @"twilioAudioEnabled": @([ud boolForKey:@"atto_audio_enabled"]),
+        // Live AVAudioSession state at snapshot time.
+        @"liveCategory": (s.category ?: @""),
+        @"liveMode": (s.mode ?: @""),
+        @"liveOutputPort": out,
+        @"liveInputPort": inp,
+        @"liveSampleRate": @(s.sampleRate),
+        @"liveOtherAudioPlaying": @(s.isOtherAudioPlaying),
+        // WHO moved the route, and when (written by -attoRouteChangeDidOccur:).
+        // lastRouteChangeAt == 0 means no route change has been observed yet, in
+        // which case lastRouteChangeReason is meaningless and JS nulls it out.
+        @"lastRouteChangeReason": AttoRouteChangeReasonName([ud integerForKey:@"atto_audio_last_route_reason"]),
+        @"lastRouteChangeAt": @([ud doubleForKey:@"atto_audio_last_route_reason_at"]),
+        @"routeChangeCount": @([ud integerForKey:@"atto_audio_route_change_count"]),
+        // The last few route changes, oldest first, each with its reason, its
+        // epoch-seconds timestamp, its position in routeChangeCount and the ports
+        // the route was on BEFORE it. A single lastRouteChangeReason slot is
+        // last-wins, so the answer-instant burst (CategoryChange, the A2DP to HFP
+        // handoff, our own Override) collapsed into one sample and we could only
+        // ever see how many changes we had missed, never which. This decomposes it.
+        @"recentRouteChanges": (recentRoutes ?: @[]),
+        // Session configuration + IO geometry. categoryOptions is the RAW bitmask
+        // (MixWithOthers 1, DuckOthers 2, AllowBluetoothHFP 4, DefaultToSpeaker 8,
+        // AllowBluetoothA2DP 32, AllowAirPlay 64), so a session write that silently
+        // strips HFP or injects DefaultToSpeaker becomes a visible fact instead of
+        // an inference. outputVolume rules out the most embarrassing explanation
+        // for silent AirPods; buffer duration and latency expose a route that
+        // reconfigured underneath a running engine.
+        @"liveCategoryOptions": @((NSInteger)s.categoryOptions),
+        @"liveOutputVolume": @(s.outputVolume),
+        @"liveIOBufferDuration": @(s.IOBufferDuration),
+        @"liveOutputLatency": @(s.outputLatency),
+        @"liveInputLatency": @(s.inputLatency),
+        @"liveOutputChannels": @(s.outputNumberOfChannels),
+        @"liveInputChannels": @(s.inputNumberOfChannels),
+        // VoIP push-arrival markers (written by AttoVoipBootstrap).
+        @"voipPushAt": @([ud doubleForKey:@"atto_last_voip_push_at"]),
+        @"voipPushAppState": @([ud integerForKey:@"atto_last_voip_push_appstate"]),
+        // VoIP report OUTCOME markers (written by AttoVoipBootstrap when it reports
+        // — or fails to report — the call to CallKit). This is the funnel that tells
+        // us whether the cold-launch crash fix actually worked: reportPath says
+        // which branch we took (warm/cold), reportOutcome says what happened
+        // (cold_reported / warm_pending / forced_hard_deadline / cold_report_error).
+        @"voipReportPath": ([ud stringForKey:@"atto_last_voip_report_path"] ?: @""),
+        @"voipReportOutcome": ([ud stringForKey:@"atto_last_voip_report_outcome"] ?: @""),
+        @"voipReportAttempt": @([ud integerForKey:@"atto_last_voip_report_attempt"]),
+        @"voipReportAt": @([ud doubleForKey:@"atto_last_voip_report_at"]),
+        // COLD-CALL funnel markers (build 146) — the full native chain of a
+        // cold-launch call, each an epoch-seconds stamp (0 = never): invite
+        // decoded -> answered -> accepted -> connected -> RN module born ->
+        // handoff posted/adopted -> disconnect forwarded to JS. Together with
+        // voipReport* these make every cold call's path fully reconstructable
+        // from PostHog, and coldLastCallSid joins it to the Twilio call.
+        @"coldInviteDecodedAt": @([ud doubleForKey:@"atto_coldcallkit_cold_report_at"]),
+        @"coldAnswerActionAt": @([ud doubleForKey:@"atto_coldcallkit_cold_answerAction_at"]),
+        @"coldAcceptAt": @([ud doubleForKey:@"atto_coldcallkit_cold_accept_at"]),
+        @"coldConnectedAt": @([ud doubleForKey:@"atto_coldcallkit_cold_connected_at"]),
+        @"coldModuleInitAt": @([ud doubleForKey:@"atto_coldcallkit_cold_module_init_at"]),
+        @"coldHandoffPostedAt": @([ud doubleForKey:@"atto_coldcallkit_cold_handoff_posted_at"]),
+        @"coldHandoffPostedCount": @([ud integerForKey:@"atto_cold_handoff_posted_count"]),
+        @"coldHandoffAdoptedAt": @([ud doubleForKey:@"atto_coldcallkit_cold_handoff_adopted_at"]),
+        @"coldHandoffAdoptedCount": @([ud integerForKey:@"atto_cold_handoff_adopted_count"]),
+        @"coldDisconnectForwardedAt": @([ud doubleForKey:@"atto_coldcallkit_cold_disconnect_forwarded_at"]),
+        @"coldLastCallSid": ([ud stringForKey:@"atto_last_cold_call_sid"] ?: @""),
+        // Per-step answer-handler markers (b147). The b146 field data showed the
+        // handler dying between invite.accept and the next line (cold_accept
+        // never stamped, heldCalls empty, handoff dead). These pin the exact
+        // divergence line, and the recovery/orphan markers report the self-heal.
+        @"coldAnswerGuardOkAt": @([ud doubleForKey:@"atto_coldcallkit_cold_answer_guard_ok_at"]),
+        @"coldAnswerGuardFailedAt": @([ud doubleForKey:@"atto_coldcallkit_cold_answer_guard_failed_at"]),
+        @"coldAcceptBeginAt": @([ud doubleForKey:@"atto_coldcallkit_cold_accept_begin_at"]),
+        @"coldActionTimeoutAt": @([ud doubleForKey:@"atto_coldcallkit_cold_action_timeout_at"]),
+        @"coldRecoveredAtConnectAt": @([ud doubleForKey:@"atto_coldcallkit_cold_call_recovered_at_connect_at"]),
+        @"coldOrphanAt": @([ud doubleForKey:@"atto_coldcallkit_cold_handoff_empty_but_call_live_at"]),
+    });
+}
+
+// ATTO (build 98): force the call audio route to speaker / earpiece via
+// AVAudioSession.overrideOutputAudioPort — the CANONICAL CallKit speaker lever.
+// Twilio's AudioDevice.select() is unreliable once CallKit owns the session
+// (esp. lock-screen/background answers) and the JS ActionSheet route-picker
+// can't even present over the recording screen's bottom sheets — the client's
+// "couldn't turn speaker on, no matter what I did". This overrides the port
+// directly and returns the resulting live output port so JS can confirm it stuck.
+RCT_EXPORT_METHOD(setSpeakerOutput:(BOOL)enable
+                          resolver:(RCTPromiseResolveBlock)resolve
+                          rejecter:(RCTPromiseRejectBlock)reject) {
+    AVAudioSession *session = [AVAudioSession sharedInstance];
+    NSError *err = nil;
+    AVAudioSessionPortOverride override =
+        enable ? AVAudioSessionPortOverrideSpeaker : AVAudioSessionPortOverrideNone;
+    BOOL ok = [session overrideOutputAudioPort:override error:&err];
+    NSString *out = session.currentRoute.outputs.firstObject.portType ?: @"none";
+    resolve(@{
+        @"ok": @(ok),
+        @"requestedSpeaker": @(enable),
+        @"liveOutputPort": out,
+        @"error": (err ? err.localizedDescription : @""),
+    });
+}
