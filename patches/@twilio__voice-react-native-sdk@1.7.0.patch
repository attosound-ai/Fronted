+                                       kTwilioVoiceReactNativeEventKeyCall: [self callInfo:call]} mutableCopy];
+        if (errorCode != nil) {
+            body[kTwilioVoiceReactNativeVoiceErrorKeyError] =
+                @{kTwilioVoiceReactNativeVoiceErrorKeyCode: errorCode,
+                  kTwilioVoiceReactNativeVoiceErrorKeyMessage: errorMessage ?: @""};
+        }
+        [self sendEventWithName:kTwilioVoiceReactNativeScopeCall body:body];
+        if (terminal) {
+            [self.callMap removeObjectForKey:key];
+            [self.callConnectMap removeObjectForKey:key];
+            [self.callInviteMap removeObjectForKey:key];
+            [[NSUserDefaults standardUserDefaults] setDouble:[[NSDate date] timeIntervalSince1970]
+                                                      forKey:@"atto_coldcallkit_cold_disconnect_forwarded_at"];
+        }
+    };
