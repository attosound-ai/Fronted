+//
+//  AttoAudioEngineDevice.m
+//  TwilioVoiceReactNative (ATTO SOUND)
+//
+//  Faithful port of Twilio's ExampleAVAudioEngineDevice (Copyright © 2018-2020
+//  Twilio, Inc.). The render/capture C callbacks, the manual-rendering engine
+//  configuration, and the VoiceProcessingIO setup are preserved verbatim. The
+//  only behavioral change is the generalized file-injection API (scheduleFile:
+//  / stopFile / setGain: / setMonitor:) replacing the hard-coded `playMusic`
+//  which loaded a bundled `mixLoop.caf`, plus a process-wide singleton accessor
+//  and an `onStatus` reporting hook.
+//
+
+#import "AttoAudioEngineDevice.h"
+
+// We want to get as close to 10 msec buffers as possible because this is what the media engine prefers.
+static double const kPreferredIOBufferDuration = 0.01;
+
+// We will use mono playback and recording where available.
+static size_t const kPreferredNumberOfChannels = 1;
+
+// An audio sample is a signed 16-bit integer.
+static size_t const kAudioSampleSize = 2;
+static uint32_t const kPreferredSampleRate = 48000;
+
+/*
+ * Calls to AudioUnitInitialize() can fail if called back-to-back after a format change or adding and removing tracks.
+ * A fall-back solution is to allow multiple sequential calls with a small delay between each. This factor sets the max
+ * number of allowed initialization attempts.
+ */
+static const int kMaxNumberOfAudioUnitInitializeAttempts = 5;
+
+// Audio renderer contexts used in core audio's playout callback to retrieve the sdk's audio device context.
+typedef struct AudioRendererContext {
+    // Audio device context received in AudioDevice's `startRendering:context` callback.
+    TVOAudioDeviceContext deviceContext;
+
+    // Maximum frames per buffer.
+    size_t maxFramesPerBuffer;
+
+    // Buffer passed to AVAudioEngine's manualRenderingBlock to receive the mixed audio data.
+    AudioBufferList *bufferList;
+
+    /*
+     * Points to AVAudioEngine's manualRenderingBlock. This block is called from within the VoiceProcessingIO playout
+     * callback in order to receive mixed audio data from AVAudioEngine in real time.
+     */
+    void *renderBlock;
+} AudioRendererContext;
+
+// Audio renderer contexts used in core audio's record callback to retrieve the sdk's audio device context.
+typedef struct AudioCapturerContext {
+    // Audio device context received in AudioDevice's `startCapturing:context` callback.
+    TVOAudioDeviceContext deviceContext;
+
+    // Preallocated buffer list. Please note the buffer itself will be provided by Core Audio's VoiceProcessingIO audio unit.
+    AudioBufferList *bufferList;
+
+    // Preallocated mixed (AudioUnit mic + AVAudioPlayerNode file) audio buffer list.
+    AudioBufferList *mixedAudioBufferList;
+
+    // Core Audio's VoiceProcessingIO audio unit.
+    AudioUnit audioUnit;
+
+    /*
+     * Points to AVAudioEngine's manualRenderingBlock. This block is called from within the VoiceProcessingIO playout
+     * callback in order to receive mixed audio data from AVAudioEngine in real time.
+     */
+    void *renderBlock;
+} AudioCapturerContext;
+
+// The VoiceProcessingIO audio unit uses bus 0 for output, and bus 1 for input.
+static int kOutputBus = 0;
+static int kInputBus = 1;
+
+// This is the maximum slice size for VoiceProcessingIO (as observed in the field). We will double check at initialization time.
+static size_t kMaximumFramesPerBuffer = 3072;
+
+@interface AttoAudioEngineDevice()
+
+@property (nonatomic, assign, getter=isInterrupted) BOOL interrupted;
+@property (nonatomic, assign) AudioUnit audioUnit;
+@property (nonatomic, assign) AudioBufferList captureBufferList;
+@property (nonatomic, assign, getter=isRestartAudioUnit) BOOL restartAudioUnit;
+
+@property (nonatomic, strong, nullable) TVOAudioFormat *renderingFormat;
+@property (nonatomic, strong, nullable) TVOAudioFormat *capturingFormat;
+@property (atomic, assign) AudioRendererContext *renderingContext;
+@property (nonatomic, assign) AudioCapturerContext *capturingContext;
+
+// AudioEngine properties
+@property (nonatomic, strong) AVAudioEngine *playoutEngine;
+@property (nonatomic, strong) AVAudioPlayerNode *playoutFilePlayer;
+@property (nonatomic, strong) AVAudioUnitReverb *playoutReverb;
+
+@property (nonatomic, strong) AVAudioEngine *recordEngine;
+@property (nonatomic, strong) AVAudioPlayerNode *recordFilePlayer;
+@property (nonatomic, strong) AVAudioUnitReverb *recordReverb;
+
+// Injection state (ATTO generalization)
+@property (nonatomic, assign) float fileGain;
+@property (nonatomic, assign) BOOL monitorEnabled;
+@property (nonatomic, strong, nullable) NSTimer *statusTimer;
+@property (nonatomic, assign) double currentDurationMs;
+
+@end
+
+@implementation AttoAudioEngineDevice
+
+#pragma mark - Init & Dealloc
+
++ (instancetype)sharedDevice {
+    static AttoAudioEngineDevice *sSharedDevice = nil;
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        sSharedDevice = [[self alloc] init];
+    });
+    return sSharedDevice;
+}
+
+- (id)init {
+    self = [super init];
+
+    if (self) {
+        // By default audio device is enabled
+        _enabled = true;
+
+        // Injection defaults
+        _fileGain = 1.0f;
+        _monitorEnabled = YES;
+        _currentDurationMs = 0.0;
+
+        /*
+         * Initialize rendering and capturing context. The deviceContext will be be filled in when startRendering or
+         * startCapturing gets called.
+         */
+
+        // Initialize the rendering context
+        self.renderingContext = malloc(sizeof(AudioRendererContext));
+        memset(self.renderingContext, 0, sizeof(AudioRendererContext));
+
+        // Setup the AVAudioEngine along with the rendering context
+        if (![self setupPlayoutAudioEngine]) {
+            NSLog(@"Failed to setup AVAudioEngine");
+        }
+
+        // Initialize the capturing context
+        self.capturingContext = malloc(sizeof(AudioCapturerContext));
+        memset(self.capturingContext, 0, sizeof(AudioCapturerContext));
+        self.capturingContext->bufferList = &_captureBufferList;
+
+        [self setupAVAudioSession];
+
+        // Setup the AVAudioEngine along with the rendering context
+        if (![self setupRecordAudioEngine]) {
+            NSLog(@"Failed to setup AVAudioEngine");
+        }
+    }
+
+    return self;
+}
+
+- (void)dealloc {
+    [self unregisterAVAudioSessionObservers];
+
+    [self teardownAudioEngine];
+
+    free(self.renderingContext);
+    self.renderingContext = NULL;
+
+    AudioBufferList *mixedAudioBufferList = self.capturingContext->mixedAudioBufferList;
+    if (mixedAudioBufferList) {
+        for (size_t i = 0; i < mixedAudioBufferList->mNumberBuffers; i++) {
+            free(mixedAudioBufferList->mBuffers[i].mData);
+        }
+        free(mixedAudioBufferList);
+    }
+    free(self.capturingContext);
+    self.capturingContext = NULL;
+}
+
++ (NSString *)description {
+    return @"AVAudioEngine Audio Mixing";
+}
+
+/*
+ * Determine at runtime the maximum slice size used by VoiceProcessingIO. Setting the stream format and sample rate
+ * doesn't appear to impact the maximum size so we prefer to read this value once at initialization time.
+ */
++ (void)initialize {
+    AudioComponentDescription audioUnitDescription = [self audioUnitDescription];
+    AudioComponent audioComponent = AudioComponentFindNext(NULL, &audioUnitDescription);
+    AudioUnit audioUnit;
+    OSStatus status = AudioComponentInstanceNew(audioComponent, &audioUnit);
+    if (status != 0) {
+        NSLog(@"Could not find VoiceProcessingIO AudioComponent instance!");
+        return;
+    }
+
+    UInt32 framesPerSlice = 0;
+    UInt32 propertySize = sizeof(framesPerSlice);
+    status = AudioUnitGetProperty(audioUnit, kAudioUnitProperty_MaximumFramesPerSlice,
+                                  kAudioUnitScope_Global, kOutputBus,
+                                  &framesPerSlice, &propertySize);
+    if (status != 0) {
+        NSLog(@"Could not read VoiceProcessingIO AudioComponent instance!");
+        AudioComponentInstanceDispose(audioUnit);
+        return;
+    }
+
+    NSLog(@"This device uses a maximum slice size of %d frames.", (unsigned int)framesPerSlice);
+    kMaximumFramesPerBuffer = (size_t)framesPerSlice;
+    AudioComponentInstanceDispose(audioUnit);
+}
+
+#pragma mark - Private (AVAudioEngine)
+
+- (BOOL)setupAudioEngine {
+    return [self setupPlayoutAudioEngine] && [self setupRecordAudioEngine];
+}
+
+// Non-nil no-op AVAudioSession config block. The SDK's CallKit hooks call
+// device.block() unconditionally; this device manages its own session, so the
+// block does nothing — but it must never be nil (a nil block call crashes).
+// (_block ivar + setBlock: are auto-synthesized from the .h property.)
+- (TVOAVAudioSessionConfigurationBlock)block {
+    return _block ?: ^{};
+}
+
+- (void)setEnabled:(BOOL)enabled {
+    @synchronized(self) {
+        if (enabled) {
+            // If the worker block is executed, then context is guaranteed to be valid.
+            TVOAudioDeviceContext context = [self deviceContext];
+            if (context) {
+                TVOAudioDeviceExecuteWorkerBlock(context, ^{
+                    _enabled = enabled;
+
+                    if (self.audioUnit) {
+                        [self teardownAudioUnit];
+                        [self startAudioUnit];
+                    }
+                });
+            }
+        }
+    }
+}
+
+- (BOOL)setupRecordAudioEngine {
+    NSAssert(_recordEngine == nil, @"AVAudioEngine is already configured");
+
+    /*
+     * By default AVAudioEngine will render to/from the audio device, and automatically establish connections between
+     * nodes, e.g. inputNode -> effectNode -> outputNode.
+     */
+    _recordEngine = [AVAudioEngine new];
+
+    // AVAudioEngine operates on the same format as the Core Audio output bus.
+    NSError *error = nil;
+    const AudioStreamBasicDescription asbd = [[[self class] activeFormat] streamDescription];
+    AVAudioFormat *format = [[AVAudioFormat alloc] initWithStreamDescription:&asbd];
+
+    // Switch to manual rendering mode
+    [_recordEngine stop];
+    BOOL success = [_recordEngine enableManualRenderingMode:AVAudioEngineManualRenderingModeRealtime
+                                                      format:format
+                                           maximumFrameCount:(uint32_t)kMaximumFramesPerBuffer
+                                                       error:&error];
+    if (!success) {
+        NSLog(@"Failed to setup manual rendering mode, error = %@", error);
+        return NO;
+    }
+
+    /*
+     * In manual rendering mode, AVAudioEngine won't receive audio from the microhpone. Instead, it will receive the
+     * audio data from the Voice SDK and mix it in MainMixerNode. Here we connect the input node to the main mixer node.
+     * InputNode -> MainMixer -> OutputNode
+     */
+    [_recordEngine connect:_recordEngine.inputNode to:_recordEngine.mainMixerNode format:format];
+
+    /*
+     * Attach AVAudioPlayerNode node to play music from a file.
+     * AVAudioPlayerNode -> ReverbNode -> MainMixer -> OutputNode (note: ReverbNode is optional)
+     */
+    [self attachMusicNodeToEngine:_recordEngine];
+
+    // Set the block to provide input data to engine
+    AVAudioInputNode *inputNode = _recordEngine.inputNode;
+    AudioBufferList *captureBufferList = &_captureBufferList;
+    success = [inputNode setManualRenderingInputPCMFormat:format
+                                               inputBlock: ^const AudioBufferList * _Nullable(AVAudioFrameCount inNumberOfFrames) {
+                                                   assert(inNumberOfFrames <= kMaximumFramesPerBuffer);
+                                                   return captureBufferList;
+                                               }];
+    if (!success) {
+        NSLog(@"Failed to set the manual rendering block");
+        return NO;
+    }
+
+    // The manual rendering block (called in Core Audio's VoiceProcessingIO's playout callback at real time)
+    self.capturingContext->renderBlock = (__bridge void *)(_recordEngine.manualRenderingBlock);
+
+    success = [_recordEngine startAndReturnError:&error];
+    if (!success) {
+        NSLog(@"Failed to start AVAudioEngine, error = %@", error);
+        return NO;
+    }
+
+    return YES;
+}
+
+- (BOOL)setupPlayoutAudioEngine {
+    NSAssert(_playoutEngine == nil, @"AVAudioEngine is already configured");
+
+    /*
+     * By default AVAudioEngine will render to/from the audio device, and automatically establish connections between
+     * nodes, e.g. inputNode -> effectNode -> outputNode.
+     */
+    _playoutEngine = [AVAudioEngine new];
+
+    // AVAudioEngine operates on the same format as the Core Audio output bus.
+    NSError *error = nil;
+    const AudioStreamBasicDescription asbd = [[[self class] activeFormat] streamDescription];
+    AVAudioFormat *format = [[AVAudioFormat alloc] initWithStreamDescription:&asbd];
+
+    // Switch to manual rendering mode
+    [_playoutEngine stop];
+    BOOL success = [_playoutEngine enableManualRenderingMode:AVAudioEngineManualRenderingModeRealtime
+                                                      format:format
+                                           maximumFrameCount:(uint32_t)kMaximumFramesPerBuffer
+                                                       error:&error];
+    if (!success) {
+        NSLog(@"Failed to setup manual rendering mode, error = %@", error);
+        return NO;
+    }
+
+    /*
+     * In manual rendering mode, AVAudioEngine won't receive audio from the microhpone. Instead, it will receive the
+     * audio data from the Voice SDK and mix it in MainMixerNode. Here we connect the input node to the main mixer node.
+     * InputNode -> MainMixer -> OutputNode
+     */
+    [_playoutEngine connect:_playoutEngine.inputNode to:_playoutEngine.mainMixerNode format:format];
+
+    /*
+     * Attach AVAudioPlayerNode node to play music from a file.
+     * AVAudioPlayerNode -> ReverbNode -> MainMixer -> OutputNode (note: ReverbNode is optional)
+     */
+    [self attachMusicNodeToEngine:_playoutEngine];
+
+    // Set the block to provide input data to engine
+    AudioRendererContext *context = _renderingContext;
+    AVAudioInputNode *inputNode = _playoutEngine.inputNode;
+    success = [inputNode setManualRenderingInputPCMFormat:format
+                                               inputBlock: ^const AudioBufferList * _Nullable(AVAudioFrameCount inNumberOfFrames) {
+                                                   assert(inNumberOfFrames <= kMaximumFramesPerBuffer);
+
+                                                   AudioBufferList *bufferList = context->bufferList;
+                                                   int8_t *audioBuffer = (int8_t *)bufferList->mBuffers[0].mData;
+                                                   UInt32 audioBufferSizeInBytes = bufferList->mBuffers[0].mDataByteSize;
+
+                                                   if (context->deviceContext) {
+                                                       /*
+                                                        * Pull decoded, mixed audio data from the media engine into the
+                                                        * AudioUnit's AudioBufferList.
+                                                        */
+                                                       TVOAudioDeviceReadRenderData(context->deviceContext, audioBuffer, audioBufferSizeInBytes);
+
+                                                   } else {
+
+                                                       /*
+                                                        * Return silence when we do not have the playout device context. This is the
+                                                        * case when the remote participant has not published an audio track yet.
+                                                        * Since the audio graph and audio engine has been setup, we can still play
+                                                        * the music file using AVAudioEngine.
+                                                        */
+                                                       memset(audioBuffer, 0, audioBufferSizeInBytes);
+                                                   }
+
+                                                   return bufferList;
+                                               }];
+    if (!success) {
+        NSLog(@"Failed to set the manual rendering block");
+        return NO;
+    }
+
+    // The manual rendering block (called in Core Audio's VoiceProcessingIO's playout callback at real time)
+    self.renderingContext->renderBlock = (__bridge void *)(_playoutEngine.manualRenderingBlock);
+
+    success = [_playoutEngine startAndReturnError:&error];
+    if (!success) {
+        NSLog(@"Failed to start AVAudioEngine, error = %@", error);
+        return NO;
+    }
+
+    return YES;
+}
+
+- (void)teardownAudioEngine {
+    [self teardownPlayer];
+    [_playoutEngine stop];
+    _playoutEngine = nil;
+
+    [_recordEngine stop];
+    _recordEngine = nil;
+}
+
+#pragma mark - ATTO file injection (generalized, replaces -playMusic)
+
+/*
+ * Generalized replacement for the example's hard-coded `-playMusic`. Loads an
+ * arbitrary local file, converts it to each engine's processing format when the
+ * formats differ (so there is no pitch/speed artifact), and schedules the buffer
+ * on the record file player (always — remote hears it) and the playout file
+ * player (only when `monitor == YES` — caller hears it).
+ *
+ * Returns NO on any failure (bad path, decode error, engine not running) and
+ * never throws/crashes.
+ */
+- (BOOL)scheduleFile:(NSString *)localPath monitor:(BOOL)monitor gain:(float)gain {
+    if (localPath.length == 0) {
+        NSLog(@"[AttoAudioEngineDevice] scheduleFile: empty path");
+        return NO;
+    }
+
+    // Accept both `file://...` URLs and bare filesystem paths.
+    NSURL *url = nil;
+    if ([localPath hasPrefix:@"file://"]) {
+        url = [NSURL URLWithString:localPath];
+    } else {
+        url = [NSURL fileURLWithPath:localPath];
+    }
+    if (url == nil) {
+        NSLog(@"[AttoAudioEngineDevice] scheduleFile: bad URL for path %@", localPath);
+        return NO;
+    }
+
+    NSError *error = nil;
+    AVAudioFile *file = [[AVAudioFile alloc] initForReading:url error:&error];
+    if (file == nil) {
+        NSLog(@"[AttoAudioEngineDevice] scheduleFile: failed to open file %@, error = %@", localPath, error);
+        return NO;
+    }
+
+    if (file.length <= 0) {
+        NSLog(@"[AttoAudioEngineDevice] scheduleFile: empty/zero-length file %@", localPath);
+        return NO;
+    }
+
+    // Read the file into a PCM buffer at the file's own processing format.
+    AVAudioPCMBuffer *sourceBuffer = [[AVAudioPCMBuffer alloc] initWithPCMFormat:file.processingFormat
+                                                                  frameCapacity:(AVAudioFrameCount)file.length];
+    if (sourceBuffer == nil) {
+        NSLog(@"[AttoAudioEngineDevice] scheduleFile: failed to allocate source buffer");
+        return NO;
+    }
+
+    if (![file readIntoBuffer:sourceBuffer error:&error]) {
+        NSLog(@"[AttoAudioEngineDevice] scheduleFile: failed to read file into buffer, error = %@", error);
+        return NO;
+    }
+
+    // Update injection state before scheduling so render-time/gain reads are consistent.
+    self.fileGain = gain;
+    self.monitorEnabled = monitor;
+
+    // Duration in milliseconds from the SOURCE file (sample-rate accurate).
+    double sourceSampleRate = file.processingFormat.sampleRate;
+    self.currentDurationMs = (sourceSampleRate > 0)
+        ? ((double)file.length / sourceSampleRate) * 1000.0
+        : 0.0;
+
+    /*
+     * The record file player is fed by `recordEngine` and the playout file player by `playoutEngine`. Both engines run
+     * at the active render format (the example uses 48kHz mono); the player node's output format is the format used when
+     * the node was connected in -attachMusicNodeToEngine: (file.processingFormat at attach time, but since the engines
+     * were created before any injection, the connection format is whatever the FIRST attach used). To avoid any pitch/
+     * speed artifact when the source sample rate/channel count differs, convert the source buffer to the destination
+     * player's OUTPUT format before scheduling.
+     */
+    BOOL anyScheduled = NO;
+
+    // Record path — always (remote hears it).
+    if (self.recordFilePlayer && self.recordEngine.isRunning) {
+        AVAudioFormat *destFormat = [self.recordFilePlayer outputFormatForBus:0];
+        AVAudioPCMBuffer *recordBuffer = [self bufferByConverting:sourceBuffer toFormat:destFormat];
+        if (recordBuffer) {
+            self.recordReverb.wetDryMix = 0; // dry by default; reverb node kept for graph parity
+            [self.recordFilePlayer setVolume:gain];
+            __weak typeof(self) weakSelf = self;
+            [self.recordFilePlayer scheduleBuffer:recordBuffer
+                                           atTime:nil
+                                          options:AVAudioPlayerNodeBufferInterrupts
+                                completionHandler:^{
+                // The record player drives the canonical "ended" signal (remote-facing).
+                [weakSelf handlePlaybackEnded];
+            }];
+            [self.recordFilePlayer play];
+            anyScheduled = YES;
+        }
+    }
+
+    // Playout path — only when monitoring (local caller hears it).
+    if (monitor && self.playoutFilePlayer && self.playoutEngine.isRunning) {
+        AVAudioFormat *destFormat = [self.playoutFilePlayer outputFormatForBus:0];
+        AVAudioPCMBuffer *playoutBuffer = [self bufferByConverting:sourceBuffer toFormat:destFormat];
+        if (playoutBuffer) {
+            self.playoutReverb.wetDryMix = 0;
+            [self.playoutFilePlayer setVolume:gain];
+            [self.playoutFilePlayer scheduleBuffer:playoutBuffer
+                                            atTime:nil
+                                           options:AVAudioPlayerNodeBufferInterrupts
+                                 completionHandler:^{
+                // Monitor finishing is not authoritative; record path reports ended.
+            }];
+            [self.playoutFilePlayer play];
+            anyScheduled = YES;
+        }
+    } else if (self.playoutFilePlayer && self.playoutFilePlayer.isPlaying) {
+        // Monitoring turned off for this schedule: make sure a previous monitor isn't left running.
+        [self.playoutFilePlayer stop];
+    }
+
+    if (!anyScheduled) {
+        NSLog(@"[AttoAudioEngineDevice] scheduleFile: nothing scheduled (engines not running?)");
+        return NO;
+    }
+
+    [self startStatusTimer];
+
+    return YES;
+}
+
+- (void)stopFile {
+    [self stopStatusTimer];
+
+    dispatch_block_t work = ^{
+        if (self.recordFilePlayer.isPlaying) {
+            [self.recordFilePlayer stop];
+        }
+        if (self.playoutFilePlayer.isPlaying) {
+            [self.playoutFilePlayer stop];
+        }
+    };
+
+    if ([NSThread isMainThread]) {
+        work();
+    } else {
+        dispatch_async(dispatch_get_main_queue(), work);
+    }
+}
+
+- (void)setGain:(float)gain {
+    float clamped = gain;
+    if (clamped < 0.0f) clamped = 0.0f;
+    if (clamped > 1.0f) clamped = 1.0f;
+    self.fileGain = clamped;
+
+    dispatch_block_t work = ^{
+        [self.recordFilePlayer setVolume:clamped];
+        if (self.monitorEnabled) {
+            [self.playoutFilePlayer setVolume:clamped];
+        }
+    };
+    if ([NSThread isMainThread]) {
+        work();
+    } else {
+        dispatch_async(dispatch_get_main_queue(), work);
+    }
+}
+
+- (void)setMonitor:(BOOL)on {
+    self.monitorEnabled = on;
+
+    dispatch_block_t work = ^{
+        if (on) {
+            // Mirror the current gain onto the playout (monitor) player. If a file is
+            // currently playing on the record player but not yet on playout, the
+            // monitor will pick up on the next schedule; live toggling primarily
+            // controls volume so we don't desync the two players mid-buffer.
+            [self.playoutFilePlayer setVolume:self.fileGain];
+        } else {
+            [self.playoutFilePlayer setVolume:0.0f];
+        }
+    };
+    if ([NSThread isMainThread]) {
+        work();
+    } else {
+        dispatch_async(dispatch_get_main_queue(), work);
+    }
+}
+
+/*
+ * Convert `buffer` to `format` using AVAudioConverter when the formats differ.
+ * Returns the original buffer when formats already match. Returns nil on failure.
+ */
+- (nullable AVAudioPCMBuffer *)bufferByConverting:(AVAudioPCMBuffer *)buffer toFormat:(AVAudioFormat *)format {
+    if (buffer == nil || format == nil) {
+        return buffer;
+    }
+
+    if ([buffer.format isEqual:format]) {
+        return buffer;
+    }
+
+    AVAudioConverter *converter = [[AVAudioConverter alloc] initFromFormat:buffer.format toFormat:format];
+    if (converter == nil) {
+        NSLog(@"[AttoAudioEngineDevice] bufferByConverting: could not create converter %@ -> %@", buffer.format, format);
+        return nil;
+    }
+
+    // Size the destination buffer for the sample-rate ratio (+ slack) so the full file fits.
+    double ratio = format.sampleRate / buffer.format.sampleRate;
+    AVAudioFrameCount destCapacity = (AVAudioFrameCount)ceil((double)buffer.frameLength * ratio) + 1024;
+    AVAudioPCMBuffer *destBuffer = [[AVAudioPCMBuffer alloc] initWithPCMFormat:format
+                                                                frameCapacity:destCapacity];
+    if (destBuffer == nil) {
+        NSLog(@"[AttoAudioEngineDevice] bufferByConverting: could not allocate dest buffer");
+        return nil;
+    }
+
+    __block BOOL provided = NO;
+    NSError *convError = nil;
+    AVAudioConverterInputBlock inputBlock = ^AVAudioBuffer * _Nullable(AVAudioPacketCount inNumberOfPackets,
+                                                                       AVAudioConverterInputStatus * _Nonnull outStatus) {
+        if (provided) {
+            *outStatus = AVAudioConverterInputStatus_EndOfStream;
+            return nil;
+        }
+        provided = YES;
+        *outStatus = AVAudioConverterInputStatus_HaveData;
+        return buffer;
+    };
+
+    AVAudioConverterOutputStatus status = [converter convertToBuffer:destBuffer
+                                                               error:&convError
+                                                  withInputFromBlock:inputBlock];
+    if (status == AVAudioConverterOutputStatus_Error) {
+        NSLog(@"[AttoAudioEngineDevice] bufferByConverting: conversion failed, error = %@", convError);
+        return nil;
+    }
+
+    return destBuffer;
+}
