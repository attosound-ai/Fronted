+#pragma mark - ATTO file injection (generalized, replaces -playMusic)
+
+/*
+ * Generalized replacement for the example's hard-coded `-playMusic`. Loads an
+ * arbitrary local file, converts it to each engine's processing format when the
+ * formats differ (so there is no pitch/speed artifact), and schedules the buffer
+ * on the record file player (always — remote hears it) and the playout file
+ * player (only when `monitor == YES` — caller hears it).
+ *
+ * Returns NO on any failure (bad path, decode error, engine not running) and
+ * never throws/crashes.
+ */
+- (BOOL)scheduleFile:(NSString *)localPath monitor:(BOOL)monitor gain:(float)gain {
+    if (localPath.length == 0) {
+        NSLog(@"[AttoAudioEngineDevice] scheduleFile: empty path");
+        return NO;
+    }
+
+    // Accept both `file://...` URLs and bare filesystem paths.
+    NSURL *url = nil;
+    if ([localPath hasPrefix:@"file://"]) {
+        url = [NSURL URLWithString:localPath];
+    } else {
+        url = [NSURL fileURLWithPath:localPath];
+    }
+    if (url == nil) {
+        NSLog(@"[AttoAudioEngineDevice] scheduleFile: bad URL for path %@", localPath);
+        return NO;
+    }
+
+    NSError *error = nil;
+    AVAudioFile *file = [[AVAudioFile alloc] initForReading:url error:&error];
+    if (file == nil) {
+        NSLog(@"[AttoAudioEngineDevice] scheduleFile: failed to open file %@, error = %@", localPath, error);
+        return NO;
+    }
+
+    if (file.length <= 0) {
+        NSLog(@"[AttoAudioEngineDevice] scheduleFile: empty/zero-length file %@", localPath);
+        return NO;
+    }
+
+    // Read the file into a PCM buffer at the file's own processing format.
+    AVAudioPCMBuffer *sourceBuffer = [[AVAudioPCMBuffer alloc] initWithPCMFormat:file.processingFormat
+                                                                  frameCapacity:(AVAudioFrameCount)file.length];
+    if (sourceBuffer == nil) {
+        NSLog(@"[AttoAudioEngineDevice] scheduleFile: failed to allocate source buffer");
+        return NO;
+    }
+
+    if (![file readIntoBuffer:sourceBuffer error:&error]) {
+        NSLog(@"[AttoAudioEngineDevice] scheduleFile: failed to read file into buffer, error = %@", error);
+        return NO;
+    }
+
+    // Update injection state before scheduling so render-time/gain reads are consistent.
+    self.fileGain = gain;
+    self.monitorEnabled = monitor;
+    // Mark injection live so the RT capture callback can count the frames that
+    // actually reach Twilio (injectFramesToCapture) — the only direct evidence
+    // that the far party received the injected audio.
+    if (self.capturingContext) { self.capturingContext->injectActive = 1; }
+
+    // Duration in milliseconds from the SOURCE file (sample-rate accurate).
+    double sourceSampleRate = file.processingFormat.sampleRate;
+    self.currentDurationMs = (sourceSampleRate > 0)
+        ? ((double)file.length / sourceSampleRate) * 1000.0
+        : 0.0;
+
+    /*
+     * The record file player is fed by `recordEngine` and the playout file player by `playoutEngine`. Both engines run
+     * at the active render format (the example uses 48kHz mono); the player node's output format is the format used when
+     * the node was connected in -attachMusicNodeToEngine: (file.processingFormat at attach time, but since the engines
+     * were created before any injection, the connection format is whatever the FIRST attach used). To avoid any pitch/
+     * speed artifact when the source sample rate/channel count differs, convert the source buffer to the destination
+     * player's OUTPUT format before scheduling.
+     */
+    BOOL anyScheduled = NO;
+
+    // Record path — always (remote hears it).
+    if (self.recordFilePlayer && self.recordEngine.isRunning) {
+        AVAudioFormat *destFormat = [self.recordFilePlayer outputFormatForBus:0];
+        // Telemetry: the two rates that decide injected pitch/speed.
+        _dbgLastInjectFileRate = file.processingFormat.sampleRate;
+        _dbgLastInjectDestRate = destFormat.sampleRate;
+        AVAudioPCMBuffer *recordBuffer = [self bufferByConverting:sourceBuffer toFormat:destFormat];
+        if (recordBuffer) {
+            self.recordReverb.wetDryMix = 0; // dry by default; reverb node kept for graph parity
+            [self.recordFilePlayer setVolume:gain];
+            __weak typeof(self) weakSelf = self;
+            [self.recordFilePlayer scheduleBuffer:recordBuffer
+                                           atTime:nil
+                                          options:AVAudioPlayerNodeBufferInterrupts
+                                completionHandler:^{
+                // The record player drives the canonical "ended" signal (remote-facing).
+                [weakSelf handlePlaybackEnded];
+            }];
+            [self.recordFilePlayer play];
+            anyScheduled = YES;
+        }
+    }
+
+    // Playout path — only when monitoring (local caller hears it).
+    if (monitor && self.playoutFilePlayer && self.playoutEngine.isRunning) {
+        AVAudioFormat *destFormat = [self.playoutFilePlayer outputFormatForBus:0];
+        AVAudioPCMBuffer *playoutBuffer = [self bufferByConverting:sourceBuffer toFormat:destFormat];
+        if (playoutBuffer) {
+            self.playoutReverb.wetDryMix = 0;
+            [self.playoutFilePlayer setVolume:gain];
+            [self.playoutFilePlayer scheduleBuffer:playoutBuffer
+                                            atTime:nil
+                                           options:AVAudioPlayerNodeBufferInterrupts
+                                 completionHandler:^{
+                // Monitor finishing is not authoritative; record path reports ended.
+            }];
+            [self.playoutFilePlayer play];
+            anyScheduled = YES;
+        }
+    } else if (self.playoutFilePlayer && self.playoutFilePlayer.isPlaying) {
+        // Monitoring turned off for this schedule: make sure a previous monitor isn't left running.
+        [self.playoutFilePlayer stop];
+    }
+
+    if (!anyScheduled) {
+        NSLog(@"[AttoAudioEngineDevice] scheduleFile: nothing scheduled (engines not running?)");
+        return NO;
+    }
+
+    [self startStatusTimer];
+
+    return YES;
+}
+
+- (void)stopFile {
+    [self stopStatusTimer];
+    _dbgStopFileCalls++;
+    // Injection is over: stop attributing captured frames to it.
+    if (self.capturingContext) { self.capturingContext->injectActive = 0; }
+
+    /*
+     * AUDIBLE KILL, SYNCHRONOUS (Aug 3). The player-stop below is dispatched to
+     * the main queue, and during in-call editor use the main thread can lag for
+     * SECONDS (jsLagPeakMs 1.3s measured; the ghost test showed injected frames
+     * flowing ~2s past the stop). Until that block runs, both players keep
+     * feeding the graph: the far party keeps receiving the track and the rep
+     * keeps hearing the monitor, i.e. "I turned it off and it kept sounding".
+     * `volume` is an AVAudioMixing parameter applied by the mixer, safe to set
+     * from any thread, so zero both players HERE and let the deferred stop do
+     * the structural cleanup whenever the main queue gets to it.
+     */
+    self.recordFilePlayer.volume = 0.0f;
+    self.playoutFilePlayer.volume = 0.0f;
+
+    CFTimeInterval stopRequestedAt = CACurrentMediaTime();
+    __weak typeof(self) weakSelf = self;
+    dispatch_block_t work = ^{
+        __strong typeof(weakSelf) strongSelf = weakSelf;
+        if (!strongSelf) { return; }
+        // How long this block sat behind the main thread — the direct
+        // measurement of the ghost tail's length.
+        strongSelf->_dbgLastStopFileLagMs =
+            (CACurrentMediaTime() - stopRequestedAt) * 1000.0;
+        if (strongSelf.recordFilePlayer.isPlaying) {
+            [strongSelf.recordFilePlayer stop];
+        }
+        if (strongSelf.playoutFilePlayer.isPlaying) {
+            [strongSelf.playoutFilePlayer stop];
+        }
+    };
+
+    if ([NSThread isMainThread]) {
+        work();
+    } else {
+        dispatch_async(dispatch_get_main_queue(), work);
+    }
+}
+
+- (void)setGain:(float)gain {
+    float clamped = gain;
+    if (clamped < 0.0f) clamped = 0.0f;
+    if (clamped > 1.0f) clamped = 1.0f;
+    self.fileGain = clamped;
+
+    dispatch_block_t work = ^{
+        [self.recordFilePlayer setVolume:clamped];
+        if (self.monitorEnabled) {
+            [self.playoutFilePlayer setVolume:clamped];
+        }
+    };
+    if ([NSThread isMainThread]) {
+        work();
+    } else {
+        dispatch_async(dispatch_get_main_queue(), work);
+    }
+}
+
+- (void)setMonitor:(BOOL)on {
+    self.monitorEnabled = on;
+
+    dispatch_block_t work = ^{
+        if (on) {
+            // Mirror the current gain onto the playout (monitor) player. If a file is
+            // currently playing on the record player but not yet on playout, the
+            // monitor will pick up on the next schedule; live toggling primarily
+            // controls volume so we don't desync the two players mid-buffer.
+            [self.playoutFilePlayer setVolume:self.fileGain];
+        } else {
+            [self.playoutFilePlayer setVolume:0.0f];
+        }
+    };
+    if ([NSThread isMainThread]) {
+        work();
+    } else {
+        dispatch_async(dispatch_get_main_queue(), work);
+    }
+}
+
+/*
+ * Convert `buffer` to `format` using AVAudioConverter when the formats differ.
+ * Returns the original buffer when formats already match. Returns nil on failure.
+ */
+- (nullable AVAudioPCMBuffer *)bufferByConverting:(AVAudioPCMBuffer *)buffer toFormat:(AVAudioFormat *)format {
+    if (buffer == nil || format == nil) {
+        return buffer;
+    }
+
+    if ([buffer.format isEqual:format]) {
+        return buffer;
+    }
+
+    AVAudioConverter *converter = [[AVAudioConverter alloc] initFromFormat:buffer.format toFormat:format];
+    if (converter == nil) {
+        NSLog(@"[AttoAudioEngineDevice] bufferByConverting: could not create converter %@ -> %@", buffer.format, format);
+        return nil;
+    }
+
+    // Size the destination buffer for the sample-rate ratio (+ slack) so the full file fits.
+    double ratio = format.sampleRate / buffer.format.sampleRate;
+    AVAudioFrameCount destCapacity = (AVAudioFrameCount)ceil((double)buffer.frameLength * ratio) + 1024;
+    AVAudioPCMBuffer *destBuffer = [[AVAudioPCMBuffer alloc] initWithPCMFormat:format
+                                                                frameCapacity:destCapacity];
+    if (destBuffer == nil) {
+        NSLog(@"[AttoAudioEngineDevice] bufferByConverting: could not allocate dest buffer");
+        return nil;
+    }
+
+    __block BOOL provided = NO;
+    NSError *convError = nil;
+    AVAudioConverterInputBlock inputBlock = ^AVAudioBuffer * _Nullable(AVAudioPacketCount inNumberOfPackets,
+                                                                       AVAudioConverterInputStatus * _Nonnull outStatus) {
+        if (provided) {
+            *outStatus = AVAudioConverterInputStatus_EndOfStream;
+            return nil;
+        }
+        provided = YES;
+        *outStatus = AVAudioConverterInputStatus_HaveData;
+        return buffer;
+    };
+
+    AVAudioConverterOutputStatus status = [converter convertToBuffer:destBuffer
+                                                               error:&convError
+                                                  withInputFromBlock:inputBlock];
+    if (status == AVAudioConverterOutputStatus_Error) {
+        NSLog(@"[AttoAudioEngineDevice] bufferByConverting: conversion failed, error = %@", convError);
+        return nil;
+    }
+
+    return destBuffer;
+}
+
+#pragma mark - ATTO 4-channel record MIXER
+
+/*
+ * RECORDING-CONSUMER DESIGN CHOICE
+ * --------------------------------
+ * We do NOT add nodes to the live playout/record engines (that could perturb the
+ * call path) and we do NOT build a second offline AVAudioEngine + AVAudioSourceNode
+ * (more moving parts, format coupling, and another real-time graph to babysit).
+ *
+ * Instead: four lock-free SPSC ring buffers + ONE serial dispatch consumer driven
+ * by a repeating dispatch_source timer. The real-time callbacks only memcpy mic /
+ * remote into their rings; an AVAudioEngine tap memcpys the injected "app" track
+ * into its ring; the metronome is synthesized by the consumer at sample-accurate
+ * phase. The consumer pulls a fixed frame quantum from each ring, applies gain +
+ * record-enable, sums with hard-clip protection, and appends to an AVAudioFile.
+ * File I/O therefore happens entirely OFF the audio threads. If the mixer is off
+ * all ring pointers in the C contexts are NULL and the engine is byte-identical.
+ */
+
+// Map a JS channel name to its index; returns -1 for unknown names.
+- (NSInteger)indexForChannelName:(NSString *)channel {
+    if ([channel isEqualToString:@"mic"]) return AttoMixChannelMic;
+    if ([channel isEqualToString:@"remote"]) return AttoMixChannelRemote;
+    if ([channel isEqualToString:@"app"]) return AttoMixChannelApp;
+    if ([channel isEqualToString:@"metronome"]) return AttoMixChannelMetronome;
+    return -1;
+}
+
+- (void)setMixerChannel:(NSString *)channel gain:(float)gain record:(BOOL)record {
+    NSInteger idx = [self indexForChannelName:channel];
+    if (idx < 0) {
+        return;
+    }
+    if (gain < 0.0f) gain = 0.0f;
+    if (gain > 1.0f) gain = 1.0f;
+
+    [self.mixLock lock];
+    _channelGain[idx] = gain;
+    _channelRecord[idx] = record;
+    [self.mixLock unlock];
+}
+
+#pragma mark - Metronome
+
+- (void)setMetronome:(BOOL)enabled bpm:(NSInteger)bpm {
+    if (bpm < 40) bpm = 40;
+    if (bpm > 240) bpm = 240;
+
+    [self.mixLock lock];
+    _metronomeOn = enabled;
+    _metronomeBpm = bpm;
+    // Recompute samples-per-beat against the recording (consumer) sample rate. If
+    // recording hasn't started yet, _metronomeSampleRate is 0 and this is finalized
+    // in -startMixRecording.
+    if (_metronomeSampleRate > 0.0) {
+        _metronomeSamplesPerBeat = (uint64_t)llround((60.0 / (double)bpm) * _metronomeSampleRate);
+        if (_metronomeSamplesPerBeat == 0) _metronomeSamplesPerBeat = 1;
+    }
+    [self.mixLock unlock];
+
+    // Drive the LOCAL monitor click (so the rep hears the beat) on the main run
+    // loop. The RECORDED metronome is generated independently + sample-accurately
+    // by the consumer, so monitor jitter never affects the file.
+    dispatch_block_t work = ^{
+        [self rebuildMetronomeMonitor];
+    };
+    if ([NSThread isMainThread]) {
+        work();
+    } else {
+        dispatch_async(dispatch_get_main_queue(), work);
+    }
+}
+
+/*
+ * (Re)build the local-monitor metronome: a dedicated AVAudioPlayerNode on the
+ * playout engine plus an NSTimer that schedules one synthesized click per beat.
+ * This is the AUDIBLE path only; it is independent of the recorded mix.
+ */
+- (void)rebuildMetronomeMonitor {
+    // Tear down any existing monitor first.
+    if (self.metronomeTimer) {
+        [self.metronomeTimer invalidate];
+        self.metronomeTimer = nil;
+    }
+    if (self.metronomePlayoutPlayer) {
+        if (self.metronomePlayoutPlayer.isPlaying) {
+            [self.metronomePlayoutPlayer stop];
+        }
+        @try {
+            [self.playoutEngine detachNode:self.metronomePlayoutPlayer];
+        } @catch (__unused NSException *e) {}
+        self.metronomePlayoutPlayer = nil;
+    }
+
+    BOOL on;
+    NSInteger bpm;
+    [self.mixLock lock];
+    on = _metronomeOn;
+    bpm = _metronomeBpm;
+    [self.mixLock unlock];
+
+    if (!on) {
+        return;
+    }
+    if (self.playoutEngine == nil) {
+        return;
+    }
+
+    // Build a click buffer at the playout engine's format and attach a player.
+    AVAudioFormat *fmt = [self.playoutEngine.mainMixerNode outputFormatForBus:0];
+    if (fmt == nil || fmt.sampleRate <= 0) {
+        return;
+    }
+    self.metronomeClickBuffer = [self synthesizeClickBufferForFormat:fmt];
+    if (self.metronomeClickBuffer == nil) {
+        return;
+    }
+
+    AVAudioPlayerNode *player = [[AVAudioPlayerNode alloc] init];
+    [self.playoutEngine attachNode:player];
+    [self.playoutEngine connect:player to:self.playoutEngine.mainMixerNode format:fmt];
+    self.metronomePlayoutPlayer = player;
+
+    if (self.playoutEngine.isRunning) {
+        [player play];
+    }
+
+    NSTimeInterval interval = 60.0 / (double)bpm;
+    self.metronomeTimer = [NSTimer scheduledTimerWithTimeInterval:interval
+                                                           target:self
+                                                         selector:@selector(tickMetronomeMonitor)
+                                                         userInfo:nil
+                                                          repeats:YES];
+    // Fire one immediately so the first beat isn't delayed by a full period.
+    [self tickMetronomeMonitor];
+}
+
+- (void)tickMetronomeMonitor {
+    AVAudioPlayerNode *player = self.metronomePlayoutPlayer;
+    AVAudioPCMBuffer *click = self.metronomeClickBuffer;
+    if (player == nil || click == nil) {
+        return;
+    }
+    // Gate the audible click on the metronome channel gain so the slider also
+    // controls what the rep hears (record-enable only affects the FILE).
+    float gain;
+    [self.mixLock lock];
+    gain = _channelGain[AttoMixChannelMetronome];
+    [self.mixLock unlock];
+
+    [player setVolume:gain];
+    if (self.playoutEngine.isRunning && !player.isPlaying) {
+        [player play];
+    }
+    [player scheduleBuffer:click atTime:nil options:0 completionHandler:nil];
+}
+
+/*
+ * Synthesize a short percussive click (no bundled asset): ~30ms of a ~1kHz sine
+ * with a fast exponential decay envelope, at the requested format's sample rate.
+ * Mono; if the format has >1 channel we fill channel 0 (player upmixes).
+ */
+- (nullable AVAudioPCMBuffer *)synthesizeClickBufferForFormat:(AVAudioFormat *)format {
+    if (format == nil || format.sampleRate <= 0) {
+        return nil;
+    }
+    double sr = format.sampleRate;
+    AVAudioFrameCount frames = (AVAudioFrameCount)(0.030 * sr); // 30ms
+    if (frames < 1) frames = 1;
+
+    AVAudioPCMBuffer *buf = [[AVAudioPCMBuffer alloc] initWithPCMFormat:format frameCapacity:frames];
+    if (buf == nil) {
+        return nil;
+    }
+    buf.frameLength = frames;
+
+    const double freq = 1000.0;   // 1kHz click
+    const double decay = 25.0;    // exponential decay rate (per second)
+    const double twoPiF = 2.0 * M_PI * freq;
+
+    if (format.commonFormat == AVAudioPCMFormatFloat32 && buf.floatChannelData != NULL) {
+        float *ch = buf.floatChannelData[0];
+        for (AVAudioFrameCount i = 0; i < frames; i++) {
+            double t = (double)i / sr;
+            double env = exp(-decay * t);
+            ch[i] = (float)(0.9 * env * sin(twoPiF * t));
+        }
+    } else if (format.commonFormat == AVAudioPCMFormatInt16 && buf.int16ChannelData != NULL) {
+        int16_t *ch = buf.int16ChannelData[0];
+        for (AVAudioFrameCount i = 0; i < frames; i++) {
+            double t = (double)i / sr;
+            double env = exp(-decay * t);
+            double s = 0.9 * env * sin(twoPiF * t);
+            ch[i] = (int16_t)(s * 32767.0);
+        }
+    } else {
+        // Unsupported click format; bail (monitor just won't tick).
+        return nil;
+    }
+    return buf;
+}
+
+/*
+ * Build the synthesized click as a raw float array at the CONSUMER (file) sample
+ * rate, used to render the metronome directly into the recorded mix. Stored in
+ * _metronomeClickSamples / _metronomeClickLength. Caller holds no lock; this is
+ * only invoked from -startMixRecording before the consumer starts.
+ */
+- (void)buildRecordedClickAtSampleRate:(double)sr {
+    if (_metronomeClickSamples) {
+        free(_metronomeClickSamples);
+        _metronomeClickSamples = NULL;
+        _metronomeClickLength = 0;
+    }
+    if (sr <= 0) return;
+
+    size_t frames = (size_t)(0.030 * sr);
+    if (frames < 1) frames = 1;
+    float *samples = (float *)malloc(frames * sizeof(float));
+    if (samples == NULL) return;
+
+    const double freq = 1000.0;
+    const double decay = 25.0;
+    const double twoPiF = 2.0 * M_PI * freq;
+    for (size_t i = 0; i < frames; i++) {
+        double t = (double)i / sr;
+        double env = exp(-decay * t);
+        samples[i] = (float)(0.9 * env * sin(twoPiF * t));
+    }
+    _metronomeClickSamples = samples;
+    _metronomeClickLength = frames;
+    _metronomeClickPos = frames; // start idle (no click in progress)
+}
+
+#pragma mark - App (injection) channel tap
+
+/*
+ * Install a tap on the record file player's post-reverb node so the INJECTED
+ * track (and only it — isolated from the mic) flows into the "app" ring. The tap
+ * delivers mono float at the node's output format; we push it straight in (the
+ * record engine and the consumer file share the same engine sample rate, so no
+ * resample is needed for the app channel). Tap callbacks may safely memcpy.
+ */
+- (void)installAppTap {
+    AVAudioNode *tapNode = self.recordReverb ?: (AVAudioNode *)self.recordFilePlayer;
+    if (tapNode == nil) {
+        return;
+    }
+    AVAudioFormat *fmt = [tapNode outputFormatForBus:0];
+    if (fmt == nil) {
+        return;
+    }
+    AttoRingBuffer *appRing = &_appRing;
+    @try {
+        [tapNode removeTapOnBus:0];
+    } @catch (__unused NSException *e) {}
+    @try {
+        [tapNode installTapOnBus:0
+                      bufferSize:1024
+                          format:fmt
+                           block:^(AVAudioPCMBuffer * _Nonnull buffer, AVAudioTime * _Nonnull when) {
+            if (buffer.floatChannelData == NULL) {
+                return;
+            }
+            const float *src = buffer.floatChannelData[0]; // mono / first channel
+            AttoRingWrite(appRing, src, (size_t)buffer.frameLength);
+        }];
+    } @catch (__unused NSException *e) {
+        // Tap install can throw if the node isn't in a running engine; non-fatal.
+    }
+}
+
+- (void)removeAppTap {
+    AVAudioNode *tapNode = self.recordReverb ?: (AVAudioNode *)self.recordFilePlayer;
+    if (tapNode == nil) {
+        return;
+    }
+    @try {
+        [tapNode removeTapOnBus:0];
+    } @catch (__unused NSException *e) {}
+}
+
+#pragma mark - Record lifecycle
+
+- (nullable NSString *)startMixRecording {
+    [self.mixLock lock];
+    if (_mixRecording) {
+        [self.mixLock unlock];
+        NSLog(@"[AttoAudioEngineDevice] startMixRecording: already recording");
+        return self.mixFilePath;
+    }
+
+    // Allocate ring buffers lazily on first record.
+    if (!_ringsAllocated) {
+        AttoRingInit(&_micRing);
+        AttoRingInit(&_remoteRing);
+        AttoRingInit(&_appRing);
+        _ringsAllocated = YES;
+    } else {
+        AttoRingReset(&_micRing);
+        AttoRingReset(&_remoteRing);
+        AttoRingReset(&_appRing);
+    }
+
+    /*
+     * The recorded file format: mono float32 at the active ENGINE sample rate.
+     *
+     * This used to read `[AVAudioSession sharedInstance].sampleRate`, which is a
+     * different number and wrong on two counts (Aug 3 2026):
+     *
+     * 1) WRONG RATE. The rings carry samples at the NEGOTIATED engine rate
+     *    (_renderingFormat / _capturingFormat), not the raw session rate, and the
+     *    two can differ — CoreAudio bridges them with its own SRC. Declaring the
+     *    file at the session rate while filling it with engine-rate samples is
+     *    exactly the mismatch that produced the "monster voice" pitch/speed bug
+     *    (b93, see the comment on engineTargetFormat). With session 48k and
+     *    negotiated 24k, a take plays back at double speed and half length.
+     *
+     * 2) LIVE SESSION READ. Synchronously reading an AVAudioSession property on
+     *    whatever thread JS calls in on is the XPC that caused App Hang
+     *    REACT-NATIVE-4N at hang-up; b92 cached the session props and banned live
+     *    reads for that reason. engineTargetFormat is a plain object read.
+     *
+     * KNOWN REMAINING GAP: if the route changes mid-take the engine is rebuilt at
+     * a new rate while this file keeps its original one, so audio after the
+     * rebuild is pitched/timed wrong. The real fix is an AVAudioConverter in the
+     * consumer fed by an atomic "current ring rate"; that is a larger change and
+     * is tracked separately. routeRebuildCount tells us how often a take crossed
+     * a rebuild (0 across all production diagnostics so far).
+     */
+    double sampleRate = [self engineTargetFormat].sampleRate;
+    if (sampleRate <= 0) sampleRate = (double)kPreferredSampleRate;
+
+    AVAudioFormat *fileFormat = [[AVAudioFormat alloc] initWithCommonFormat:AVAudioPCMFormatFloat32
+                                                                 sampleRate:sampleRate
+                                                                   channels:1
+                                                                interleaved:NO];
+    if (fileFormat == nil) {
+        [self.mixLock unlock];
+        NSLog(@"[AttoAudioEngineDevice] startMixRecording: bad file format");
+        return nil;
+    }
+
+    NSString *fileName = [NSString stringWithFormat:@"atto-mix-%.0f.caf", [[NSDate date] timeIntervalSince1970] * 1000.0];
+    NSString *path = [NSTemporaryDirectory() stringByAppendingPathComponent:fileName];
+    NSURL *url = [NSURL fileURLWithPath:path];
+
+    // Write float PCM (.caf supports float natively, lossless, no encoder hiccups).
+    NSDictionary *settings = @{
+        AVFormatIDKey: @(kAudioFormatLinearPCM),
+        AVSampleRateKey: @(sampleRate),
+        AVNumberOfChannelsKey: @(1),
+        AVLinearPCMBitDepthKey: @(32),
+        AVLinearPCMIsFloatKey: @(YES),
+        AVLinearPCMIsBigEndianKey: @(NO),
+        AVLinearPCMIsNonInterleaved: @(NO),
+    };
+
+    NSError *error = nil;
+    AVAudioFile *file = [[AVAudioFile alloc] initForWriting:url
+                                                   settings:settings
+                                               commonFormat:AVAudioPCMFormatFloat32
+                                                interleaved:NO
+                                                      error:&error];
+    if (file == nil) {
+        [self.mixLock unlock];
+        NSLog(@"[AttoAudioEngineDevice] startMixRecording: failed to open file %@, error = %@", path, error);
+        return nil;
+    }
+
+    self.mixFile = file;
+    self.mixFilePath = path;
+    self.mixFileFormat = fileFormat;
+
+    // Metronome phase setup at the file sample rate.
+    _metronomeSampleRate = sampleRate;
+    NSInteger bpm = _metronomeBpm;
+    _metronomeSamplesPerBeat = (uint64_t)llround((60.0 / (double)bpm) * sampleRate);
+    if (_metronomeSamplesPerBeat == 0) _metronomeSamplesPerBeat = 1;
+    _metronomeSampleCounter = 0;
+
+    _mixRecording = YES;
+    // Reset per-channel telemetry counters + live levels for this recording.
+    _dbgMicFrames = 0;
+    _dbgRemoteFrames = 0;
+    _dbgAppFrames = 0;
+    _dbgTotalFrames = 0;
+    // Per-take alignment counters, so micStarvedFallbacks answers "did THIS take
+    // drift?" rather than "has it ever drifted since launch".
+    _micStarvedTicks = 0;
+    _dbgMicStarvedFallbacks = 0;
+    _remoteLevelEMA = 0.0f;
+    _micLevelEMA = 0.0f;
+    [self.mixLock unlock];
+
+    // Build the recorded-metronome click at the file rate (outside the lock).
+    [self buildRecordedClickAtSampleRate:sampleRate];
+
+    // Publish ring pointers into the C contexts so the real-time callbacks start
+    // tapping. @synchronized(self) matches the callbacks' setup/teardown guard.
+    // NOTE: done OUTSIDE mixLock to keep a single global lock order
+    // (@synchronized(self) is also entered by route/media handlers; never nest it
+    // under mixLock or vice-versa to avoid an inversion deadlock). A pointer store
+    // is atomic on arm64, so the callback either sees NULL or the valid ring; the
+    // ring itself was fully initialized above before this publish.
+    @synchronized(self) {
+        if (self.capturingContext) {
+            self.capturingContext->micRing = &_micRing;
+            self.capturingContext->cbCount = 0; // reset per-recording fire count
+        }
+        if (self.renderingContext) {
+            self.renderingContext->remoteRing = &_remoteRing;
+            self.renderingContext->cbCount = 0;
+        }
+    }
+
+    // App-track tap (must run on the engine's queue → main).
+    dispatch_block_t tapWork = ^{ [self installAppTap]; };
+    if ([NSThread isMainThread]) { tapWork(); } else { dispatch_sync(dispatch_get_main_queue(), tapWork); }
+
+    [self startMixConsumer];
+
+    NSLog(@"[AttoAudioEngineDevice] startMixRecording -> %@", path);
+    return path;
+}
+
+- (nullable NSString *)stopMixRecording {
+    [self.mixLock lock];
+    if (!_mixRecording) {
+        [self.mixLock unlock];
+        return nil;
+    }
+    _mixRecording = NO;
+    NSString *path = self.mixFilePath;
+    [self.mixLock unlock];
+
+    // Retract the ring pointers so the real-time callbacks stop tapping. Done
+    // OUTSIDE mixLock to preserve the single global lock order (see startMixRecording).
+    // After this, the callbacks are byte-identical to the pre-mixer behavior. The
+    // ring memory is NOT freed here (kept for reuse); the consumer's final drain
+    // below still safely reads whatever remained.
+    @synchronized(self) {
+        if (self.capturingContext) {
+            self.capturingContext->micRing = NULL;
+        }
+        if (self.renderingContext) {
+            self.renderingContext->remoteRing = NULL;
+        }
+    }
+
+    // Remove the app tap on the engine queue.
+    dispatch_block_t tapWork = ^{ [self removeAppTap]; };
+    if ([NSThread isMainThread]) { tapWork(); } else { dispatch_sync(dispatch_get_main_queue(), tapWork); }
+
+    // Stop the consumer (this drains a final time + closes the file).
+    [self teardownMixConsumer];
+
+    [self.mixLock lock];
+    self.mixFile = nil; // ARC releases → file finalized/closed
+    self.mixFilePath = nil;
+    self.mixFileFormat = nil;
+    [self.mixLock unlock];
+
+    NSLog(@"[AttoAudioEngineDevice] stopMixRecording -> %@", path);
+    return path;
+}
+
+#pragma mark - Mix telemetry
+
+/*
+ * Per-channel frame totals for the last mix recording — the single most useful
+ * signal for "did the engine actually capture what we think?". Read by JS right
+ * after stopMixRecording (the consumer is already torn down, counters stable).
+ *   remoteFrames ≈ 0 ⇒ engine never received the other party (recording is one
+ *     sided AND two-way call audio is broken AND inject→capture won't reach them)
+ *   totalFrames == 0 ⇒ the mix captured nothing at all
+ *
+ * CORRECTION (Aug 2 2026): this comment used to claim "appFrames ≈ 0 during a
+ * transmit ⇒ injected audio never entered the mix". That is WRONG and it sent an
+ * investigation down the wrong path. `_dbgAppFrames` only advances inside the
+ * mix-recording consumer, so it reads 0 whenever startMixRecording is not live —
+ * which is almost always. It says nothing about whether injected audio reached
+ * the far party. Use `injectFramesToCapture` for that; it counts frames handed to
+ * Twilio while an injection was active.
+ */
+- (NSDictionary *)mixDiagnostics {
+    double sr = _metronomeSampleRate > 0 ? _metronomeSampleRate : (double)kPreferredSampleRate;
+    uint64_t total = _dbgTotalFrames;
+    uint64_t recCb = self.capturingContext ? self.capturingContext->cbCount : 0;
+    uint64_t playCb = self.renderingContext ? self.renderingContext->cbCount : 0;
+    uint64_t renderFail = self.capturingContext ? self.capturingContext->renderFailCount : 0;
+
+    // ATTO (Aug 3 2026): route-change reason histogram, indexed by the reason value
+    // itself so the array position IS the AVAudioSessionRouteChangeReason:
+    //   0 Unknown, 1 NewDeviceAvailable, 2 OldDeviceUnavailable, 3 CategoryChange,
+    //   4 Override, 5 (unused), 6 WakeFromSleep, 7 NoSuitableRouteForCategory,
+    //   8 RouteConfigurationChange.
+    NSMutableArray<NSNumber *> *routeReasonCounts =
+        [NSMutableArray arrayWithCapacity:(NSUInteger)kAttoRouteChangeReasonCount];
+    for (NSUInteger i = 0; i < (NSUInteger)kAttoRouteChangeReasonCount; i++) {
+        [routeReasonCounts addObject:@(_dbgRouteReasonCounts[i])];
+    }
+
+    // ATTO (Aug 3 2026): read the negotiated formats under the device lock, like
+    // every other reader now does. This method runs on the JS thread while the
+    // media engine's threads can be nilling those ivars.
+    double renderingFormatRate = 0.0;
+    double capturingFormatRate = 0.0;
+    @synchronized(self) {
+        renderingFormatRate = _renderingFormat ? _renderingFormat.sampleRate : 0.0;
+        capturingFormatRate = _capturingFormat ? _capturingFormat.sampleRate : 0.0;
+    }
+
+    return @{
+        @"micFrames": @(_dbgMicFrames),
+        @"remoteFrames": @(_dbgRemoteFrames),
+        @"appFrames": @(_dbgAppFrames),
+        @"totalFrames": @(total),
+        @"durationSec": @(sr > 0 ? (double)total / sr : 0.0),
+        @"sampleRate": @(sr),
+        // recordCbCount/playoutCbCount == 0 ⇒ the custom device is NOT Twilio's
+        // active device (engine inert) — the smoking gun for empty recordings.
+        @"recordCbCount": @(recCb),
+        @"playoutCbCount": @(playCb),
+        // ATTO (build 87): the LIVE AVAudioSession sample rate + whether it is the
+        // PlayAndRecord category. If the session-activate fix worked, recordCbCount
+        // is now hundreds (not stuck at 29) and sessionSampleRate is the real call
+        // rate (== engine rate), confirming the unit is backed by an active session.
+        // CACHED session props (never live-read the session here: main-thread XPC
+        // deadlocked at hang-up — App Hang REACT-NATIVE-4N).
+        @"sessionSampleRate": @(_dbgCachedSessionRate),
+        @"sessionIsPlayAndRecord": @(_dbgCachedSessionIsPAR),
+        // Rates of the last injected file → the pitch-bug pinpoint: fileRate is the
+        // source, destRate is the player-graph rate it was converted to; engine rate
+        // via _enginesBuiltFormat below. Any mismatch = wrong-speed playback.
+        @"lastInjectFileRate": @(_dbgLastInjectFileRate),
+        @"lastInjectDestRate": @(_dbgLastInjectDestRate),
+        @"enginesBuiltRate": @(_enginesBuiltFormat ? _enginesBuiltFormat.sampleRate : 0),
+        // Negotiated (Twilio-facing) rates — the engines MUST match these. A
+        // mismatch here = wrong-speed audio (monster/chipmunk).
+        @"renderingFormatRate": @(renderingFormatRate),
+        @"capturingFormatRate": @(capturingFormatRate),
+        // stopFile forensics (Aug 3 ghost tail): how many stops ran, and how long
+        // the last one's player-stop block waited behind the main thread. A lag
+        // in the seconds while injectFramesToCapture kept climbing = the ghost.
+        @"stopFileCalls": @(_dbgStopFileCalls),
+        @"lastStopFileLagMs": @(_dbgLastStopFileLagMs),
+        // ATTO (build 83): did Twilio even drive the device's start hooks this call?
+        // startCapturingCount>0 + recordCbCount==0 ⇒ device bound but AudioUnit not
+        // pumping (session/format). startCapturingCount==0 ⇒ device not bound at all.
+        @"startCapturingCount": @(_dbgStartCapturingCount),
+        @"startRenderingCount": @(_dbgStartRenderingCount),
+        // ATTO (build 88) AudioUnit lifecycle — starvation vs explicit-stop:
+        @"audioUnitStartCount": @(_dbgAudioUnitStartCount),
+        @"audioUnitStopCount": @(_dbgAudioUnitStopCount),
+        @"teardownAudioUnitCount": @(_dbgTeardownAudioUnitCount),
+        @"interruptionBeganCount": @(_dbgInterruptionBeganCount),
+        @"routeRebuildCount": @(_dbgRouteRebuildCount),
+        /*
+         * ATTO (Aug 3 2026) ROUTE FORENSICS. All pure instrumentation, all shipped
+         * to everyone. lastRouteReason is the field that separates "iOS re-routed
+         * during the Bluetooth handoff" from "the user pulled the AirPods out" from
+         * "our own app moved it"; routeReasonCounts gives the same split over the
+         * whole call. lastRouteReason is -1 until a route change is observed, which
+         * is a different fact from reason 0 (Unknown).
+         */
+        @"routeReasonCounts": routeReasonCounts,
+        @"lastRouteReason": @(_dbgLastRouteReason),
+        @"lastRouteReasonAt": @(_dbgLastRouteReasonAt),
+        @"routeChangeNotifyCount": @(_dbgRouteChangeNotifyCount),
+        // >0 ⇒ route changes arrived while the AudioUnit was NULL (the teardown and
+        // rebuild window) and used to be discarded outright. routeRebuildCount is
+        // structurally blind to these: it only counts the successful path.
+        @"routeChangeDroppedCount": @(_dbgRouteChangeDroppedCount),
+        // How many of those were picked up again by a later start hook.
+        @"routeChangeRecheckedCount": @(_dbgRouteChangeRecheckedCount),
+        // >0 ⇒ the old rebuild comparand (_renderingFormat, which the media engine
+        // re-latches out from under us) and the correct one (_enginesBuiltFormat)
+        // disagreed about whether the engines needed rebuilding. This measures the
+        // size of the hole before the gated fix is widened past the dev cohort.
+        @"routeRebuildDisagreeCount": @(_dbgRouteRebuildDisagreeCount),
+        // >0 ⇒ activating the call session moved the sample rate AFTER Twilio had
+        // already latched a render/capture format, i.e. the A2DP-to-HFP answer
+        // signature. Counted for everyone; only acted on for the cohort.
+        @"sessionRateFlipCount": @(_dbgSessionRateFlipCount),
+        @"formatRealignScheduledCount": @(_dbgFormatRealignScheduledCount),
+        // Which side of the cohort flag this call ran on, so the counters above can
+        // be read without guessing.
+        @"renderFormatRecheckEnabled": @([self renderFormatRecheckEnabled] ? 1 : 0),
+        // >0 ⇒ an interruption ended, we restarted the unit, and the capture
+        // callbacks did NOT resume — the silent-starvation case that leaves the
+        // call dead and any take truncated. We now force a rebuild when it happens;
+        // this counts how often that was needed.
+        @"resumeStarvedCount": @(_dbgResumeStarvedCount),
+        // >0 ⇒ the consumer gave up waiting for late mic samples and let remote
+        // drive the file clock, which can shift mic and remote apart for the rest
+        // of the take. A take recorded while this was incrementing is a take to
+        // distrust when someone says "my voice doesn't line up".
+        @"micStarvedFallbacks": @(_dbgMicStarvedFallbacks),
+        @"setActiveFailCount": @(_dbgSetActiveFailCount),
+        // renderFailCount > 0 ⇒ the manual mix render failed and we fell back to
+        // raw-mic passthrough (the "no te escucho" root: engine couldn't mix, but
+        // two-way audio survives via the guard). Cumulative since device install.
+        @"renderFailCount": @(renderFail),
+        // Split cause (Aug 2 2026). cannotDoInContext ⇒ a node property was written
+        // while the engine rendered (a graph mutation from a non-RT thread). That is
+        // the failure a LIVE fader/mute control would cause, so this counter is the
+        // gate on whether live mixing is safe here. `other` is the genuine
+        // can't-mix class (wrong format, mid-rebuild) that produces dead audio.
+        @"renderFailCannotDoInContext":
+            @(self.capturingContext ? self.capturingContext->renderFailCannotDoInContext : 0),
+        @"renderFailOther":
+            @(self.capturingContext ? self.capturingContext->renderFailOther : 0),
+        // THE far-party proof: frames actually written to Twilio while an injection
+        // was active. 0 while transmitting ⇒ the far party received nothing, no
+        // matter what the UI or the player state says. This is what `appFrames` was
+        // wrongly believed to mean.
+        @"injectFramesToCapture":
+            @(self.capturingContext ? self.capturingContext->injectFramesToCapture : 0),
+        @"injectActive":
+            @(self.capturingContext ? self.capturingContext->injectActive : 0),
+        // Live injection diagnosis (why an injected reel may not reach the far
+        // party): recordEngineRunning==0 ⇒ scheduleFile's record path (the remote-
+        // facing one) never scheduled; recordPlayerPlaying==0 ⇒ the injected file
+        // isn't playing on the outgoing path. With renderFailCount they pinpoint
+        // whether injection dies at scheduling, playing, or the manual-render mix.
+        @"recordEngineRunning": @(self.recordEngine.isRunning ? 1 : 0),
+        @"recordPlayerPlaying": @(self.recordFilePlayer.isPlaying ? 1 : 0),
+        @"playoutPlayerPlaying": @(self.playoutFilePlayer.isPlaying ? 1 : 0),
+    };
+}
+
+/*
+ * Live RMS levels (0..1) for the record-screen waveform — polled by JS while
+ * recording. `remote` is the OTHER party specifically, so the wave can react to
+ * them talking (what the client asked for) instead of the local mic. Valid only
+ * while a mix recording is active (the consumer that updates them is running).
+ */
+- (NSDictionary *)mixLevels {
+    // ×4 makes quiet speech read on the wave; clamp to 1.
+    float r = _remoteLevelEMA * 4.0f; if (r > 1.0f) r = 1.0f;
+    float m = _micLevelEMA * 4.0f;    if (m > 1.0f) m = 1.0f;
+    return @{ @"remote": @(r), @"mic": @(m) };
+}
+
+#pragma mark - Mix consumer
+
+- (void)startMixConsumer {
+    [self teardownMixConsumer];
+
+    self.mixConsumerQueue = dispatch_queue_create("ai.atto.mixConsumer", DISPATCH_QUEUE_SERIAL);
+    dispatch_source_t timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, self.mixConsumerQueue);
+    self.mixConsumerTimer = timer;
+
+    // Drain every ~10ms; the rings hold ~1s so this has wide slack.
+    uint64_t intervalNs = 10 * NSEC_PER_MSEC;
+    dispatch_source_set_timer(timer, dispatch_time(DISPATCH_TIME_NOW, intervalNs), intervalNs, 5 * NSEC_PER_MSEC);
+
+    __weak typeof(self) weakSelf = self;
+    dispatch_source_set_event_handler(timer, ^{
+        [weakSelf drainAndWriteMix];
+    });
+    dispatch_resume(timer);
+}
+
+- (void)teardownMixConsumer {
+    if (self.mixConsumerTimer) {
+        dispatch_source_t timer = self.mixConsumerTimer;
+        self.mixConsumerTimer = nil;
+        dispatch_source_cancel(timer);
+        // Final drain on the consumer queue so trailing samples land in the file.
+        if (self.mixConsumerQueue) {
+            dispatch_sync(self.mixConsumerQueue, ^{
+                [self drainAndWriteMix];
+            });
+        }
+    }
+    self.mixConsumerQueue = nil;
+}
+
+/*
+ * The consumer body. Runs ONLY on mixConsumerQueue (serial). Pulls a quantum from
+ * each ring, applies per-channel gain + record-enable, synthesizes the recorded
+ * metronome at sample-accurate phase, sums with hard-clip protection, and appends
+ * to the AVAudioFile. Mic drives the frame count (the live call always produces
+ * mic frames); remote/app are aligned best-effort and zero-filled on underrun.
+ */
+- (void)drainAndWriteMix {
+    AVAudioFile *file = self.mixFile;
+    AVAudioFormat *fmt = self.mixFileFormat;
+    if (file == nil || fmt == nil) {
+        return;
+    }
+
+    // Snapshot params under the lock (cheap; held briefly).
+    float gain[AttoMixChannelCount];
+    BOOL rec[AttoMixChannelCount];
+    BOOL metroOn;
+    uint64_t samplesPerBeat;
+    [self.mixLock lock];
+    for (int i = 0; i < AttoMixChannelCount; i++) {
+        gain[i] = _channelGain[i];
+        rec[i] = _channelRecord[i];
+    }
+    metroOn = _metronomeOn;
+    samplesPerBeat = _metronomeSamplesPerBeat ?: 1;
+    [self.mixLock unlock];
+
+    // How many mic frames are available drives this pass (cap at a sane quantum).
+    static const size_t kQuantum = 4096; // <= ring slack; ~85ms at 48k
+    float micBuf[kQuantum];
+    float remoteBuf[kQuantum];
+    float appBuf[kQuantum];
+
+    size_t micAvail = AttoRingRead(&_micRing, micBuf, kQuantum);
+    if (micAvail == 0) {
+        /*
+         * PERMANENT MIC/REMOTE DESYNC — fixed Aug 3 2026.
+         *
+         * The fallback below consumes REMOTE frames without consuming matching
+         * mic frames. If the mic channel is armed, its samples are not missing,
+         * they simply have not arrived yet: the record callback and this consumer
+         * run on different clocks. Advancing remote past mic in that moment shifts
+         * the two channels apart by up to a full quantum (85 ms at 48 kHz) FOR THE
+         * REST OF THE TAKE, and it re-fires on every mic hiccup, accumulating. For
+         * an overdub — the entire reason this path exists — that is fatal: the
+         * voice no longer sits where it was performed.
+         *
+         * So when mic is armed we WAIT instead of stealing remote's frames. The
+         * consumer will be back in a moment with both.
+         *
+         * Bounded, because waiting forever would produce an empty file if the mic
+         * tap genuinely died: after kMaxMicStarvedTicks consecutive starved ticks
+         * we let remote drive so the take still advances, and we COUNT it, because
+         * a take that crossed this is a take to be suspicious of.
+         */
+        if (rec[AttoMixChannelMic]) {
+            static const uint32_t kMaxMicStarvedTicks = 20;
+            if (_micStarvedTicks < kMaxMicStarvedTicks) {
+                _micStarvedTicks++;
+                return;
+            }
+            _dbgMicStarvedFallbacks++;
+        }
+        // Mic is not armed (so it will never produce), or it has been starved long
+        // enough that stalling the file is worse than the drift.
+        micAvail = AttoRingRead(&_remoteRing, remoteBuf, kQuantum);
+        if (micAvail == 0) {
+            return;
+        }
+        // We already consumed remote into remoteBuf; zero mic.
+        memset(micBuf, 0, micAvail * sizeof(float));
+        // app aligned below.
+        size_t appGot = AttoRingRead(&_appRing, appBuf, micAvail);
+        if (appGot < micAvail) memset(appBuf + appGot, 0, (micAvail - appGot) * sizeof(float));
+        _dbgRemoteFrames += micAvail; // remote drove this tick (mic was silent)
+        _dbgAppFrames += appGot;
+        _dbgTotalFrames += micAvail;
+        [self mixAndWriteFrames:micAvail
+                            mic:micBuf remote:remoteBuf app:appBuf
+                           gain:gain rec:rec metroOn:metroOn samplesPerBeat:samplesPerBeat
+                           file:file format:fmt];
+        return;
+    }
+
+    // Mic delivered: the wait paid off, start the patience budget over.
+    _micStarvedTicks = 0;
+
+    size_t frames = micAvail;
+
+    // Read the SAME number of frames from remote + app; zero-fill on underrun so
+    // channels stay phase-aligned to the mic clock.
+    size_t remoteGot = AttoRingRead(&_remoteRing, remoteBuf, frames);
+    if (remoteGot < frames) memset(remoteBuf + remoteGot, 0, (frames - remoteGot) * sizeof(float));
+
+    size_t appGot = AttoRingRead(&_appRing, appBuf, frames);
+    if (appGot < frames) memset(appBuf + appGot, 0, (frames - appGot) * sizeof(float));
+
+    _dbgMicFrames += micAvail;
+    _dbgRemoteFrames += remoteGot;
+    _dbgAppFrames += appGot;
+    _dbgTotalFrames += frames;
+
+    // Live levels for the waveform (REMOTE-specific). RMS of this quantum, then an
+    // EMA so the displayed wave is smooth. Runs on the serial consumer queue.
+    {
+        double rs = 0.0, ms = 0.0;
+        for (size_t i = 0; i < remoteGot; i++) rs += (double)remoteBuf[i] * remoteBuf[i];
+        for (size_t i = 0; i < micAvail; i++)  ms += (double)micBuf[i] * micBuf[i];
+        float rRms = remoteGot ? (float)sqrt(rs / (double)remoteGot) : 0.0f;
+        float mRms = micAvail  ? (float)sqrt(ms / (double)micAvail)  : 0.0f;
+        const float a = 0.3f;
+        _remoteLevelEMA = _remoteLevelEMA * (1.0f - a) + rRms * a;
+        _micLevelEMA    = _micLevelEMA    * (1.0f - a) + mRms * a;
+    }
+
+    [self mixAndWriteFrames:frames
+                        mic:micBuf remote:remoteBuf app:appBuf
+                       gain:gain rec:rec metroOn:metroOn samplesPerBeat:samplesPerBeat
+                       file:file format:fmt];
+}
+
+- (void)mixAndWriteFrames:(size_t)frames
+                      mic:(const float *)micBuf
+                   remote:(const float *)remoteBuf
+                      app:(const float *)appBuf
+                     gain:(const float *)gain
+                      rec:(const BOOL *)rec
+                  metroOn:(BOOL)metroOn
+           samplesPerBeat:(uint64_t)samplesPerBeat
+                     file:(AVAudioFile *)file
+                   format:(AVAudioFormat *)fmt {
+    if (frames == 0) return;
+
+    AVAudioPCMBuffer *out = [[AVAudioPCMBuffer alloc] initWithPCMFormat:fmt
+                                                         frameCapacity:(AVAudioFrameCount)frames];
+    if (out == nil || out.floatChannelData == NULL) {
+        return;
+    }
+    out.frameLength = (AVAudioFrameCount)frames;
+    float *dst = out.floatChannelData[0];
+
+    float gMic = rec[AttoMixChannelMic] ? gain[AttoMixChannelMic] : 0.0f;
+    float gRemote = rec[AttoMixChannelRemote] ? gain[AttoMixChannelRemote] : 0.0f;
+    float gApp = rec[AttoMixChannelApp] ? gain[AttoMixChannelApp] : 0.0f;
+    float gMetro = (metroOn && rec[AttoMixChannelMetronome]) ? gain[AttoMixChannelMetronome] : 0.0f;
+
+    for (size_t i = 0; i < frames; i++) {
+        float s = micBuf[i] * gMic + remoteBuf[i] * gRemote + appBuf[i] * gApp;
+
+        // Metronome: synthesize at sample-accurate phase regardless of gating so
+        // the click position stays locked to wall-clock; only its gain is gated.
+        if (_metronomeClickSamples && _metronomeClickLength > 0) {
+            if (_metronomeSampleCounter % samplesPerBeat == 0) {
+                _metronomeClickPos = 0; // (re)trigger a click on the beat
+            }
+            if (_metronomeClickPos < _metronomeClickLength) {
+                s += _metronomeClickSamples[_metronomeClickPos] * gMetro;
+                _metronomeClickPos++;
+            }
+            _metronomeSampleCounter++;
+        }
+
+        // Hard-clip protection.
+        if (s > 1.0f) s = 1.0f;
+        else if (s < -1.0f) s = -1.0f;
+        dst[i] = s;
+    }
+
+    NSError *error = nil;
+    if (![file writeFromBuffer:out error:&error]) {
+        NSLog(@"[AttoAudioEngineDevice] mix write failed: %@", error);
+    }
+}
+
+#pragma mark - ATTO status reporting
+
+- (void)startStatusTimer {
+    dispatch_block_t work = ^{
+        [self stopStatusTimer];
+        // ~4 Hz position ticks. Scheduled on the main run loop.
+        self.statusTimer = [NSTimer scheduledTimerWithTimeInterval:0.25
+                                                            target:self
+                                                          selector:@selector(emitStatusTick)
+                                                          userInfo:nil
+                                                           repeats:YES];
+    };
+    if ([NSThread isMainThread]) {
+        work();
+    } else {
+        dispatch_async(dispatch_get_main_queue(), work);
+    }
+}
+
+- (void)stopStatusTimer {
+    dispatch_block_t work = ^{
+        if (self.statusTimer) {
+            [self.statusTimer invalidate];
+            self.statusTimer = nil;
+        }
+    };
+    if ([NSThread isMainThread]) {
+        work();
+    } else {
+        dispatch_async(dispatch_get_main_queue(), work);
+    }
+}
+
+- (void)emitStatusTick {
+    AVAudioPlayerNode *player = self.recordFilePlayer;
+    double positionMs = 0.0;
+
+    @try {
+        AVAudioTime *nodeTime = player.lastRenderTime;
+        // CRASH GUARD (Sentry REACT-NATIVE-4G "required condition is false:
+        // nodeTime == nil || nodeTime.sampleTimeValid || nodeTime.hostTimeValid"):
+        // playerTimeForNodeTime ASSERTS when the node time is invalid — which it is
+        // whenever the player/engine isn't actually running (e.g. inject started
+        // while the custom device was inert). Only query a VALID node time.
+        if (nodeTime != nil && (nodeTime.isSampleTimeValid || nodeTime.isHostTimeValid)) {
+            AVAudioTime *playerTime = [player playerTimeForNodeTime:nodeTime];
+            if (playerTime != nil && playerTime.sampleRate > 0) {
+                positionMs = ((double)playerTime.sampleTime / playerTime.sampleRate) * 1000.0;
+                if (positionMs < 0.0) positionMs = 0.0;
+            }
+        }
+    } @catch (NSException *exception) {
+        // Player isn't in a renderable state — skip this tick, never crash.
+        positionMs = 0.0;
+    }
+
+    [self reportStatus:positionMs duration:self.currentDurationMs ended:NO];
+}
+
+- (void)handlePlaybackEnded {
+    [self stopStatusTimer];
+    // Natural end of the injected file: stop attributing captured frames to it,
+    // so injectFramesToCapture reflects the transmit window and nothing else.
+    if (self.capturingContext) { self.capturingContext->injectActive = 0; }
+    [self reportStatus:self.currentDurationMs duration:self.currentDurationMs ended:YES];
+}
+
+- (void)reportStatus:(double)positionMs duration:(double)durationMs ended:(BOOL)ended {
+    void (^block)(double, double, BOOL) = self.onStatus;
+    if (block == nil) {
+        return;
+    }
+    dispatch_async(dispatch_get_main_queue(), ^{
+        // Re-read in case it was cleared between the dispatch enqueue and execution.
+        void (^current)(double, double, BOOL) = self.onStatus;
+        if (current) {
+            current(positionMs, durationMs, ended);
+        }
+    });
+}
+
+- (void)attachMusicNodeToEngine:(AVAudioEngine *)engine {
+    if (!engine) {
+        NSLog(@"Cannot play music. AudioEngine has not been created yet.");
+        return;
+    }
+
+    AVAudioPlayerNode *player = nil;
+    AVAudioUnitReverb *reverb = nil;
+
+    BOOL isPlayoutEngine = [self.playoutEngine isEqual:engine];
+
+    /*
+     * Attach an AVAudioPlayerNode as an input to the main mixer.
+     * AVAudioPlayerNode -> AVAudioUnitReverb -> MainMixerNode -> Core Audio
+     *
+     * ATTO note: the example connected the nodes using a bundled `mixLoop.caf`'s
+     * processingFormat. Since we no longer ship a bundled file and inject arbitrary
+     * files at runtime, connect the player graph using the engine's own render
+     * format (the active 48kHz mono TVOAudioFormat). scheduleFile: then converts
+     * each source buffer to the player node's output format, so there is no pitch/
+     * speed artifact regardless of the source file's sample rate or channel count.
+     */
+    /*
+     * THE crash fix (Sentry REACT-NATIVE-4C — crashed builds 64-66 the first time
+     * `sharedDevice` was touched: the mixer metronome toggle, or the injection
+     * install). `activeFormat` is Twilio's 16-bit INTEGER PCM TVOAudioFormat.
+     * AVAudioPlayerNode and AVAudioUnitReverb are FLOAT-only processing nodes —
+     * connecting them with an int format makes [engine connect:...] throw
+     * "[busArray ... setFormat:] returned false". (The main mixer converts the int
+     * input at line 581; effect/player buses do NOT.) Connect the music graph with
+     * a STANDARD deinterleaved float format at the active sample rate — the mixer
+     * converts to the int render format on the way out.
+     */
+    double musicSampleRate = [self engineTargetFormat].sampleRate; // match engines, not raw session
+    if (musicSampleRate <= 0) {
+        musicSampleRate = (double)kPreferredSampleRate;
+    }
+    // MONO, not stereo. The main mixer downmixes to the mono render layout anyway,
+    // so every buffer converted through this graph was carrying a second channel
+    // that got summed away immediately — doubling the memory and the conversion
+    // work of every injected buffer for no audible difference. The call uplink is
+    // mono end to end, so there is nothing a stereo stage could preserve.
+    // The FLOAT part is load-bearing and must not change: connecting these
+    // float-only nodes with Twilio's 16-bit INT format is what crashed builds
+    // 64-66 (Sentry REACT-NATIVE-4C).
+    AVAudioFormat *format =
+        [[AVAudioFormat alloc] initStandardFormatWithSampleRate:musicSampleRate channels:1];
+
+    @try {
+        player = [[AVAudioPlayerNode alloc] init];
+        reverb = [[AVAudioUnitReverb alloc] init];
+
+        [reverb loadFactoryPreset:AVAudioUnitReverbPresetMediumHall];
+        // Dry: injected app audio / metronome must not pick up a concert-hall tail.
+        reverb.wetDryMix = 0;
+
+        [engine attachNode:player];
+        [engine attachNode:reverb];
+        [engine connect:player to:reverb format:format];
+        [engine connect:reverb to:engine.mainMixerNode format:format];
+
+        if (isPlayoutEngine) {
+            self.playoutReverb = reverb;
+            self.playoutFilePlayer = player;
+        } else {
+            self.recordReverb = reverb;
+            self.recordFilePlayer = player;
+        }
+    } @catch (NSException *exception) {
+        /*
+         * Last-resort safety net: a music-node setup failure must NEVER crash the
+         * app. If the graph won't connect, injection + metronome are disabled but
+         * the live call and the rest of the app keep working. NSLogged so it still
+         * shows in device logs; JS detects the dead injection path separately.
+         */
+        NSLog(@"[AttoAudioEngine] music node setup FAILED: %@ (%@) — injection/metronome disabled, call audio unaffected",
+              exception.name, exception.reason);
+        @try {
+            if (player) { [engine detachNode:player]; }
+            if (reverb) { [engine detachNode:reverb]; }
+        } @catch (NSException *ignored) {
+        }
+    }
+}
+
+- (void)teardownPlayer {
+    if (self.recordFilePlayer) {
+        if (self.recordFilePlayer.isPlaying) {
+            [self.recordFilePlayer stop];
+        }
+        [self.recordEngine detachNode:self.recordFilePlayer];
+        [self.recordEngine detachNode:self.recordReverb];
+        self.recordReverb = nil;
+    }
+
+    if (self.playoutFilePlayer) {
+        if (self.playoutFilePlayer.isPlaying) {
+            [self.playoutFilePlayer stop];
+        }
+        [self.playoutEngine detachNode:self.playoutFilePlayer];
+        [self.playoutEngine detachNode:self.playoutReverb];
+        self.playoutReverb = nil;
+    }
+}
+
+#pragma mark - TVOAudioDeviceRenderer
+
+- (nullable TVOAudioFormat *)renderFormat {
+    if (!_renderingFormat) {
+
+        /*
+         * Assume that the AVAudioSession has already been configured and started and that the values
+         * for sampleRate and IOBufferDuration are final.
+         */
+        _renderingFormat = [[self class] activeFormat];
+        self.renderingContext->maxFramesPerBuffer = _renderingFormat.framesPerBuffer;
+    }
+
+    return _renderingFormat;
+}
+
+- (BOOL)initializeRenderer {
+    /*
+     * In this example we don't need any fixed size buffers or other pre-allocated resources. We will simply write
+     * directly to the AudioBufferList provided in the AudioUnit's rendering callback.
+     */
+    return YES;
+}
+
+- (BOOL)startRendering:(nonnull TVOAudioDeviceContext)context {
+    @synchronized(self) {
+        _dbgStartRenderingCount++; // telemetry: proves Twilio is driving this device
+
+        // ATTO (Aug 3 2026): pay off any route change that was dropped while the
+        // AudioUnit was NULL (see handleValidRouteChange). We are about to
+        // re-activate the session, so this is the right place to take a fresh look
+        // at the format instead of staying pinned to whatever was latched before
+        // the route moved.
+        const BOOL pendingRecheck = [self consumePendingFormatRecheck];
+
+        // ATTO (build 82): align the manual-render engine format to the LIVE call
+        // rate before wiring the AudioUnit (see ensureEngineFormatForActiveSession).
+        [self ensureEngineFormatForActiveSession];
+
+        // ATTO (Aug 3 2026): ensureEngineFormatForActiveSession is what ACTIVATES
+        // the session, so the live rate can only be trusted after it has run. If it
+        // no longer matches what Twilio latched when it queried renderFormat, say so
+        // (always) and correct it (cohort only).
+        [self realignFormatsIfSessionRateFlipped:
+            (pendingRecheck ? @"startRendering+droppedRouteChange" : @"startRendering")];
+
+        /*
+         * In this example, the app always publishes an audio track. So we will start the audio unit from the capturer
+         * call backs. We will restart the audio unit if a remote participant adds an audio track after the audio graph is
+         * established. Also we will re-establish the audio graph in case the format changes.
+         */
+        // ATTO (build 92): tear down ANY existing unit, regardless of _enabled.
+        // With _enabled=NO real (CallKit sets it at answer), the old `&& _enabled`
+        // guard skipped this and setupAudioUnit OVERWROTE a LIVE unit -> two units
+        // double-pulled the manual render (injected file played ~2x fast + garbled)
+        // and the leaked units made hang-up teardown deadlock-prone.
+        if (_audioUnit) {
+            [self stopAudioUnit];
+            [self teardownAudioUnit];
+        }
+
+        // We will make sure AVAudioEngine and AVAudioPlayerNode is accessed on the main queue.
+        dispatch_async(dispatch_get_main_queue(), ^{
+            if (self.playoutFilePlayer.isPlaying) {
+                [self.playoutFilePlayer stop];
+            }
+            if (self.playoutEngine.isRunning) {
+                [self.playoutEngine stop];
+            }
+
+            NSError *error = nil;
+            if (![self.playoutEngine startAndReturnError:&error]) {
+                NSLog(@"Failed to start AVAudioEngine, error = %@", error);
+            }
+        });
+
+        self.renderingContext->deviceContext = context;
+
+        if (![self setupAudioUnitWithRenderContext:self.renderingContext
+                                    captureContext:self.capturingContext]) {
+            return NO;
+        }
+        BOOL success = [self startAudioUnit];
+        return success;
+    }
+}
+
+- (BOOL)stopRendering {
+    @synchronized(self) {
+        // If the capturer is running, we will not stop the audio unit.
+        if (!self.capturingContext->deviceContext) {
+
+            // We will make sure AVAudioEngine and AVAudioPlayerNode is accessed on the main queue.
+            dispatch_async(dispatch_get_main_queue(), ^{
+                if (self.playoutFilePlayer.isPlaying) {
+                    [self.playoutFilePlayer stop];
+                }
+                if (self.playoutEngine.isRunning) {
+                    [self.playoutEngine stop];
+                }
+            });
+
+            // ATTO (build 92): key on the unit's existence, not _enabled — a call
+            // ending after didDeactivate (enabled=NO) must still tear down.
+            if (_audioUnit) {
+                [self stopAudioUnit];
+                [self teardownAudioUnit];
+            }
+        }
+
+        self.renderingContext->deviceContext = NULL;
+
+        /*
+         * ATTO (Aug 3 2026): the format-re-align allowance is deliberately NOT reset
+         * here. A re-align is what makes the media engine stop and restart both
+         * halves (TVOAudioDevice.h documents that TVOAudioDeviceFormatChanged causes
+         * exactly this stop -> start cycle), so resetting on a stop would hand the
+         * following start hook a fresh allowance and let one route flip cycle the
+         * AudioUnit and both engines indefinitely — a hard audio dropout each time,
+         * which is the very symptom this work exists to remove. The allowance is
+         * keyed on the device context instead; see realignFormatsIfSessionRateFlipped.
+         */
+    }
+
+    return YES;
+}
+
+#pragma mark - TVOAudioDeviceCapturer
+
+- (nullable TVOAudioFormat *)captureFormat {
+    if (!_capturingFormat) {
+
+        /*
+         * Assume that the AVAudioSession has already been configured and started and that the values
+         * for sampleRate and IOBufferDuration are final.
+         */
+        _capturingFormat = [[self class] activeFormat];
+    }
+
+    return _capturingFormat;
+}
+
+- (BOOL)initializeCapturer {
+    _captureBufferList.mNumberBuffers = 1;
+    _captureBufferList.mBuffers[0].mNumberChannels = kPreferredNumberOfChannels;
+
+    AudioBufferList *mixedAudioBufferList = self.capturingContext->mixedAudioBufferList;
+    if (mixedAudioBufferList == NULL) {
+        mixedAudioBufferList = (AudioBufferList*)malloc(sizeof(AudioBufferList));
+        mixedAudioBufferList->mNumberBuffers = 1;
+        mixedAudioBufferList->mBuffers[0].mNumberChannels = kPreferredNumberOfChannels;
+        mixedAudioBufferList->mBuffers[0].mDataByteSize = 0;
+        mixedAudioBufferList->mBuffers[0].mData = malloc(kMaximumFramesPerBuffer * kPreferredNumberOfChannels * kAudioSampleSize);
+
+        self.capturingContext->mixedAudioBufferList = mixedAudioBufferList;
+    }
+
+    return YES;
+}
+
+- (BOOL)startCapturing:(nonnull TVOAudioDeviceContext)context {
+    @synchronized (self) {
+        _dbgStartCapturingCount++; // telemetry: proves Twilio is driving this device
+
+        // ATTO (Aug 3 2026): consume a route change that was dropped while the
+        // AudioUnit was NULL (see handleValidRouteChange), so it stops vanishing.
+        const BOOL pendingRecheck = [self consumePendingFormatRecheck];
+
+        // ATTO (build 82): align the manual-render engine format to the LIVE call
+        // rate BEFORE wiring the AudioUnit, or a frozen -init format kills two-way
+        // audio and can crash. No-op when already aligned.
+        [self ensureEngineFormatForActiveSession];
+
+        // ATTO (Aug 3 2026): the session is only activated inside the call above, so
+        // compare the live format against Twilio's latched one now. Counted always,
+        // corrected only for the cohort flag.
+        [self realignFormatsIfSessionRateFlipped:
+            (pendingRecheck ? @"startCapturing+droppedRouteChange" : @"startCapturing")];
+
+        // Restart the audio unit if the audio graph is already setup and if we publish an audio track.
+        // ATTO (build 92): tear down ANY existing unit, regardless of _enabled.
+        // With _enabled=NO real (CallKit sets it at answer), the old `&& _enabled`
+        // guard skipped this and setupAudioUnit OVERWROTE a LIVE unit -> two units
+        // double-pulled the manual render (injected file played ~2x fast + garbled)
+        // and the leaked units made hang-up teardown deadlock-prone.
+        if (_audioUnit) {
+            [self stopAudioUnit];
+            [self teardownAudioUnit];
+        }
+
+        // We will make sure AVAudioEngine and AVAudioPlayerNode is accessed on the main queue.
+        dispatch_async(dispatch_get_main_queue(), ^{
+            if (self.recordFilePlayer.isPlaying) {
+                [self.recordFilePlayer stop];
+            }
+            if (self.recordEngine.isRunning) {
+                [self.recordEngine stop];
+            }
+
+            NSError *error = nil;
+            if (![self.recordEngine startAndReturnError:&error]) {
+                NSLog(@"Failed to start AVAudioEngine, error = %@", error);
+            }
+        });
+
+        self.capturingContext->deviceContext = context;
+
+        if (![self setupAudioUnitWithRenderContext:self.renderingContext
+                                    captureContext:self.capturingContext]) {
+            return NO;
+        }
+
+        BOOL success = [self startAudioUnit];
+        return success;
+    }
+}
+
+- (BOOL)stopCapturing {
+    @synchronized(self) {
+        // If the renderer is running, we will not stop the audio unit.
+        if (!self.renderingContext->deviceContext) {
+
+            // We will make sure AVAudioEngine and AVAudioPlayerNode is accessed on the main queue.
+            dispatch_async(dispatch_get_main_queue(), ^{
+                if (self.recordFilePlayer.isPlaying) {
+                    [self.recordFilePlayer stop];
+                }
+                if (self.recordEngine.isRunning) {
+                    [self.recordEngine stop];
+                }
+            });
+
+            // ATTO (build 92): key on the unit's existence, not _enabled — a call
+            // ending after didDeactivate (enabled=NO) must still tear down.
+            if (_audioUnit) {
+                [self stopAudioUnit];
+                [self teardownAudioUnit];
+            }
+        }
+
+        self.capturingContext->deviceContext = NULL;
+
+        // ATTO (Aug 3 2026): mirror of stopRendering — no re-align reset here either.
+        // See the note there for why a stop hook is the one place that must never
+        // re-arm it.
+    }
+
+    return YES;
+}
+
+#pragma mark - Private (AudioUnit callbacks)
+
+static OSStatus AttoAudioEngineDevicePlayoutCallback(void *refCon,
+                                                     AudioUnitRenderActionFlags *actionFlags,
+                                                     const AudioTimeStamp *timestamp,
+                                                     UInt32 busNumber,
+                                                     UInt32 numFrames,
+                                                     AudioBufferList *bufferList) NS_AVAILABLE(NA, 11_0) {
+    AudioRendererContext *context = (AudioRendererContext *)refCon;
+
+    // ATTO (build 101) — RT-SAFE GUARD. Fixes EXC_BAD_ACCESS at 0x8 in _Block_copy
+    // (Sentry REACT-NATIVE-4Q, westcol answer): on CallKit answer the audio ROUTE
+    // changes → handleValidRouteChange → ensureEngineFormatForActiveSession →
+    // teardownAudioEngine nils _playoutEngine, releasing its manualRenderingBlock,
+    // WHILE the VoiceProcessingIO unit is still rendering. The old renderBlock was
+    // then NULL/dangling and the ARC strong-assign below did _Block_copy on it and
+    // crashed. Mirror the record callback's deviceContext guard + also require a
+    // live renderBlock; render silence in the teardown/rebuild window. renderBlock
+    // is NULLed FIRST in teardownAudioEngine so we see NULL here, not a dangling ptr.
+    if (context == NULL || context->deviceContext == NULL || context->renderBlock == NULL) {
+        if (bufferList != NULL && bufferList->mNumberBuffers > 0 &&
+            bufferList->mBuffers[0].mData != NULL) {
+            *actionFlags |= kAudioUnitRenderAction_OutputIsSilence;
+            memset(bufferList->mBuffers[0].mData, 0, bufferList->mBuffers[0].mDataByteSize);
+        }
+        return noErr;
+    }
+
+    assert(bufferList->mNumberBuffers == 1);
+    assert(bufferList->mBuffers[0].mNumberChannels <= 2);
+    assert(bufferList->mBuffers[0].mNumberChannels > 0);
+
+    context->bufferList = bufferList;
+    context->cbCount++; // telemetry: proves the custom device is the active one
+
+    int8_t *audioBuffer = (int8_t *)bufferList->mBuffers[0].mData;
+    UInt32 audioBufferSizeInBytes = bufferList->mBuffers[0].mDataByteSize;
+
+    // Pull decoded, mixed audio data from the media engine into the AudioUnit's AudioBufferList.
+    assert(audioBufferSizeInBytes == (bufferList->mBuffers[0].mNumberChannels * kAudioSampleSize * numFrames));
+    OSStatus outputStatus = noErr;
+
+    // Get the mixed audio data from AVAudioEngine's output node by calling the `renderBlock`.
+    // __unsafe_unretained → NO ARC objc_retainBlock/_Block_copy on the RT thread (that
+    // copy on a stale pointer WAS the crash). We already null-guarded it above.
+    __unsafe_unretained AVAudioEngineManualRenderingBlock renderBlock =
+        (__bridge AVAudioEngineManualRenderingBlock)(context->renderBlock);
+    const AVAudioEngineManualRenderingStatus status = renderBlock(numFrames, bufferList, &outputStatus);
+
+    /*
+     * Render silence if there are temporary mismatches between CoreAudio and our rendering format or AVAudioEngine
+     * could not render the audio samples.
+     */
+    if (numFrames > context->maxFramesPerBuffer || status != AVAudioEngineManualRenderingStatusSuccess) {
+        if (numFrames > context->maxFramesPerBuffer) {
+            NSLog(@"Can handle a max of %u frames but got %u.", (unsigned int)context->maxFramesPerBuffer, (unsigned int)numFrames);
+        }
+        *actionFlags |= kAudioUnitRenderAction_OutputIsSilence;
+        memset(audioBuffer, 0, audioBufferSizeInBytes);
+    }
+
+    return noErr;
+}
+
+static OSStatus AttoAudioEngineDeviceRecordCallback(void *refCon,
+                                                    AudioUnitRenderActionFlags *actionFlags,
+                                                    const AudioTimeStamp *timestamp,
+                                                    UInt32 busNumber,
+                                                    UInt32 numFrames,
+                                                    AudioBufferList *bufferList) NS_AVAILABLE(NA, 11_0) {
+
+    if (numFrames > kMaximumFramesPerBuffer) {
+        NSLog(@"Expected %u frames but got %u.", (unsigned int)kMaximumFramesPerBuffer, (unsigned int)numFrames);
+        return noErr;
+    }
+
+    AudioCapturerContext *context = (AudioCapturerContext *)refCon;
+    context->cbCount++; // telemetry: proves the custom device is the active one
+
+    if (context->deviceContext == NULL) {
+        return noErr;
+    }
+
+    AudioBufferList *audioBufferList = context->bufferList;
+    audioBufferList->mBuffers[0].mDataByteSize = numFrames * sizeof(UInt16) * kPreferredNumberOfChannels;
+    // The buffer will be filled by VoiceProcessingIO AudioUnit
+    audioBufferList->mBuffers[0].mData = NULL;
+
+    OSStatus status = noErr;
+    status = AudioUnitRender(context->audioUnit,
+                             actionFlags,
+                             timestamp,
+                             1,
+                             numFrames,
+                             audioBufferList);
+
+    AudioBufferList *mixedAudioBufferList = context->mixedAudioBufferList;
+    assert(mixedAudioBufferList != NULL);
+    assert(mixedAudioBufferList->mNumberBuffers == audioBufferList->mNumberBuffers);
+    for(int i = 0; i < audioBufferList->mNumberBuffers; i++) {
+        mixedAudioBufferList->mBuffers[i].mNumberChannels = audioBufferList->mBuffers[i].mNumberChannels;
+        mixedAudioBufferList->mBuffers[i].mDataByteSize = audioBufferList->mBuffers[i].mDataByteSize;
+    }
+
+    // ATTO (build 101): same RT-safe renderBlock guard as the playout callback —
+    // the engine can be torn down/rebuilt (route change on answer) while this RT
+    // record callback runs, leaving renderBlock NULL/stale. deviceContext is
+    // already checked at the top; also require a live block, and invoke it
+    // __unsafe_unretained so ARC never does _Block_copy on a stale pointer.
+    if (context->renderBlock == NULL) {
+        return noErr;
+    }
+    OSStatus outputStatus = noErr;
+    __unsafe_unretained AVAudioEngineManualRenderingBlock renderBlock =
+        (__bridge AVAudioEngineManualRenderingBlock)(context->renderBlock);
+    const AVAudioEngineManualRenderingStatus ret = renderBlock(numFrames, mixedAudioBufferList, &outputStatus);
+
+    int8_t *audioBuffer;
+    UInt32 audioBufferSizeInBytes;
+    if (ret == AVAudioEngineManualRenderingStatusSuccess && status == noErr) {
+        // Mix rendered OK — send the mixed (mic [+ injected]) buffer as before.
+        audioBuffer = (int8_t *)mixedAudioBufferList->mBuffers[0].mData;
+        audioBufferSizeInBytes = mixedAudioBufferList->mBuffers[0].mDataByteSize;
+        // The counter we never had: frames that actually reached Twilio while an
+        // injection was live. Distinguishes "we scheduled it" from "the far party
+        // received it" — the exact gap behind "she couldn't hear the track".
+        if (context->injectActive) {
+            context->injectFramesToCapture += numFrames;
+        }
+    } else {
+        // SILENCE GUARD (mother test: "no te escucho", dead BOTH ways from a
+        // CallKit/background answer): the manual mix render (or the mic
+        // AudioUnitRender) FAILED — e.g. the engine's manual-rendering format is
+        // pinned to the wrong sample rate after the idle feed preinstall, so every
+        // callback fails and mixedAudioBufferList is stale garbage. Writing that to
+        // Twilio makes the remote hear silence. Fall back to the RAW MIC that
+        // AudioUnitRender just produced (same int16 mono format WriteCaptureData
+        // expects) so two-way audio SURVIVES even when the engine can't mix. This
+        // mirrors the failure guard PlayoutCallback already has. Count it — surfaced
+        // in mixDiagnostics.renderFailCount — but do NOT NSLog here: this runs on the
+        // CoreAudio real-time render thread, and NSLog takes a lock + does a syscall,
+        // which can xrun the very fallback that must keep the call intelligible. The
+        // counter (read on the main thread in mixDiagnostics) is the signal instead.
+        context->renderFailCount++;
+        // Split the cause. CannotDoInCurrentContext = a node property was written
+        // while rendering (graph mutated from a non-RT thread); anything else = the
+        // engine genuinely could not mix. Only the second is the dead-audio class,
+        // and only the first tells us a live control surface is unsafe here.
+        if (ret == AVAudioEngineManualRenderingStatusCannotDoInCurrentContext) {
+            context->renderFailCannotDoInContext++;
+        } else {
+            context->renderFailOther++;
+        }
+        audioBuffer = (status == noErr) ? (int8_t *)audioBufferList->mBuffers[0].mData : NULL;
+        audioBufferSizeInBytes = audioBufferList->mBuffers[0].mDataByteSize;
+    }
+
+    // === ATTO mixer MIC tap (additive; live path unchanged) ===
+    /*
+     * Feed the mic ring from the RAW MIC, never from the outgoing mix.
+     *
+     * THE BUG THIS FIXES (Aug 3 2026). This used to copy `audioBuffer`, which on
+     * the success branch is `mixedAudioBufferList` — the post-mix uplink, i.e. the
+     * microphone PLUS whatever we injected into the call. So the "mic" channel of
+     * every take already contained the backing track the user was singing over,
+     * byte-identical to what the server-side Twilio fork records. Turning the App
+     * channel off did nothing about it, because that flag only gates `_appRing`,
+     * which is a separate tap. The whole point of recording through the mixer —
+     * a clean overdub that layers onto the project instead of doubling the track
+     * — did not work, and could not have.
+     *
+     * `audioBufferList` is what AudioUnitRender just produced: the microphone
+     * after VoiceProcessingIO (so echo-cancelled and noise-suppressed) but BEFORE
+     * the record engine sums the injected music in. That is the signal a take
+     * actually wants.
+     *
+     * This is genuinely clean even on speakerphone: the injected music is also
+     * attached to the PLAYOUT engine, so it is present in the VPIO echo-cancel
+     * reference and the acoustic leakage back through the mic is cancelled.
+     *
+     * Second bug fixed for free: because this no longer follows `audioBuffer`, the
+     * mic channel stops silently switching source mid-take when the manual render
+     * fails (measured at 24% of transmitting calls). The take is now one
+     * consistent signal from start to finish.
+     *
+     * memcpy + atomics only — real-time safe. `micRing` is NULL when not
+     * recording, so this is a no-op otherwise.
+     */
+    if (context->micRing && status == noErr && audioBufferList->mBuffers[0].mData) {
+        AttoPushInt16AsFloat(context->micRing,
+                             (const int16_t *)audioBufferList->mBuffers[0].mData,
+                             audioBufferList->mBuffers[0].mDataByteSize);
+    }
+    // === end ATTO mic tap ===
+
+    if (context->deviceContext && audioBuffer) {
+        TVOAudioDeviceWriteCaptureData(context->deviceContext, audioBuffer, audioBufferSizeInBytes);
+    }
+
+    return noErr;
+}
+
+#pragma mark - Private (AVAudioSession and CoreAudio)
+
++ (nullable TVOAudioFormat *)activeFormat {
+    /*
+     * Use the pre-determined maximum frame size. AudioUnit callbacks are variable, and in most situations will be close
+     * to the `AVAudioSession.preferredIOBufferDuration` that we've requested.
+     */
+    const size_t sessionFramesPerBuffer = kMaximumFramesPerBuffer;
+    double sessionSampleRate = [AVAudioSession sharedInstance].sampleRate;
+
+    // CRASH GUARD (Sentry REACT-NATIVE-4C): when the engine is initialized while
+    // the AVAudioSession is INACTIVE (e.g. sharedDevice is first touched outside a
+    // call, via restoreDefaultDevice on hang-up), sampleRate is 0 → an INVALID
+    // AVAudioFormat → [engine connect:...] throws
+    // "[busArray ... setFormat:] returned false". Fall back to the preferred rate
+    // so the node graph always connects with a valid format.
+    if (sessionSampleRate <= 0) {
+        sessionSampleRate = (double)kPreferredSampleRate;
+    }
+
+    return [[TVOAudioFormat alloc] initWithChannels:TVOAudioChannelsMono
+                                         sampleRate:sessionSampleRate
+                                    framesPerBuffer:sessionFramesPerBuffer];
+}
+
++ (AudioComponentDescription)audioUnitDescription {
+    AudioComponentDescription audioUnitDescription;
+    audioUnitDescription.componentType = kAudioUnitType_Output;
+    audioUnitDescription.componentSubType = kAudioUnitSubType_VoiceProcessingIO;
+    audioUnitDescription.componentManufacturer = kAudioUnitManufacturer_Apple;
+    audioUnitDescription.componentFlags = 0;
+    audioUnitDescription.componentFlagsMask = 0;
+    return audioUnitDescription;
+}
+
+- (void)setupAVAudioSession {
+    AVAudioSession *session = [AVAudioSession sharedInstance];
+    NSError *error = nil;
+
+    if (![session setPreferredSampleRate:kPreferredSampleRate error:&error]) {
+        NSLog(@"Error setting sample rate: %@", error);
+    }
+
+    if (![session setPreferredOutputNumberOfChannels:kPreferredNumberOfChannels error:&error]) {
+        NSLog(@"Error setting number of output channels: %@", error);
+    }
+
+    /*
+     * We want to be as close as possible to the 10 millisecond buffer size that the media engine needs. If there is
+     * a mismatch then TwilioVoice will ensure that appropriately sized audio buffers are delivered.
+     */
+    if (![session setPreferredIOBufferDuration:kPreferredIOBufferDuration error:&error]) {
+        NSLog(@"Error setting IOBuffer duration: %@", error);
+    }
+
+    // ATTO (build 145): options-preserving setCategory — bare variant strips
+    // AllowBluetoothHFP and evicts AirPods mid-call (echo). See ensureEngineFormat.
+    AVAudioSessionCategoryOptions attoOpts3 =
+        session.categoryOptions | AVAudioSessionCategoryOptionAllowBluetooth;
+    if (![session setCategory:AVAudioSessionCategoryPlayAndRecord withOptions:attoOpts3 error:&error]) {
+        NSLog(@"Error setting session category: %@", error);
+    }
+
+    if (![session setMode:AVAudioSessionModeVoiceChat error:&error]) {
+        NSLog(@"Error setting session category: %@", error);
+    }
+
+    [self registerAVAudioSessionObservers];
+
+    if (![session setActive:YES error:&error]) {
+        NSLog(@"Error activating AVAudioSession: %@", error);
+    }
+
+    if (session.maximumInputNumberOfChannels > 0) {
+        if (![session setPreferredInputNumberOfChannels:TVOAudioChannelsMono error:&error]) {
+            NSLog(@"Error setting number of input channels: %@", error);
+        }
+    }
+}
+
+- (BOOL)setupAudioUnitWithRenderContext:(AudioRendererContext *)renderContext
+                         captureContext:(AudioCapturerContext *)captureContext {
+
+    // Find and instantiate the VoiceProcessingIO audio unit.
+    AudioComponentDescription audioUnitDescription = [[self class] audioUnitDescription];
+    AudioComponent audioComponent = AudioComponentFindNext(NULL, &audioUnitDescription);
+
+    OSStatus status = AudioComponentInstanceNew(audioComponent, &_audioUnit);
+    if (status != 0) {
+        NSLog(@"Could not find VoiceProcessingIO AudioComponent instance!");
+        return NO;
+    }
+
+    /*
+     * Configure the VoiceProcessingIO audio unit. Our rendering format attempts to match what AVAudioSession requires
+     * to prevent any additional format conversions after the media engine has mixed our playout audio.
+     */
+    AudioStreamBasicDescription streamDescription = self.renderingFormat.streamDescription;
+
+    UInt32 enableOutput = 1;
+    status = AudioUnitSetProperty(_audioUnit, kAudioOutputUnitProperty_EnableIO,
+                                  kAudioUnitScope_Output, kOutputBus,
+                                  &enableOutput, sizeof(enableOutput));
+    if (status != 0) {
+        NSLog(@"Could not enable out bus!");
+        AudioComponentInstanceDispose(_audioUnit);
+        _audioUnit = NULL;
+        return NO;
+    }
+
+    status = AudioUnitSetProperty(_audioUnit, kAudioUnitProperty_StreamFormat,
+                                  kAudioUnitScope_Output, kInputBus,
+                                  &streamDescription, sizeof(streamDescription));
+    if (status != 0) {
+        NSLog(@"Could not set stream format on input bus!");
+        return NO;
+    }
+
+    status = AudioUnitSetProperty(_audioUnit, kAudioUnitProperty_StreamFormat,
+                                  kAudioUnitScope_Input, kOutputBus,
+                                  &streamDescription, sizeof(streamDescription));
+    if (status != 0) {
+        NSLog(@"Could not set stream format on output bus!");
+        return NO;
+    }
+
+    // Enable the microphone input
+    UInt32 enableInput = 1;
+    status = AudioUnitSetProperty(_audioUnit, kAudioOutputUnitProperty_EnableIO,
+                                  kAudioUnitScope_Input, kInputBus, &enableInput,
+                                  sizeof(enableInput));
+
+    if (status != 0) {
+        NSLog(@"Could not enable input bus!");
+        AudioComponentInstanceDispose(_audioUnit);
+        _audioUnit = NULL;
+        return NO;
+    }
+
+    // Setup the rendering callback.
+    AURenderCallbackStruct renderCallback;
+    renderCallback.inputProc = AttoAudioEngineDevicePlayoutCallback;
+    renderCallback.inputProcRefCon = (void *)(renderContext);
+    status = AudioUnitSetProperty(_audioUnit, kAudioUnitProperty_SetRenderCallback,
+                                  kAudioUnitScope_Output, kOutputBus, &renderCallback,
+                                  sizeof(renderCallback));
+    if (status != 0) {
+        NSLog(@"Could not set rendering callback!");
+        AudioComponentInstanceDispose(_audioUnit);
+        _audioUnit = NULL;
+        return NO;
+    }
+
+    // Setup the capturing callback.
+    AURenderCallbackStruct captureCallback;
+    captureCallback.inputProc = AttoAudioEngineDeviceRecordCallback;
+    captureCallback.inputProcRefCon = (void *)(captureContext);
+    status = AudioUnitSetProperty(_audioUnit, kAudioOutputUnitProperty_SetInputCallback,
+                                  kAudioUnitScope_Input, kInputBus, &captureCallback,
+                                  sizeof(captureCallback));
+    if (status != 0) {
+        NSLog(@"Could not set capturing callback!");
+        AudioComponentInstanceDispose(_audioUnit);
+        _audioUnit = NULL;
+        return NO;
+    }
+
+    NSInteger failedInitializeAttempts = 0;
+    while (status != noErr) {
+        NSLog(@"Failed to initialize the Voice Processing I/O unit. Error= %ld.", (long)status);
+        ++failedInitializeAttempts;
+        if (failedInitializeAttempts == kMaxNumberOfAudioUnitInitializeAttempts) {
+            break;
+        }
+        NSLog(@"Pause 100ms and try audio unit initialization again.");
+        [NSThread sleepForTimeInterval:0.1f];
+        status = AudioUnitInitialize(_audioUnit);
+    }
+
+    // Finally, initialize and start the VoiceProcessingIO audio unit.
+    if (status != 0) {
+        NSLog(@"Could not initialize the audio unit!");
+        AudioComponentInstanceDispose(_audioUnit);
+        _audioUnit = NULL;
+        return NO;
+    }
+
+    captureContext->audioUnit = _audioUnit;
+
+    return YES;
+}
+
+- (BOOL)startAudioUnit {
+    _dbgAudioUnitStartCount++; // telemetry
+    OSStatus status = AudioOutputUnitStart(_audioUnit);
+    if (status != 0) {
+        NSLog(@"Could not start the audio unit!");
+        return NO;
+    }
+    /*
+     * ATTO (Aug 3 2026): a route change that landed while _audioUnit was NULL was
+     * discarded by handleValidRouteChange. There is a unit again now, so this is the
+     * first moment the debt can be paid. startRendering:/startCapturing: consume it
+     * before they get here, so in practice this only fires on the paths that restart
+     * the unit WITHOUT going through a start hook: setEnabled:YES at CallKit
+     * didActivate, interruption-ended, and media-services-restored. Those are exactly
+     * the moments a Bluetooth profile handoff tends to fire route changes.
+     */
+    if ([self consumePendingFormatRecheck]) {
+        [self realignFormatsIfSessionRateFlipped:@"startAudioUnit+droppedRouteChange"];
+    }
+    return YES;
+}
+
+- (BOOL)stopAudioUnit {
+    _dbgAudioUnitStopCount++; // telemetry: an explicit stop (not starvation)
+    OSStatus status = AudioOutputUnitStop(_audioUnit);
+    if (status != 0) {
+        NSLog(@"Could not stop the audio unit!");
+        return NO;
+    }
+    return YES;
+}
+
+- (void)teardownAudioUnit {
+    if (_audioUnit) {
+        _dbgTeardownAudioUnitCount++; // telemetry
+        AudioUnitUninitialize(_audioUnit);
+        AudioComponentInstanceDispose(_audioUnit);
+        _audioUnit = NULL;
+    }
+}
+
+#pragma mark - NSNotification Observers
+
+- (TVOAudioDeviceContext)deviceContext {
+    if (self.renderingContext->deviceContext) {
+        return self.renderingContext->deviceContext;
+    } else if (self.capturingContext->deviceContext) {
+        return self.capturingContext->deviceContext;
+    }
+    return NULL;
+}
+
+- (void)registerAVAudioSessionObservers {
+    // An audio device that interacts with AVAudioSession should handle events like interruptions and route changes.
+    NSNotificationCenter *center = [NSNotificationCenter defaultCenter];
+
+    [center addObserver:self selector:@selector(handleAudioInterruption:) name:AVAudioSessionInterruptionNotification object:nil];
+    [center addObserver:self selector:@selector(handleRouteChange:) name:AVAudioSessionRouteChangeNotification object:nil];
+    [center addObserver:self selector:@selector(handleMediaServiceLost:) name:AVAudioSessionMediaServicesWereLostNotification object:nil];
+    [center addObserver:self selector:@selector(handleMediaServiceRestored:) name:AVAudioSessionMediaServicesWereResetNotification object:nil];
+}
+
+- (void)handleAudioInterruption:(NSNotification *)notification {
+    AVAudioSessionInterruptionType type = [notification.userInfo[AVAudioSessionInterruptionTypeKey] unsignedIntegerValue];
+
+    @synchronized(self) {
+        // If the worker block is executed, then context is guaranteed to be valid.
+        TVOAudioDeviceContext context = [self deviceContext];
+        if (context) {
+            TVOAudioDeviceExecuteWorkerBlock(context, ^{
+                if (type == AVAudioSessionInterruptionTypeBegan) {
+                    NSLog(@"Interruption began.");
+                    _dbgInterruptionBeganCount++; // telemetry
+                    self.interrupted = YES;
+                    [self stopAudioUnit];
+                } else {
+                    NSLog(@"Interruption ended.");
+                    self.interrupted = NO;
+                    [self startAudioUnit];
+                    /*
+                     * VERIFY THE RESUME ACTUALLY PUMPED.
+                     *
+                     * startAudioUnit succeeding does not mean audio is flowing. On
+                     * iOS 18.4-18.7 there is a documented case where, after a
+                     * phone-call interruption, the unit reports running and the
+                     * render callbacks never fire again; our own b88 starvation
+                     * counters exist because we hit that signature. Silently
+                     * assuming success leaves the call dead both ways and any
+                     * in-flight take truncated, with nothing reporting it.
+                     *
+                     * So: snapshot the capture callback count, look again shortly
+                     * after, and if it has not advanced, escalate through the SAME
+                     * proven path a route change uses (clear the cached formats and
+                     * let Twilio drive a rebuild via TVOAudioDeviceFormatChanged)
+                     * rather than sitting in silent starvation.
+                     *
+                     * Bounded by construction: this can only act when audio is
+                     * ALREADY dead, so the worst case of a false positive is one
+                     * rebuild we would have needed anyway. dispatch_after runs off
+                     * the real-time thread.
+                     */
+                    const uint64_t cbAtResume =
+                        self.capturingContext ? self.capturingContext->cbCount : 0;
+                    __weak typeof(self) weakSelf = self;
+                    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.6 * NSEC_PER_SEC)),
+                                   dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+                        __strong typeof(weakSelf) strongSelf = weakSelf;
+                        if (!strongSelf || strongSelf.isInterrupted) return;
+                        if (strongSelf->_audioUnit == NULL) return;
+                        const uint64_t cbNow =
+                            strongSelf.capturingContext ? strongSelf.capturingContext->cbCount : 0;
+                        if (cbNow > cbAtResume) return; // healthy resume, nothing to do
+                        strongSelf->_dbgResumeStarvedCount++;
+                        NSLog(@"[AttoAudioEngineDevice] resume starved (cb frozen at %llu); forcing rebuild",
+                              (unsigned long long)cbNow);
+                        // ATTO (Aug 3 2026): clear the formats INSIDE the lock, like
+                        // every other writer of these ARC strong ivars now does. They
+                        // are read (and therefore retained) from the media engine's
+                        // threads, so an unlocked release here can race a retain.
+                        @synchronized(strongSelf) {
+                            strongSelf->_renderingFormat = nil;
+                            strongSelf->_capturingFormat = nil;
+                            TVOAudioDeviceContext ctx = [strongSelf deviceContext];
+                            if (ctx) {
+                                TVOAudioDeviceFormatChanged(ctx);
+                            }
+                        }
+                    });
+                }
+            });
+        }
+    }
+}
+
+- (void)handleApplicationDidBecomeActive:(NSNotification *)notification {
+    @synchronized(self) {
+        // If the worker block is executed, then context is guaranteed to be valid.
+        TVOAudioDeviceContext context = [self deviceContext];
+        if (context) {
+            TVOAudioDeviceExecuteWorkerBlock(context, ^{
+                if (self.isInterrupted) {
+                    NSLog(@"Synthesizing an interruption ended event for iOS 9.x devices.");
+                    self.interrupted = NO;
+                    [self startAudioUnit];
+                }
+            });
+        }
+    }
+}
+
+- (void)handleRouteChange:(NSNotification *)notification {
+    // Check if the sample rate, or channels changed and trigger a format change if it did.
+    AVAudioSessionRouteChangeReason reason = [notification.userInfo[AVAudioSessionRouteChangeReasonKey] unsignedIntegerValue];
+
+    /*
+     * ATTO (Aug 3 2026) — KEEP THE REASON. This is pure instrumentation and ships to
+     * everyone.
+     *
+     * iOS tells us WHY the route moved and, until now, this method read that value
+     * and dropped it. That single field is the difference between "iOS re-routed on
+     * its own during the A2DP to HFP handoff" (NewDeviceAvailable,
+     * RouteConfigurationChange), "the user physically pulled the AirPods out"
+     * (OldDeviceUnavailable) and "our own app did it" (CategoryChange, Override).
+     * Without it every route transition in the AirPods incident was ambiguous, and
+     * the timeline had to be reconstructed from the client's remedial actions.
+     *
+     * Plain scalar writes under the device's existing lock, on the notification
+     * thread. Nothing here is reachable from a render or record callback.
+     */
+    @synchronized(self) {
+        _dbgRouteChangeNotifyCount++;
+        _dbgLastRouteReason = (NSInteger)reason;
+        _dbgLastRouteReasonAt = [[NSDate date] timeIntervalSince1970];
+        if ((NSUInteger)reason < (NSUInteger)kAttoRouteChangeReasonCount) {
+            _dbgRouteReasonCounts[(NSUInteger)reason]++;
+        }
+    }
+
+    switch (reason) {
+        case AVAudioSessionRouteChangeReasonUnknown:
+        case AVAudioSessionRouteChangeReasonNewDeviceAvailable:
+        case AVAudioSessionRouteChangeReasonOldDeviceUnavailable:
+            // Each device change might cause the actual sample rate or channel configuration of the session to change.
+        case AVAudioSessionRouteChangeReasonCategoryChange:
+            // In iOS 9.2+ switching routes from a BT device in control center may cause a category change.
+        case AVAudioSessionRouteChangeReasonOverride:
+        case AVAudioSessionRouteChangeReasonWakeFromSleep:
+        case AVAudioSessionRouteChangeReasonNoSuitableRouteForCategory:
+        case AVAudioSessionRouteChangeReasonRouteConfigurationChange:
+            // With CallKit, AVAudioSession may change the sample rate during a configuration change.
+            // If a valid route change occurs we may want to update our audio graph to reflect the new output device.
+            @synchronized(self) {
+                // If the worker block is executed, then context is guaranteed to be valid.
+                TVOAudioDeviceContext context = [self deviceContext];
+                if (context) {
+                    TVOAudioDeviceExecuteWorkerBlock(context, ^{
+                        [self handleValidRouteChange];
+                    });
+                }
+            }
+            break;
+    }
+}
+
+- (void)handleValidRouteChange {
+    // Nothing to process while we are interrupted. We will interrogate the AVAudioSession once the interruption ends.
+    if (self.isInterrupted) {
+        return;
+    } else if (_audioUnit == NULL) {
+        /*
+         * ATTO (Aug 3 2026) — DO NOT DROP THIS ON THE FLOOR.
+         *
+         * The AudioUnit is NULL for the whole teardown-and-rebuild window, which is
+         * exactly the window in which a Bluetooth profile handoff or a CallKit
+         * activation fires route changes. Returning here discarded that change
+         * permanently: the engines stayed built at the old rate and nothing existed
+         * that would ever correct them, and routeRebuildCount (which only counts the
+         * successful path) could not even show it had happened.
+         *
+         * Remember the debt instead. The next start hook, or the next successful
+         * AudioOutputUnitStart, consumes it and takes a fresh look at the format.
+         * Both writes are plain scalars under the device lock, and neither is
+         * reachable from a render or record callback.
+         */
+        @synchronized(self) {
+            _pendingFormatRecheck = YES;
+            _dbgRouteChangeDroppedCount++;
+        }
+        NSLog(@"[AttoAudioEngine] route change while the AudioUnit was NULL; deferring the format recheck");
+        return;
+    }
+
+    NSLog(@"A route change occurred while the AudioUnit was started. Checking the active audio format.");
+
+    // Determine if the format actually changed. We only care about sample rate and number of channels.
+    TVOAudioFormat *activeFormat = [[self class] activeFormat];
+
+    // ATTO (Aug 3 2026): snapshot the two cached formats under the device lock
+    // before comparing them. Same reason as everywhere else in this file now: they
+    // are ARC strong ivars written from other threads, so reading them raw races a
+    // release. The comparison itself is unchanged.
+    TVOAudioFormat *cachedRendering = nil;
+    TVOAudioFormat *cachedCapturing = nil;
+    @synchronized(self) {
+        cachedRendering = _renderingFormat;
+        cachedCapturing = _capturingFormat;
+    }
+
+    // Notify Voice SDK about the format change
+    if (![activeFormat isEqual:cachedRendering] ||
+        ![activeFormat isEqual:cachedCapturing]) {
+
+        _restartAudioUnit = YES;
+
+        NSLog(@"Format changed, restarting with %@", activeFormat);
+
+        @synchronized(self) {
+            /*
+             * ATTO (Aug 3 2026): these two nils used to sit OUTSIDE this block, two
+             * lines above it. They are releases of ARC strong ivars, performed on the
+             * media engine's worker thread, and every other reader of those ivars
+             * (-engineTargetFormat, -realignFormatsIfSessionRateFlipped, -renderFormat,
+             * -captureFormat) retains them from a different thread. An unlocked
+             * release racing a retain is a use-after-free, which is the shape of both
+             * crashes this file has already shipped. Moving them inside the lock the
+             * next line already takes costs nothing and closes the writer side for
+             * every reader in the file.
+             */
+            _renderingFormat = nil;
+            _capturingFormat = nil;
+
+            TVOAudioDeviceContext context = [self deviceContext];
+            if (context) {
+                TVOAudioDeviceFormatChanged(context);
+
+                TVOAudioDeviceExecuteWorkerBlock(context, ^{
+                    // Restart the AVAudioEngine with new format
+                    TVOAudioFormat *activeFormat = [[self class] activeFormat];
+
+                    /*
+                     * ATTO (Aug 3 2026) — COMPARE AGAINST WHAT THE ENGINES WERE
+                     * ACTUALLY BUILT WITH.
+                     *
+                     * _renderingFormat is nilled a few lines above and then
+                     * TVOAudioDeviceFormatChanged makes the media engine re-query
+                     * renderFormat, which re-latches _renderingFormat to the NEW
+                     * format (see -renderFormat). This worker block runs afterwards,
+                     * so by the time it executes activeFormat can already equal
+                     * _renderingFormat and the rebuild below is skipped while the
+                     * engines are still frozen at the old rate.
+                     *
+                     * The right question is not "does the session differ from the
+                     * format Twilio just re-queried", it is "does the format the
+                     * engines WOULD be built with differ from the one they ARE built
+                     * with". That is exactly the comparison
+                     * ensureEngineFormatForActiveSession makes, and reusing it also
+                     * keeps this from churning: comparing raw activeFormat against
+                     * _enginesBuiltFormat would rebuild on every route change
+                     * whenever the hardware rate legitimately differs from the
+                     * negotiated one, and rebuild to the same format each time.
+                     *
+                     * Gated: with the cohort flag off this behaves exactly as it has
+                     * shipped. The disagreement counter is NOT gated, so we can
+                     * measure how often the old comparand was wrong before widening.
+                     */
+                    TVOAudioFormat *engineTarget = [self engineTargetFormat];
+                    TVOAudioFormat *reLatched = nil;
+                    @synchronized(self) {
+                        reLatched = self->_renderingFormat;
+                    }
+                    const BOOL oldWantsRebuild = ![activeFormat isEqual:reLatched];
+                    const BOOL newWantsRebuild =
+                        (self->_enginesBuiltFormat == nil) || ![engineTarget isEqual:self->_enginesBuiltFormat];
+                    if (oldWantsRebuild != newWantsRebuild) {
+                        self->_dbgRouteRebuildDisagreeCount++;
+                    }
+
+                    const BOOL shouldRebuild =
+                        [self renderFormatRecheckEnabled] ? newWantsRebuild : oldWantsRebuild;
+                    if (shouldRebuild) {
+                        self->_dbgRouteRebuildCount++; // telemetry: a route change rebuilt mid-call
+                        [self teardownAudioEngine];
+                        [self setupAudioEngine];
+                    }
+                });
+            }
+        }
+    }
+}
+
+- (void)handleMediaServiceLost:(NSNotification *)notification {
+    [self teardownAudioEngine];
+
+    @synchronized(self) {
+        // If the worker block is executed, then context is guaranteed to be valid.
+        TVOAudioDeviceContext context = [self deviceContext];
+        if (context) {
+            TVOAudioDeviceExecuteWorkerBlock(context, ^{
+                [self teardownAudioUnit];
+            });
+        }
+    }
+}
+
+- (void)handleMediaServiceRestored:(NSNotification *)notification {
+    [self setupAudioEngine];
+
+    @synchronized(self) {
+        // If the worker block is executed, then context is guaranteed to be valid.
+        TVOAudioDeviceContext context = [self deviceContext];
+        if (context) {
+            TVOAudioDeviceExecuteWorkerBlock(context, ^{
+                [self startAudioUnit];
+            });
+        }
+    }
+}
+
+- (void)unregisterAVAudioSessionObservers {
+    [[NSNotificationCenter defaultCenter] removeObserver:self];
+}
+
+@end
