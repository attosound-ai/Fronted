+++ b/Libraries/Text/TextInput/RCTBackedTextInputDelegateAdapter.mm
@@ -88,6 +88,16 @@ - (BOOL)textField:(__unused UITextField *)textField
     return YES;
   }
 
+  // ATTO patch: the keyboard can hand us a range computed against text the
+  // field no longer contains (dictation, autocorrect candidates, rapid delete
+  // after a programmatic reset). Clamp instead of throwing NSRangeException.
+  NSUInteger fieldLength = _backedTextInputView.attributedText.string.length;
+  if (range.location > fieldLength) {
+    range = NSMakeRange(fieldLength, 0);
+  } else if (range.location + range.length > fieldLength) {
+    range.length = fieldLength - range.location;
+  }
+
   NSMutableAttributedString *attributedString = [_backedTextInputView.attributedText mutableCopy];
   [attributedString replaceCharactersInRange:range withString:newText];
   [_backedTextInputView setAttributedText:[attributedString copy]];
@@ -272,9 +282,24 @@ - (BOOL)textView:(__unused UITextView *)textView shouldChangeTextInRange:(NSRang
     return NO;
   }
 
-  if (range.location + range.length > _backedTextInputView.text.length) {
-    range = NSMakeRange(range.location, _backedTextInputView.text.length - range.location);
-  } else if ([newText isEqualToString:text]) {
+  // ATTO patch: the keyboard can hand us a range computed against text the
+  // view no longer contains (dictation into a multiline input, autocorrect
+  // candidates, rapid delete after a programmatic reset). The upstream clamp
+  // only covered `location + length > text.length`; when `location` itself is
+  // past the end the NSUInteger subtraction underflowed and
+  // `replaceCharactersInRange:` threw NSRangeException (fatal). Clamp fully
+  // and apply the edit at the end of the text so the keyboard resyncs.
+  NSUInteger viewLength = _backedTextInputView.attributedText.string.length;
+  BOOL rangeWasOutOfBounds = NO;
+  if (range.location > viewLength) {
+    range = NSMakeRange(viewLength, 0);
+    rangeWasOutOfBounds = YES;
+  } else if (range.location + range.length > viewLength) {
+    range.length = viewLength - range.location;
+    rangeWasOutOfBounds = YES;
+  }
+
+  if (!rangeWasOutOfBounds && [newText isEqualToString:text]) {
     _textDidChangeIsComing = YES;
     return YES;
   }
