@@ -235,6 +235,33 @@ - (void)updateCall:(NSString *)uuid callerHandle:(NSString *)handle {
 
 #pragma mark - CXProviderDelegate
 
+// ── ATTO telemetry (patch-package) ───────────────────────────────────────
+// Ground-truth on the CallKit audio-session handoff. The ONLY thing that
+// starts RTP is `twilioAudioDevice.enabled = YES` inside
+// provider:didActivateAudioSession:. On an answer-from-suspended call we
+// suspect that handoff is missed/mistimed; these markers (read back in JS via
+// NativeModules.RNDeviceInfo.getCallAudioState and shipped on call_telemetry_tick)
+// prove whether each callback fired, the audio-device enabled flag, and the
+// live AVAudioSession at that instant. Pure instrumentation — NO behavior change.
+- (void)attoMarkAudio:(NSString *)event {
+    NSUserDefaults *ud = [NSUserDefaults standardUserDefaults];
+    [ud setDouble:[[NSDate date] timeIntervalSince1970]
+           forKey:[NSString stringWithFormat:@"atto_audio_%@_at", event]];
+    BOOL enabled = [TwilioVoiceReactNative twilioAudioDevice].enabled;
+    [ud setBool:enabled forKey:@"atto_audio_enabled"];
+    AVAudioSession *s = [AVAudioSession sharedInstance];
+    NSString *out = s.currentRoute.outputs.firstObject.portType ?: @"none";
+    NSString *inp = s.currentRoute.inputs.firstObject.portType ?: @"none";
+    [ud setObject:(s.category ?: @"") forKey:@"atto_audio_category"];
+    [ud setObject:(s.mode ?: @"") forKey:@"atto_audio_mode"];
+    [ud setObject:out forKey:@"atto_audio_outputPort"];
+    [ud setObject:inp forKey:@"atto_audio_inputPort"];
+    [ud setDouble:s.sampleRate forKey:@"atto_audio_sampleRate"];
+    [ud setBool:s.isOtherAudioPlaying forKey:@"atto_audio_otherPlaying"];
+    NSLog(@"[AttoAudio] %@ enabled=%d cat=%@ out=%@ in=%@ sr=%.0f other=%d",
+          event, enabled, s.category, out, inp, s.sampleRate, s.isOtherAudioPlaying);
+}
