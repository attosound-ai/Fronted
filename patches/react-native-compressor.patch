+// ATTO: React Native 0.8x removed GuardedResultAsyncTask and this file stopped
+// compiling, which broke every Android build of the app. Same contract, done
+// with a plain thread: the work off the main thread, the result back on it.
+abstract class AttoResultTask<Result> {
+    protected abstract fun doInBackgroundGuarded(): Result
+    protected abstract fun onPostExecuteGuarded(result: Result)
+    fun execute() {
+        Thread {
+            val result = doInBackgroundGuarded()
+            android.os.Handler(android.os.Looper.getMainLooper()).post { onPostExecuteGuarded(result) }
+        }.start()
+    }
+}
