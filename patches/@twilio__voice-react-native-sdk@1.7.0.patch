diff --git a/ios/TwilioVoiceReactNative.m b/ios/TwilioVoiceReactNative.m
index 9832b501acdabd9720631b6af5969760802dbb55..b7cc94145d6f732d5302f8df32a990912be2406b 100644
--- a/ios/TwilioVoiceReactNative.m
+++ b/ios/TwilioVoiceReactNative.m
@@ -25,6 +25,9 @@
 NSString * const kTwilioVoiceAudioDeviceUid = @"uid";
 
 static TVODefaultAudioDevice *sTwilioAudioDevice;
+// ATTO audio-injection: the stock default device, saved when we swap in the
+// custom AVAudioEngine device so we can restore it byte-for-byte afterwards.
+static id sAttoSavedAudioDevice = nil;
 
 @import TwilioVoice;
 
@@ -142,6 +145,38 @@ + (TVODefaultAudioDevice *)twilioAudioDevice {
     return sTwilioAudioDevice;
 }
 
+// ── ATTO audio-injection device swap ───────────────────────────────────────
+// Swaps in a custom <TVOAudioDevice> (the AVAudioEngine injection device) AS
+// the process-wide audio device, so the CallKit lifecycle (which drives audio
+// via [TwilioVoiceReactNative twilioAudioDevice].enabled/.block) transparently
+// targets it. MUST be called by JS only with NO active call (Twilio forbids
+// swapping the audio device mid-call). Default-OFF: if this is never called the
+// stock TVODefaultAudioDevice is untouched, so base calls are byte-identical.
++ (BOOL)attoSetAudioDevice:(id)audioDevice {
+    if (!audioDevice) return NO;
+    @try {
+        if (!sAttoSavedAudioDevice) {
+            sAttoSavedAudioDevice = sTwilioAudioDevice;
+        }
+        // The getter is typed TVODefaultAudioDevice*; the custom device responds
+        // to the same selectors the SDK uses (.enabled, .block, the TVOAudioDevice
+        // protocol), so it is a functional drop-in.
+        sTwilioAudioDevice = (TVODefaultAudioDevice *)audioDevice;
+        TwilioVoiceSDK.audioDevice = audioDevice;
+        return YES;
+    } @catch (NSException *exception) {
+        return NO;
+    }
+}
+
+// Restore the stock default device (called by JS after a call ends). Idempotent.
++ (void)attoRestoreDefaultDevice {
+    if (sAttoSavedAudioDevice) {
+        sTwilioAudioDevice = (TVODefaultAudioDevice *)sAttoSavedAudioDevice;
+        TwilioVoiceSDK.audioDevice = sAttoSavedAudioDevice;
+    }
+}
