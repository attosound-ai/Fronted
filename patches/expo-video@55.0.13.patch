+  // ATTO patch (Oct 9 2026). This function always writes category .playback with
+  // mode .moviePlayback; `mixWithOthers` only adds an option, it never keeps the
+  // category. During a phone call that write takes the microphone away from the
+  // call (Playback has no input) and the voice engine does not recover: on Oct 10
+  // 2026 a call answered from the lock screen connected with 0 packets sent for
+  // 36 s because the feed's players were created at that moment. While a call is
+  // live the session belongs to the call, so the players mix into it as is.
+  //
+  // Only CallKit's own list decides (review, Oct 10 2026): an earlier version also
+  // treated "PlayAndRecord + VoiceChat" as a call, and since the session stays that
+  // way for a moment after a call ends, the players never wrote Playback again
+  // (feed audio on the earpiece, silent switch ignored). A write skipped during a
+  // call is replayed when CallKit reports that the last call ended.
+  private static let callObserver = CXCallObserver()
+  private static let callReleaseWatcher = AttoVideoCallReleaseWatcher()
+  private static let startWatchingCalls: Void = {
+    callObserver.setDelegate(callReleaseWatcher, queue: DispatchQueue.main)
+  }()
+  private static let callReleasedNotification = Notification.Name("AttoCallSessionReleased")
+  private var attoPendingSessionWrite = false // managerQueue only
+  private var attoReleaseObserver: NSObjectProtocol?
+
+  private static func isPhoneCallLive() -> Bool {
+    _ = startWatchingCalls
+    return callObserver.calls.contains(where: { !$0.hasEnded })
+  }
+
+  init() {
+    attoReleaseObserver = NotificationCenter.default.addObserver(
+      forName: Self.callReleasedNotification, object: nil, queue: nil
+    ) { [weak self] _ in
+      Self.managerQueue.async {
+        guard let self, self.attoPendingSessionWrite else { return }
+        self.attoPendingSessionWrite = false
+        self.setAudioSession()
+      }
+    }
+  }
+
