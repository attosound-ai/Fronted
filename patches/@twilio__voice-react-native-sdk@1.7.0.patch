+//
+//  AttoAudioEngineDevice.h
+//  TwilioVoiceReactNative (ATTO SOUND)
+//
+//  Faithful port of Twilio's ExampleAVAudioEngineDevice (Copyright © 2018-2020
+//  Twilio Inc.) generalized to inject an ARBITRARY local audio file into the
+//  outbound capture path (remote hears it) plus an optional local monitor (the
+//  caller hears it). Real-time render/capture callbacks and the manual-rendering
+//  engine setup are preserved verbatim from the canonical source.
+//
+
+@import TwilioVoice;
+
+NS_CLASS_AVAILABLE(NA, 11_0)
+@interface AttoAudioEngineDevice : NSObject <TVOAudioDevice>
+
+@property (nonatomic, assign, getter=isEnabled) BOOL enabled;
+
+/*
+ * AVAudioSession configuration block. This custom device manages its OWN session
+ * (see setupAVAudioSession), so this is effectively a no-op — but it MUST exist
+ * and be non-nil because the RN SDK's CallKit hooks call `device.block()`
+ * unconditionally (a nil block would crash). Mirrors TVODefaultAudioDevice.block
+ * so this device is a drop-in replacement for the SDK's default device.
+ */
+@property (nonatomic, copy) TVOAVAudioSessionConfigurationBlock block;
+
+/*
+ * Process-wide singleton. The RN bridge installs THIS instance as the active
+ * Twilio audio device AND uses it as the injection target, guaranteeing exactly
+ * one engine instance.
+ */
++ (instancetype)sharedDevice;
+
+/*
+ * Status hook. Invoked (always on the main queue):
+ *   (a) periodically with the current playback position while a scheduled file
+ *       is playing, and
+ *   (b) once with `ended == YES` when the scheduled buffer finishes.
+ * `positionMs` / `durationMs` are in milliseconds. May be 0 when unknown.
+ */
+@property (nonatomic, copy) void (^onStatus)(double positionMs, double durationMs, BOOL ended);
+
+/*
+ * Schedule an ARBITRARY local file (NOT a bundled resource) for injection.
+ *   - Always schedules on the RECORD file player (remote hears it).
+ *   - Schedules on the PLAYOUT file player only when `monitor == YES` (the
+ *     local caller hears it).
+ *   - `gain` (0..1) is applied to the file player mixer nodes.
+ * The source file format is converted to the engine's processing format when
+ * they differ (no pitch/speed artifacts). Returns NO on any failure (bad path,
+ * decode error, engine not running) — never crashes.
+ */
+- (BOOL)scheduleFile:(NSString *)localPath monitor:(BOOL)monitor gain:(float)gain;
+
+/* Stop + reset the file player nodes. Safe to call when nothing is scheduled. */
+- (void)stopFile;
+
+/* Live gain control, 0..1. */
+- (void)setGain:(float)gain;
+
+/* Live local-monitor (playout) toggle. */
+- (void)setMonitor:(BOOL)on;
+
+@end
