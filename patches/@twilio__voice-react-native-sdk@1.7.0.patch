+//
+//  AttoAudioInjection.m
+//  TwilioVoiceReactNative (ATTO SOUND)
+//
+//  RN bridge over AttoAudioEngineDevice. See AttoAudioInjection.h.
+//
+
+#import "AttoAudioInjection.h"
+#import "AttoAudioEngineDevice.h"
+#import "TwilioVoiceReactNative.h"
+#import <AVFoundation/AVFoundation.h>
+
+/*
+ * These class methods are added to TwilioVoiceReactNative by the human reviewer
+ * (they swap the SDK's active audio device to/from our custom engine). We
+ * declare them here as a category so this file compiles independently of when
+ * that edit lands. `attoSetAudioDevice:` takes the shared AttoAudioEngineDevice
+ * (a <TVOAudioDevice>) as an `id` to avoid a hard type dependency.
+ */
+@interface TwilioVoiceReactNative (AttoAudioInjection)
++ (BOOL)attoSetAudioDevice:(id)audioDevice;
++ (void)attoRestoreDefaultDevice;
+@end
+
+@implementation AttoAudioInjection {
+    // RCTEventEmitter exposes no public hasListeners; track it ourselves via
+    // startObserving/stopObserving so we never emit into a bridge with no JS
+    // observers attached.
+    BOOL _hasListeners;
+}
+
+RCT_EXPORT_MODULE(AttoAudioInjection);
+
++ (BOOL)requiresMainQueueSetup {
+    return NO;
+}
+
+- (NSArray<NSString *> *)supportedEvents {
+    return @[@"AttoAudioInjectionEvent"];
+}
+
+- (void)startObserving {
+    _hasListeners = YES;
+}
+
+- (void)stopObserving {
+    _hasListeners = NO;
+}
+
+#pragma mark - Status wiring
+
+/*
+ * Wire the shared device's onStatus hook to the RN event emitter. Guarded by
+ * hasListeners so we never emit into a torn-down bridge. The device already
+ * dispatches the callback to the main queue.
+ */
+- (void)wireStatusHook {
+    __weak typeof(self) weakSelf = self;
+    [AttoAudioEngineDevice sharedDevice].onStatus = ^(double positionMs, double durationMs, BOOL ended) {
+        __strong typeof(weakSelf) strongSelf = weakSelf;
+        if (strongSelf == nil) {
+            return;
+        }
+        if (!strongSelf->_hasListeners) {
+            return;
+        }
+        [strongSelf sendEventWithName:@"AttoAudioInjectionEvent"
+                                 body:@{
+            @"positionMs": @(positionMs),
+            @"durationMs": @(durationMs),
+            @"ended": @(ended),
+        }];
+    };
+}
+
+#pragma mark - Device installation
+
+RCT_EXPORT_METHOD(installInjectionDevice:(RCTPromiseResolveBlock)resolve
+                  rejecter:(RCTPromiseRejectBlock)reject) {
+    @try {
+        // The JS caller guarantees there is no active call at install time.
+        BOOL ok = [TwilioVoiceReactNative attoSetAudioDevice:[AttoAudioEngineDevice sharedDevice]];
+        [self wireStatusHook];
+        resolve(@(ok));
+    } @catch (NSException *exception) {
+        reject(@"install_failed", exception.reason ?: @"Failed to install injection device", nil);
+    }
+}
+
+RCT_EXPORT_METHOD(restoreDefaultDevice:(RCTPromiseResolveBlock)resolve
+                  rejecter:(RCTPromiseRejectBlock)reject) {
+    @try {
+        [AttoAudioEngineDevice sharedDevice].onStatus = nil;
+        [TwilioVoiceReactNative attoRestoreDefaultDevice];
+        resolve(@(YES));
+    } @catch (NSException *exception) {
+        reject(@"restore_failed", exception.reason ?: @"Failed to restore default device", nil);
+    }
+}
+
+#pragma mark - Playback control
+
+RCT_EXPORT_METHOD(playInjectedAudio:(NSString *)localPath
+                  monitor:(BOOL)monitor
+                  gain:(double)gain
+                  resolver:(RCTPromiseResolveBlock)resolve
+                  rejecter:(RCTPromiseRejectBlock)reject) {
+    @try {
+        // Make sure the status hook is wired even if play is called before install
+        // (defensive — install is the normal path).
+        [self wireStatusHook];
+        BOOL result = [[AttoAudioEngineDevice sharedDevice] scheduleFile:localPath
+                                                                 monitor:monitor
+                                                                    gain:(float)gain];
+        resolve(@(result));
+    } @catch (NSException *exception) {
+        reject(@"play_failed", exception.reason ?: @"Failed to play injected audio", nil);
+    }
+}
+
+RCT_EXPORT_METHOD(stopInjectedAudio:(RCTPromiseResolveBlock)resolve
+                  rejecter:(RCTPromiseRejectBlock)reject) {
+    @try {
+        [[AttoAudioEngineDevice sharedDevice] stopFile];
+        resolve(@(YES));
+    } @catch (NSException *exception) {
+        reject(@"stop_failed", exception.reason ?: @"Failed to stop injected audio", nil);
+    }
+}
+
+RCT_EXPORT_METHOD(setInjectedGain:(double)gain) {
+    @try {
+        [[AttoAudioEngineDevice sharedDevice] setGain:(float)gain];
+    } @catch (NSException *e) {
+        NSLog(@"[AttoAudioInjection] setInjectedGain failed: %@ (%@)", e.name, e.reason);
+    }
+}
+
+RCT_EXPORT_METHOD(setInjectedMonitor:(BOOL)on) {
+    @try {
+        [[AttoAudioEngineDevice sharedDevice] setMonitor:on];
+    } @catch (NSException *e) {
+        NSLog(@"[AttoAudioInjection] setInjectedMonitor failed: %@ (%@)", e.name, e.reason);
+    }
+}
+
+#pragma mark - 4-channel record mixer (matches mixerService.ts)
+
+/*
+ * Set a record-mixer channel's gain (0..1) + record-enable. `channel` is one of
+ * "mic" / "remote" / "app" / "metronome". Affects ONLY the client-side recorded
+ * mix — the live call is untouched. Fire-and-forget (mirrors the JS void return).
+ *
+ * These are VOID exported methods — a native NSException here is NOT catchable by
+ * the JS try/catch in mixerService.ts (that only sees JS errors / promise
+ * rejections); it propagates through the bridge and crashes the app. That was the
+ * mixer-metronome crash (Sentry REACT-NATIVE-4C): the toggle reached the unguarded
+ * setMetronome, which inited sharedDevice and threw. Guard every void entry point.
+ */
+RCT_EXPORT_METHOD(setMixerChannel:(NSString *)channel
+                  gain:(double)gain
+                  record:(BOOL)record) {
+    @try {
+        [[AttoAudioEngineDevice sharedDevice] setMixerChannel:channel
+                                                         gain:(float)gain
+                                                       record:record];
+    } @catch (NSException *e) {
+        NSLog(@"[AttoAudioInjection] setMixerChannel failed: %@ (%@)", e.name, e.reason);
+    }
+}
+
+/* Enable/disable the synthesized metronome click and set its tempo (BPM). */
+RCT_EXPORT_METHOD(setMetronome:(BOOL)enabled
+                  bpm:(double)bpm) {
+    @try {
+        [[AttoAudioEngineDevice sharedDevice] setMetronome:enabled
+                                                       bpm:(NSInteger)llround(bpm)];
+    } @catch (NSException *e) {
+        NSLog(@"[AttoAudioInjection] setMetronome failed: %@ (%@)", e.name, e.reason);
+    }
+}
+
+/*
+ * Start the client-side multitrack record. Resolves the local file path (or null
+ * on failure). Never rejects for the "already recording" case — it resolves the
+ * existing path so the JS caller stays simple.
+ */
+RCT_EXPORT_METHOD(startMixRecording:(RCTPromiseResolveBlock)resolve
+                  rejecter:(RCTPromiseRejectBlock)reject) {
+    @try {
+        NSString *path = [[AttoAudioEngineDevice sharedDevice] startMixRecording];
+        resolve(path ?: [NSNull null]);
+    } @catch (NSException *exception) {
+        reject(@"start_mix_failed", exception.reason ?: @"Failed to start mix recording", nil);
+    }
+}
+
+/* Stop the record; resolves the finished file path (or null if not recording). */
+RCT_EXPORT_METHOD(stopMixRecording:(RCTPromiseResolveBlock)resolve
+                  rejecter:(RCTPromiseRejectBlock)reject) {
+    @try {
+        NSString *path = [[AttoAudioEngineDevice sharedDevice] stopMixRecording];
+        resolve(path ?: [NSNull null]);
+    } @catch (NSException *exception) {
+        reject(@"stop_mix_failed", exception.reason ?: @"Failed to stop mix recording", nil);
+    }
+}
+
+/* Telemetry: per-channel frame totals of the last mix (mic/remote/app/total). */
+RCT_EXPORT_METHOD(getMixDiagnostics:(RCTPromiseResolveBlock)resolve
+                  rejecter:(RCTPromiseRejectBlock)reject) {
+    @try {
+        resolve([[AttoAudioEngineDevice sharedDevice] mixDiagnostics]);
+    } @catch (NSException *exception) {
+        reject(@"mix_diagnostics_failed", exception.reason ?: @"Failed to read mix diagnostics", nil);
+    }
+}
+
+/*
+ * Extract the audio track of a VIDEO file (reel / video post / video message) to a
+ * temp .m4a so it can be injected into a call — the engine's player reads audio
+ * files (AVAudioFile), not video containers. Lets the "transmit" button push ANY
+ * app audio, including video, into the call. Resolves the local audio path.
+ */
+RCT_EXPORT_METHOD(extractAudioTrack:(NSString *)videoPath
+                  resolver:(RCTPromiseResolveBlock)resolve
+                  rejecter:(RCTPromiseRejectBlock)reject) {
+    @try {
+        NSURL *srcURL = [videoPath hasPrefix:@"file://"]
+            ? [NSURL URLWithString:videoPath]
+            : [NSURL fileURLWithPath:videoPath];
+        AVURLAsset *asset = [AVURLAsset URLAssetWithURL:srcURL options:nil];
+        if ([[asset tracksWithMediaType:AVMediaTypeAudio] count] == 0) {
+            reject(@"extract_no_audio", @"video has no audio track", nil);
+            return;
+        }
+
+        NSString *outName = [NSString stringWithFormat:@"inject-audio-%lu.m4a",
+                             (unsigned long)[videoPath hash]];
+        NSString *outPath = [NSTemporaryDirectory() stringByAppendingPathComponent:outName];
+        NSURL *outURL = [NSURL fileURLWithPath:outPath];
+        [[NSFileManager defaultManager] removeItemAtURL:outURL error:nil];
+
+        AVAssetExportSession *export =
+            [[AVAssetExportSession alloc] initWithAsset:asset
+                                             presetName:AVAssetExportPresetAppleM4A];
+        if (export == nil) {
+            reject(@"extract_failed", @"could not create export session", nil);
+            return;
+        }
+        export.outputURL = outURL;
+        export.outputFileType = AVFileTypeAppleM4A;
+        [export exportAsynchronouslyWithCompletionHandler:^{
+            if (export.status == AVAssetExportSessionStatusCompleted) {
+                resolve(outPath);
+            } else {
+                reject(@"extract_failed",
+                       export.error.localizedDescription ?: @"audio export failed", nil);
+            }
+        }];
+    } @catch (NSException *exception) {
+        reject(@"extract_failed", exception.reason ?: @"extractAudioTrack threw", nil);
+    }
+}
+
+@end
