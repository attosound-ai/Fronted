+//
+//  AttoAudioInjection.h
+//  TwilioVoiceReactNative (ATTO SOUND)
+//
+//  React Native bridge that installs the shared AttoAudioEngineDevice as the
+//  active Twilio audio device and drives file injection (record bus = remote
+//  hears it, optional playout monitor = local caller hears it). Emits playback
+//  position/ended status via the `AttoAudioInjectionEvent` event.
+//
+
+#import <React/RCTBridgeModule.h>
+#import <React/RCTEventEmitter.h>
+
+@interface AttoAudioInjection : RCTEventEmitter <RCTBridgeModule>
+
+@end
