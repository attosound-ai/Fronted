+
+// ATTO patch (Oct 10 2026): posts AttoCallSessionReleased when CallKit reports that
+// no call is left, so a session write skipped during the call is replayed.
+private final class AttoVideoCallReleaseWatcher: NSObject, CXCallObserverDelegate {
+  func callObserver(_ callObserver: CXCallObserver, callChanged call: CXCall) {
+    if !callObserver.calls.contains(where: { !$0.hasEnded }) {
+      NotificationCenter.default.post(name: Notification.Name("AttoCallSessionReleased"), object: nil)
+    }
+  }
