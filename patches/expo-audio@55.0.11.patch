--- /dev/null
+++ b/ios/AttoCallSession.swift
@@ -0,0 +1,56 @@
+import AVFoundation
+import CallKit
+
+/// ATTO patch (Oct 10 2026). One rule for every library that writes the shared
+/// audio session: while CallKit holds a call that has not ended, the session
+/// belongs to the call. The library skips its write and says so with the
+/// `AttoAudioSessionWriteDenied` notification, which the app counts. The same
+/// rule and notification live in expo-audio, expo-video and atto-recorder; see
+/// front/docs/arquitectura/audio-y-reanudacion.md.
+///
+/// A skipped write is not lost: when the last live call ends, CallKit tells us
+/// and `releasedNotification` is posted on the main queue, so the library replays
+/// the write it skipped. Without that, a hang up by the far party (JS restores
+/// Playback a moment before CallKit marks the call ended) left the session in
+/// the call's PlayAndRecord / VoiceChat after the call (review, Oct 10 2026).
+///
+/// Why: on Oct 10 2026 a library write (category Playback) in the middle of a
+/// call took its microphone away and the call ran 36 s in silence. Library
+/// internal state (modes, recorder flags) keeps updating; only the
+/// AVAudioSession write waits.
+enum AttoCallSession {
+  static let releasedNotification = Notification.Name("AttoCallSessionReleased")
+
+  private static let observer = CXCallObserver()
+  private static let watcher = AttoCallReleaseWatcher()
+  private static let startWatching: Void = {
+    observer.setDelegate(watcher, queue: DispatchQueue.main)
+  }()
+
+  /// True while CallKit holds a call that has not ended (no notification).
+  static func isCallLive() -> Bool {
+    _ = startWatching
+    return observer.calls.contains { !$0.hasEnded }
+  }
+
+  /// True when a call owns the session; posts the denial for `client` then.
+  static func ownsSession(denying client: String) -> Bool {
+    _ = startWatching
+    let live = observer.calls.contains { !$0.hasEnded }
+    if live {
+      NotificationCenter.default.post(
+        name: Notification.Name("AttoAudioSessionWriteDenied"),
+        object: nil,
+        userInfo: ["client": client])
+    }
+    return live
+  }
+}
+
+private final class AttoCallReleaseWatcher: NSObject, CXCallObserverDelegate {
+  func callObserver(_ callObserver: CXCallObserver, callChanged call: CXCall) {
+    if !callObserver.calls.contains(where: { !$0.hasEnded }) {
+      NotificationCenter.default.post(name: AttoCallSession.releasedNotification, object: nil)
+    }
+  }
+}
