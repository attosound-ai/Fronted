+#pragma mark - ATTO edge fill
+
+// iOS 26 floats every sheet below the large detent: inset from both sides and
+// lifted off the bottom, with whatever is behind showing through the gaps. On a
+// black app over video that reads as a broken sheet. The sheet stays the
+// system's own UISheetPresentationController; this only puts a view of the
+// sheet's colour behind it, full width and down to the bottom edge, that
+// follows the sheet's top edge wherever it goes (present, drag, keyboard,
+// dismiss). Only for opaque sheets on a phone: a glass sheet keeps floating.
+- (void)atto_removeEdgeFill {
+  [_edgeFillView removeFromSuperview];
+  _edgeFillView = nil;
+}
+
+- (void)atto_updateEdgeFillForPosition:(CGFloat)position {
+  if (@available(iOS 26.0, *)) {
+    UIView *presentedView = self.presentedView;
+    UIView *container = self.sheet.containerView;
+    BOOL opaque = self.backgroundColor && CGColorGetAlpha(self.backgroundColor.CGColor) >= 0.99;
+    if (!presentedView || !container || !opaque || self.isDesignCompatibilityMode ||
+        UIDevice.currentDevice.userInterfaceIdiom != UIUserInterfaceIdiomPhone) {
+      [self atto_removeEdgeFill];
+      return;
+    }
+
+    // The direct child of the container that holds the presented view: the
+    // fill goes right under it, so it sits above the dimming view.
+    UIView *anchor = presentedView;
+    while (anchor.superview && anchor.superview != container) {
+      anchor = anchor.superview;
+    }
+    if (anchor.superview != container) {
+      [self atto_removeEdgeFill];
+      return;
+    }
+
+    if (!_edgeFillView) {
+      _edgeFillView = [[UIView alloc] init];
+      _edgeFillView.userInteractionEnabled = NO;
+      _edgeFillView.layer.cornerCurve = kCACornerCurveContinuous;
+      _edgeFillView.layer.maskedCorners = kCALayerMinXMinYCorner | kCALayerMaxXMinYCorner;
+    }
+    // Re inserting keeps it directly under the sheet even if UIKit reorders.
+    [container insertSubview:_edgeFillView belowSubview:anchor];
+
+    CGFloat height = container.bounds.size.height;
+    CGFloat y = fmin(fmax(position, 0), height);
+    // The sheet is inset from the sides, so a concentric outer corner is the
+    // sheet's radius plus that inset.
+    CGFloat inset = fmax(presentedView.frame.origin.x, 0);
+    CGFloat radius = (self.cornerRadius ? self.cornerRadius.doubleValue : presentedView.layer.cornerRadius) + inset;
+
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    _edgeFillView.backgroundColor = self.backgroundColor;
+    _edgeFillView.layer.cornerRadius = radius;
+    _edgeFillView.frame = CGRectMake(0, y, container.bounds.size.width, height - y + 1);
+    _edgeFillView.hidden = (height - y) < 1;
+    [CATransaction commit];
+  }
+}
